<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.EventSheetView"
             x:DataType="sh:EventSheetViewModel">
  <!-- A disaster event: name, kind, FEMA number, dates, datum offset and notes; Delete at the foot's left for an existing one -->
  <StackPanel Spacing="16">
    <Grid ColumnDefinitions="2*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="4">
      <TextBlock Classes="fieldLabel" Text="Name" />
      <TextBlock Grid.Column="1" Classes="fieldLabel" Text="Kind" />
      <TextBox Grid.Row="1" Text="{Binding Name}" PlaceholderText="For example: September flood" AutomationProperties.Name="Event name" />
      <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" HorizontalAlignment="Stretch"
                AutomationProperties.Name="Kind of event" />
    </Grid>
    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="4">
      <TextBlock Classes="fieldLabel" Text="FEMA disaster number" />
      <TextBlock Grid.Column="1" Classes="fieldLabel" Text="Started" ToolTip.Tip="New assessments damaged in this range are offered this event." />
      <TextBlock Grid.Column="2" Classes="fieldLabel" Text="Ended" ToolTip.Tip="New assessments damaged in this range are offered this event." />
      <TextBox Grid.Row="1" Text="{Binding DRNumber}" PlaceholderText="DR-0000" AutomationProperties.Name="FEMA disaster number" />
      <c:DateField Grid.Row="1" Grid.Column="1" SelectedDate="{Binding StartDate}" HorizontalAlignment="Stretch" AutomationProperties.Name="Date the event started"
                          ToolTip.Tip="New assessments damaged in this range are offered this event." />
      <c:DateField Grid.Row="1" Grid.Column="2" SelectedDate="{Binding EndDate}" HorizontalAlignment="Stretch" PlaceholderText="Still going" AutomationProperties.Name="Date the event ended" />
    </Grid>
    <Grid ColumnDefinitions="*,2*" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="4">
      <TextBlock Classes="fieldLabel" Text="Datum offset (ft, optional)"
                 ToolTip.Tip="Added to high-water marks in another vertical datum (for example NAVD 88 to NGVD 29)." />
      <TextBlock Grid.Column="1" Classes="fieldLabel" Text="Notes" />
      <TextBox Grid.Row="1" Text="{Binding DatumOffset}" PlaceholderText="0.0" AutomationProperties.Name="Datum offset in feet" VerticalAlignment="Top"
               ToolTip.Tip="Added to high-water marks in another vertical datum (for example NAVD 88 to NGVD 29)." />
      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" AutomationProperties.Name="Notes about the event" />
    </Grid>
    <TextBlock Classes="danger" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
    <c:SheetFooter LeadingText="Delete Event…" LeadingCommand="{Binding DeleteCommand}" IsLeadingDestructive="True" IsLeadingVisible="{Binding IsExisting}"
                   PrimaryText="Save" PrimaryCommand="{Binding SaveCommand}" />
  </StackPanel>
</UserControl>
