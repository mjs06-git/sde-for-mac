<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.PrintMapSheetView"
             x:DataType="sh:PrintMapSheetViewModel">
  <StackPanel Spacing="16">
    <StackPanel Spacing="4">
      <TextBlock Classes="fieldLabel" Text="Title" />
      <TextBox Text="{Binding MapTitle}" AutomationProperties.Name="Title of the printed map" />
    </StackPanel>
    <StackPanel Spacing="4">
      <TextBlock Classes="fieldLabel" Text="Page" />
      <ListBox Classes="segmented" SelectedIndex="{Binding OrientationIndex}" HorizontalAlignment="Left" AutomationProperties.Name="Portrait or landscape">
        <ListBoxItem Content="Portrait" />
        <ListBoxItem Content="Landscape" />
      </ListBox>
    </StackPanel>
    <c:SheetFooter PrimaryText="Save as PDF…" PrimaryCommand="{Binding PrintCommand}"
                   PrimaryToolTip="A Letter PDF of this view with legend, scale, north arrow, sources and date." />
  </StackPanel>
</UserControl>
