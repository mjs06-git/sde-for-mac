<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             x:Class="Sde.App.Views.NewLayerSheetView"
             x:DataType="sh:NewLayerSheetViewModel">
  <StackPanel Spacing="14">
    <StackPanel Spacing="4">
      <TextBlock Classes="fieldLabel" Text="Name" />
      <TextBox Text="{Binding LayerName}" AutomationProperties.Name="Name of the new layer" />
    </StackPanel>
    <StackPanel Spacing="4">
      <TextBlock Classes="fieldLabel" Text="It holds" />
      <ListBox Classes="segmented" SelectedIndex="{Binding KindIndex}" HorizontalAlignment="Left" AutomationProperties.Name="What the layer holds: points, lines or areas">
        <ListBoxItem Content="Points" />
        <ListBoxItem Content="Lines" />
        <ListBoxItem Content="Areas" />
      </ListBox>
    </StackPanel>
    <TextBlock Classes="muted" TextWrapping="Wrap"
               Text="Shapes have a name and notes, kept in a GeoPackage QGIS and ArcGIS open." />
    <Border Classes="subtle" IsVisible="{Binding HasProblem}">
      <TextBlock Classes="issue required" Text="{Binding Problem}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
    </Border>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
      <Button Classes="primary" Content="Make the Layer" Command="{Binding CreateCommand}" IsDefault="True" MinWidth="90" HorizontalContentAlignment="Center" />
    </StackPanel>
  </StackPanel>
</UserControl>
