<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.FieldHelpSheetView"
             x:DataType="sh:FieldHelpSheetViewModel">
  <!-- Done (Return) closes; opening the manual at the field's page is the action at the left -->
  <StackPanel Spacing="16">
    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
    <TextBlock Classes="muted" Text="{Binding Where}" TextWrapping="Wrap" />
    <TextBlock Classes="secondary" Text="{Binding MissingMessage}" TextWrapping="Wrap" IsVisible="{Binding ManualMissing}" />
    <c:SheetFooter IsDone="True" LeadingText="Open the Manual at This Page" LeadingCommand="{Binding OpenAtPageCommand}" IsLeadingVisible="{Binding ManualAvailable}">
      <StackPanel Orientation="Horizontal" Spacing="16">
        <Button Classes="link" Content="Open the Full Manual" Command="{Binding OpenManualCommand}" IsVisible="{Binding ManualAvailable}" />
        <Button Classes="link" Content="Open FEMA's SDE Page" Command="{Binding OpenFemaPageCommand}" IsVisible="{Binding ManualMissing}" />
      </StackPanel>
    </c:SheetFooter>
  </StackPanel>
</UserControl>
