<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             x:Class="Sde.App.Views.PrintCaseFileSheetView"
             x:DataType="sh:PrintCaseFileSheetViewModel">
  <StackPanel Spacing="16">
    <StackPanel Spacing="8">
      <CheckBox Content="Include the timeline" IsChecked="{Binding IncludeTimeline}" Name="IncludeTimelineBox" />
      <CheckBox Content="{Binding EditsLabel}" IsChecked="{Binding IncludeEdits}" IsEnabled="{Binding IncludeTimeline}" Margin="24,0,0,0"
                Name="IncludeEditsBox" AutomationProperties.Name="Include field changes"
                ToolTip.Tip="Every change to a field from the edit history, in the timeline" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
      <Button Classes="primary" Content="Print…" IsDefault="True" Command="{Binding PrintCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
    </StackPanel>
  </StackPanel>
</UserControl>
