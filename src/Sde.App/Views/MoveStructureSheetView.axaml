<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.MoveStructureSheetView"
             x:DataType="sh:MoveStructureSheetViewModel">
  <StackPanel Spacing="16">
    <TextBlock Classes="medium" Text="{Binding Question}" TextWrapping="Wrap" ToolTip.Tip="Saved to the structure and listed in its history." />
    <Border Classes="card">
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="6">
        <TextBlock Classes="secondary" Text="From" />
        <TextBlock Grid.Column="1" Classes="mono" Text="{Binding FromText}" />
        <TextBlock Grid.Row="1" Classes="secondary" Text="To" />
        <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" Text="{Binding ToText}" />
      </Grid>
    </Border>
    <c:SheetFooter CancelAutomationName="Cancel: leave the structure where it was"
                   PrimaryText="Move" PrimaryCommand="{Binding MoveCommand}" PrimaryAutomationName="Move the structure" />
  </StackPanel>
</UserControl>
