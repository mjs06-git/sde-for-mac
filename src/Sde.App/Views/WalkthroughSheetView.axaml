<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             x:Class="Sde.App.Views.WalkthroughSheetView"
             x:DataType="sh:WalkthroughSheetViewModel">
  <!-- The sheet's title is the heading; each page is a sentence or two. The height fits the longest page, so the
       buttons stay put from page to page. -->
  <StackPanel Spacing="20">
    <TextBlock Text="{Binding Current.Body}" TextWrapping="Wrap" MinHeight="36" />
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
      <Button Classes="link" Content="Open the Sample Database" Command="{Binding OpenSampleCommand}" VerticalAlignment="Center" HorizontalAlignment="Left" />
      <TextBlock Grid.Column="1" Classes="secondary num" Text="{Binding PositionText}" VerticalAlignment="Center" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button Content="Back" Command="{Binding BackCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
        <Button Classes="primary" Content="{Binding NextText}" Command="{Binding NextCommand}" IsDefault="True" MinWidth="90" HorizontalContentAlignment="Center" />
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
