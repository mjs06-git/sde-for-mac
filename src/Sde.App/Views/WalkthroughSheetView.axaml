<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             xmlns:v="using:Sde.App.Views"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.WalkthroughSheetView"
             x:DataType="sh:WalkthroughSheetViewModel">
  <!-- The welcome: the brand mark and a large title (the sheet chrome hides its own), then every page as a numbered row,
       the one being read in the soft accent. All rows always show, so Back and Next never move. -->
  <StackPanel Spacing="20">
    <StackPanel Spacing="12" Margin="0,-6,0,0">
      <c:Icon Classes="welcomeMark" Kind="BrandMark" Size="44" />
      <TextBlock Classes="welcomeTitle" Text="{Binding Title}" />
    </StackPanel>
    <ItemsControl ItemsSource="{Binding Pages}" Margin="-12,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="sh:WalkthroughPage">
          <Border Classes="welcomeStep">
            <Classes.current>
              <MultiBinding Converter="{x:Static v:SheetConverters.Same}">
                <Binding />
                <Binding Path="$parent[ItemsControl].((sh:WalkthroughSheetViewModel)DataContext).Current" />
              </MultiBinding>
            </Classes.current>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <Border Classes="welcomeNumber">
                <TextBlock>
                  <TextBlock.Text>
                    <MultiBinding Converter="{x:Static v:SheetConverters.Number}">
                      <Binding />
                      <Binding Path="$parent[ItemsControl].((sh:WalkthroughSheetViewModel)DataContext).Pages" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </Border>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Classes="semibold" Text="{Binding Heading}" />
                <TextBlock Classes="welcomeBody" Text="{Binding Body}" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <c:SheetFooter LeadingText="Open the Sample Database" LeadingCommand="{Binding OpenSampleCommand}"
                   CancelText="Back" CancelCommand="{Binding BackCommand}"
                   PrimaryText="{Binding NextText}" PrimaryCommand="{Binding NextCommand}">
      <TextBlock Classes="secondary num" Text="{Binding PositionText}" />
    </c:SheetFooter>
  </StackPanel>
</UserControl>
