<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.WebMapSheetView"
             x:DataType="sh:WebMapSheetViewModel">
  <!-- A folder with a web page of these structures on a map: who it is for decides what it shows -->
  <StackPanel Spacing="16">
    <StackPanel Spacing="4">
      <TextBlock Classes="fieldLabel" Text="Title"
                 ToolTip.Tip="A folder with a web page of these structures on a map. Works offline except the background." />
      <TextBox Text="{Binding MapTitle}" AutomationProperties.Name="Title of the web map" />
    </StackPanel>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="sheetSection" Text="Who it is for" />
        <RadioButton GroupName="WebMapPrivacy" IsChecked="{Binding IsInternal}" AutomationProperties.Name="For the office and partners: a dot for each structure with its address">
          <TextBlock TextWrapping="Wrap" Text="Office and partners: a dot per structure, with address and result." />
        </RadioButton>
        <RadioButton GroupName="WebMapPrivacy" IsChecked="{Binding IsPublic}" AutomationProperties.Name="For the public: counts in grid squares, no owners or exact locations">
          <TextBlock TextWrapping="Wrap" Text="Public: counts in grid squares, no owners or exact locations." />
        </RadioButton>

        <!-- Internal: popup fields -->
        <StackPanel Spacing="6" IsVisible="{Binding IsInternal}" Margin="0,6,0,0">
          <TextBlock Classes="fieldLabel" Text="Also show in each structure's popup" ToolTip.Tip="Address, result and percent damaged always show." />
          <ItemsControl ItemsSource="{Binding PopupFields}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel ItemSpacing="16" LineSpacing="4" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="sh:PopupFieldOption">
                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Public: addresses and grid -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" IsVisible="{Binding IsPublic}" Margin="0,6,0,0">
          <StackPanel Spacing="4">
            <TextBlock Classes="fieldLabel" Text="Addresses" />
            <RadioButton GroupName="WebMapAddresses" IsChecked="{Binding ShowBlocks}" Content="Cut to the block (100 block of River St)" />
            <RadioButton GroupName="WebMapAddresses" IsChecked="{Binding !ShowBlocks}" Content="Hidden" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Classes="fieldLabel" Text="Grid squares" />
            <ListBox Classes="segmented" ItemsSource="{x:Static sh:WebMapSheetViewModel.CellSizeNames}" SelectedIndex="{Binding CellSizeIndex}"
                     AutomationProperties.Name="Size of the grid squares" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <StackPanel Spacing="4">
      <TextBlock Classes="fieldLabel" Text="Background map" ToolTip.Tip="The background needs the internet; None needs nothing." />
      <ListBox Classes="segmented" SelectedIndex="{Binding BasemapIndex}" AutomationProperties.Name="Background map" HorizontalAlignment="Left"
               ToolTip.Tip="The background needs the internet; None needs nothing.">
        <ListBoxItem Content="USGS topographic" />
        <ListBoxItem Content="OpenStreetMap" />
        <ListBoxItem Content="None" />
      </ListBox>
    </StackPanel>

    <CheckBox Content="{Binding SummaryLabel}" IsChecked="{Binding IncludeSummary}" />

    <Border Classes="subtle" IsVisible="{Binding HasProblem}">
      <TextBlock Classes="issue required" Text="{Binding Problem}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
    </Border>
    <c:SheetFooter IsBusy="{Binding IsBusy}" PrimaryText="Make Web Map…" PrimaryCommand="{Binding CreateCommand}" IsPrimaryDefault="False" />
  </StackPanel>
</UserControl>
