<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.OwnerLettersSheetView"
             x:DataType="sh:OwnerLettersSheetViewModel">
  <!-- Owner letters: a template for each kind of letter, the office the letters come from, then write them -->
  <StackPanel Spacing="16">
    <TextBlock Classes="medium" Text="{Binding CountText}" TextWrapping="Wrap" />
    <Border Classes="card">
      <StackPanel Spacing="8">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="link" Content="Show the Templates Folder" Command="{Binding ShowTemplatesFolderCommand}" Padding="0" VerticalAlignment="Center" />
          <TextBlock Classes="sheetSection" Text="Templates" />
        </DockPanel>
        <ItemsControl ItemsSource="{Binding Kinds}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sh:LetterKindRowViewModel">
              <Grid ColumnDefinitions="240,*" ColumnSpacing="12" Margin="0,0,0,6">
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Templates}" SelectedItem="{Binding Template}" HorizontalAlignment="Stretch" PlaceholderText="Choose a template"
                          AutomationProperties.Name="{Binding AccessibleName}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="muted" Text="{Binding LeftOutText}" TextWrapping="Wrap" IsVisible="{Binding LeftOutText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !HasTemplates}">
          <TextBlock Text="There are no letter templates yet." VerticalAlignment="Center" />
          <Button Content="Create Starter Templates" Command="{Binding CreateStarterTemplatesCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Classes="sheetSection" Text="From" ToolTip.Tip="Remembered for this database. Blank: each structure's NFIP community name." />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
          <TextBlock Classes="fieldLabel" Text="Community" ToolTip.Tip="Blank: each structure's NFIP community name." />
          <TextBlock Grid.Column="1" Classes="fieldLabel" Text="Office" />
          <TextBox Grid.Row="1" Text="{Binding CommunityName}" AutomationProperties.Name="Community name" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OfficeName}" PlaceholderText="For example: Floodplain Management Office" AutomationProperties.Name="Office name" />
          <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="fieldLabel" Text="Office address" Margin="0,8,0,0" />
          <TextBox Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding OfficeAddress}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" AutomationProperties.Name="Office address" />
          <TextBlock Grid.Row="4" Classes="fieldLabel" Text="Phone" Margin="0,8,0,0" />
          <TextBlock Grid.Row="4" Grid.Column="1" Classes="fieldLabel" Text="Email" Margin="0,8,0,0" />
          <TextBox Grid.Row="5" Text="{Binding OfficePhone}" AutomationProperties.Name="Office phone" />
          <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding OfficeEmail}" AutomationProperties.Name="Office email" />
          <TextBlock Grid.Row="6" Classes="fieldLabel" Text="Signed by" Margin="0,8,0,0" />
          <TextBlock Grid.Row="6" Grid.Column="1" Classes="fieldLabel" Text="Title" Margin="0,8,0,0" />
          <TextBox Grid.Row="7" Text="{Binding OfficialName}" AutomationProperties.Name="Name of the official who signs" />
          <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding OfficialTitle}" PlaceholderText="For example: Floodplain Administrator" AutomationProperties.Name="Title of the official who signs" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- Kept on screen: a legal caution before letters go out -->
    <TextBlock Classes="secondary" TextWrapping="Wrap" Text="Letters use FEMA's result. Review the templates with your counsel before sending." />
    <TextBlock Classes="medium" Text="{Binding ResultText}" TextWrapping="Wrap" IsVisible="{Binding ResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <TextBlock Text="{Binding WarningText}" Foreground="{DynamicResource RequiredFg}" TextWrapping="Wrap" IsVisible="{Binding WarningText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <c:SheetFooter LeadingText="Mark as Sent…" LeadingCommand="{Binding MarkSentCommand}" IsLeadingVisible="{Binding HasWritten}"
                   LeadingToolTip="Sets these assessments to Letter sent, which locks them"
                   CancelText="Done" PrimaryText="Choose a Folder and Write…" PrimaryCommand="{Binding WriteCommand}" IsPrimaryDefault="False" />
  </StackPanel>
</UserControl>
