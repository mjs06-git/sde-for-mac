<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sde.App.ViewModels"
             xmlns:v="using:Sde.App.Views"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.ImportExportView"
             x:DataType="vm:ImportExportViewModel"
             Classes="dataPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://SDE/Styles/Scope.Data.axaml" />
  </UserControl.Styles>

  <!-- In the window's toolbar: the three tabs -->
  <v:PageChrome.Toolbar>
    <StackPanel Classes="pageToolbar">
      <ListBox Classes="segmented" Name="ImportExportTabs" SelectedIndex="{Binding TabIndex}" AutomationProperties.Name="Import, export or field work">
        <ListBoxItem Content="Import" AutomationProperties.Name="Import" ToolTip.Tip="Bring in SDE data, inspections, parcels and settings" />
        <ListBoxItem Content="Export" AutomationProperties.Name="Export" ToolTip.Tip="SDE data, spreadsheets, maps and your setup" />
        <ListBoxItem Content="Field Work" AutomationProperties.Name="Field Work" ToolTip.Tip="Photos, work packages and coordinates" />
      </ListBox>
    </StackPanel>
  </v:PageChrome.Toolbar>

  <!-- Each tab is a short page of white cards: a heading, one-line rows with the action at the right, and a preview
       nested in its card when there is one. What each row does is in its tooltip. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" Name="ImportExportScroller">
    <!-- A column at most 880 wide, against the left edge (a StackPanel alone would shrink to its widest row) -->
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="880" /></Grid.ColumnDefinitions>
      <StackPanel Margin="{StaticResource PagePadding}" Spacing="20">
        <!-- The event chosen in the sidebar limits the exports; what the last action did -->
        <StackPanel Spacing="8">
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.Or}">
              <Binding Path="HasScopeNote" />
              <Binding Path="LastResult" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
            </MultiBinding>
          </StackPanel.IsVisible>
          <c:Banner Tone="Accent" Icon="Event" Text="{Binding ScopeNote}" IsVisible="{Binding HasScopeNote}" AutomationProperties.Name="Exports cover one event" />
          <c:Banner Tone="Info" Text="{Binding LastResult}" IsVisible="{Binding LastResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    AutomationProperties.LiveSetting="Polite">
            <Button Classes="link" Content="Dismiss" Command="{Binding DismissResultCommand}" />
          </c:Banner>
        </StackPanel>

        <!-- ───────────── Import ───────────── -->
        <StackPanel Spacing="20" IsVisible="{Binding IsImportTab}" Name="ImportTab">
          <!-- The drop zone: an SDE folder or database opens its preview here, a spreadsheet opens the import page -->
          <Border Classes="dropCard" Name="DropZone" ToolTip.Tip="An SDE export folder or .mdb database is shown here first. A spreadsheet opens Import Inspections or Parcels.">
            <Panel>
              <Rectangle Classes="dropOutline" />
              <StackPanel Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,24">
                <Border Classes="dropIcon"><c:Icon Kind="Download" /></Border>
                <TextBlock Classes="dropTitle" Text="Drop a database, spreadsheet or SDE folder here" />
                <StackPanel Classes="rowButtons" HorizontalAlignment="Center">
                  <Button Content="SDE Export Folder…" Command="{Binding ChooseSdeFolderCommand}" ToolTip.Tip="SDE 3 (Export.json) or SDE 2.x (SummaryData.xml)" />
                  <Button Content="SDE Database (.mdb)…" Command="{Binding ChooseMdbCommand}" ToolTip.Tip="A FEMA SDE database file, e.g. from a colleague's Windows PC" />
                </StackPanel>
              </StackPanel>
            </Panel>
          </Border>

          <!-- Preview of a pending SDE import -->
          <Border Classes="dataCard" IsVisible="{Binding HasPending}" Name="PendingCard">
            <StackPanel Spacing="12">
              <DockPanel Classes="cardHead">
                <c:Icon Classes="cardIcon" Kind="Database" />
                <TextBlock DockPanel.Dock="Right" Classes="cardNote" Text="{Binding PendingRows.Count, StringFormat='{}{0} found'}" />
                <TextBlock Classes="cardHeading" Text="Ready to import" ToolTip.Tip="{Binding PendingSource}" />
              </DockPanel>
              <TextBlock Classes="secondary" Text="{Binding PendingSource}" TextTrimming="CharacterEllipsis" Margin="0,-8,0,0" />
              <TextBlock Text="{Binding PendingNotes}" Classes="issue recommended" TextWrapping="Wrap"
                         IsVisible="{Binding PendingNotes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <Border Classes="previewCard">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Classes="previewHead">
                    <Grid ColumnDefinitions="32,2*,2*,*">
                      <TextBlock Grid.Column="1" Text="Structure" />
                      <TextBlock Grid.Column="2" Text="Assessment" />
                      <TextBlock Grid.Column="3" Text="Status" />
                    </Grid>
                  </Border>
                  <ScrollViewer Classes="previewScroll" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding PendingRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ImportRowViewModel">
                          <Border Classes="previewRow">
                            <Grid ColumnDefinitions="32,2*,2*,*">
                              <CheckBox IsChecked="{Binding Include}" AutomationProperties.Name="{Binding Address, StringFormat='Import {0}'}" />
                              <TextBlock Grid.Column="1" Text="{Binding Address}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                              <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="secondary" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                              <TextBlock Grid.Column="3" Text="{Binding Status}" Classes="secondary" TextTrimming="CharacterEllipsis" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </Border>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="If already in your database" VerticalAlignment="Center" />
                  <ComboBox SelectedIndex="{Binding ExistingChoice}" Width="260" AutomationProperties.Name="If a structure is already in your database">
                    <ComboBoxItem Content="Keep mine (skip it)" />
                    <ComboBoxItem Content="Replace mine with the imported one" />
                    <ComboBoxItem Content="Keep both (import a copy)" />
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="rowButtons">
                  <Button Content="Cancel" Command="{Binding CancelImportCommand}" />
                  <Button Classes="primary" Content="Import Checked" Command="{Binding RunImportCommand}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- From other systems -->
          <Border Classes="dataCard" Name="OtherSystemsCard">
            <StackPanel>
              <DockPanel Classes="cardHead">
                <c:Icon Classes="cardIcon" Kind="Table" />
                <TextBlock Classes="cardHeading" Text="Other systems" />
              </DockPanel>
              <StackPanel Classes="actionRows">
                <Border Classes="actionRow">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <TextBlock Classes="rowLabel" Text="Inspections or parcels" ToolTip.Tip="From a permit system, spreadsheet or assessor roll (.xlsx, .xls, .csv, .dbf). Importing again updates only what changed." />
                    <Button Grid.Column="1" Content="Import Inspections or Parcels…" Command="{Binding OpenSourceImportCommand}"
                            ToolTip.Tip="From a permit system, spreadsheet or assessor roll (.xlsx, .xls, .csv, .dbf). Importing again updates only what changed." />
                  </Grid>
                </Border>
                <Border Classes="actionRow">
                  <v:EnterpriseImportView DataContext="{Binding Enterprise}" />
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- A settings file from a colleague -->
          <Border Classes="dataCard" Name="SettingsFileImportCard">
            <StackPanel>
              <DockPanel Classes="cardHead">
                <c:Icon Classes="cardIcon" Kind="Settings" />
                <TextBlock Classes="cardHeading" Text="Settings file" ToolTip.Tip="Notes, mappings and default values from a colleague. Works with FEMA's SDE." />
              </DockPanel>
              <StackPanel Classes="actionRows">
                <Border Classes="actionRow">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <TextBlock Classes="rowLabel" Text="Notes, mappings and default values" />
                    <Button Grid.Column="1" Content="Import Settings File…" Command="{Binding ImportSettingsFileCommand}"
                            ToolTip.Tip="Notes and mappings are added. Default values replace yours (you're asked first)." />
                  </Grid>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ───────────── Export ───────────── -->
        <StackPanel Spacing="20" IsVisible="{Binding IsExportTab}" Name="ExportTab">
          <!-- FEMA's SDE: its own export folder -->
          <Border Classes="dataCard" Name="SdeExportCard">
            <StackPanel>
              <DockPanel Classes="cardHead">
                <c:Icon Classes="cardIcon" Kind="Database" />
                <TextBlock Classes="cardHeading" Text="FEMA SDE data" ToolTip.Tip="SDE's own format: a folder with Export.json and the photos. FEMA's SDE 3.0 can import it." />
              </DockPanel>
              <StackPanel Classes="actionRows">
                <Border Classes="actionRow">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <TextBlock Classes="rowLabel" Text="Everything in this database or event" />
                    <Button Grid.Column="1" Classes="primary" Content="Export All to an SDE Folder…" Command="{Binding ExportAllCommand}"
                            ToolTip.Tip="Everything in this database or event. For some, check them on Structures and use Export." />
                  </Grid>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Spreadsheets and maps -->
          <Border Classes="dataCard" Name="SpreadsheetsCard">
            <StackPanel>
              <DockPanel Classes="cardHead">
                <c:Icon Classes="cardIcon" Kind="Table" />
                <TextBlock Classes="cardHeading" Text="Spreadsheets and maps" />
              </DockPanel>
              <StackPanel Classes="actionRows">
                <Border Classes="actionRow">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <TextBlock Classes="rowLabel" Text="Excel" ToolTip.Tip="One row per assessment, in SDE's 218 columns" />
                    <Button Grid.Column="1" Content="Export to Excel…" Command="{Binding ExportExcelCommand}"
                            ToolTip.Tip="One row per assessment, in SDE's 218 columns" />
                  </Grid>
                </Border>
                <Border Classes="actionRow">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <TextBlock Classes="rowLabel" Text="Google Earth map" ToolTip.Tip="A pin per assessment, coloured by percent damaged" />
                    <Button Grid.Column="1" Content="Save Map (.kmz)…" Command="{Binding ExportMapCommand}"
                            ToolTip.Tip="A pin per assessment, coloured by percent damaged" />
                  </Grid>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Settings file: notes, mappings and default values to share with colleagues -->
          <Border Classes="dataCard" Name="SetupCard">
            <StackPanel>
              <DockPanel Classes="cardHead">
                <c:Icon Classes="cardIcon" Kind="Settings" />
                <TextBlock Classes="cardHeading" Text="Your setup" ToolTip.Tip="Notes, mappings and default values, to share with colleagues. Works with FEMA's SDE." />
              </DockPanel>
              <StackPanel Classes="actionRows">
                <Border Classes="actionRow">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                      <CheckBox Content="Saved notes" IsChecked="{Binding SettingsIncludeNotes}" />
                      <CheckBox Content="Spreadsheet import mappings" IsChecked="{Binding SettingsIncludeMappings}" />
                      <CheckBox Content="Default values" IsChecked="{Binding SettingsIncludeDefaults}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Save Settings File…" Command="{Binding ExportSettingsFileCommand}" />
                  </Grid>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ───────────── Field work ───────────── -->
        <StackPanel Spacing="20" IsVisible="{Binding IsFieldWorkTab}" Name="FieldWorkTab">
          <Border Classes="dataCard" Name="PhotosCard">
            <StackPanel>
              <DockPanel Classes="cardHead">
                <c:Icon Classes="cardIcon" Kind="Camera" />
                <TextBlock Classes="cardHeading" Text="Photos" />
              </DockPanel>
              <StackPanel Classes="actionRows">
                <Border Classes="actionRow">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <TextBlock Classes="rowLabel" Text="A folder of photos from the field" ToolTip.Tip="Matched by record ID, parcel, address or GPS. You see every match first." />
                    <Button Grid.Column="1" Content="Match a Photo Folder to Structures…" Command="{Binding MatchPhotoFolderCommand}"
                            ToolTip.Tip="Matched by record ID, parcel, address or GPS. You see every match first." />
                  </Grid>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="dataCard" Name="WorkPackagesCard">
            <StackPanel>
              <DockPanel Classes="cardHead">
                <c:Icon Classes="cardIcon" Kind="FolderOpen" />
                <TextBlock DockPanel.Dock="Right" Classes="cardNote" Text="{Binding CheckedOut.Count, StringFormat='{}{0} out'}" IsVisible="{Binding HasCheckedOut}" />
                <TextBlock Classes="cardHeading" Text="Work packages" />
              </DockPanel>
              <StackPanel Classes="actionRows">
                <Border Classes="actionRow">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <TextBlock Classes="rowLabel" Text="A package back from the field" ToolTip.Tip="Its work replaces the copies here" />
                    <Button Grid.Column="1" Content="Check In a Work Package…" Command="{Binding CheckInCommand}"
                            ToolTip.Tip="A package back from the field: its work replaces the copies here" />
                  </Grid>
                </Border>
                <Border Classes="actionRow" IsVisible="{Binding HasCheckedOut}">
                  <Border Classes="previewCard">
                    <ItemsControl ItemsSource="{Binding CheckedOut}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CheckedOutPackage">
                          <Border Classes="previewRow">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                              <Button Grid.Column="1" Classes="link" Content="Take Back…" VerticalAlignment="Center"
                                      Command="{Binding $parent[UserControl].((vm:ImportExportViewModel)DataContext).TakeBackPackageCommand}" CommandParameter="{Binding}"
                                      AutomationProperties.Name="{Binding TakeBackName}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="dataCard" Name="CoordinatesCard">
            <StackPanel>
              <DockPanel Classes="cardHead">
                <c:Icon Classes="cardIcon" Kind="MapPin" />
                <TextBlock Classes="cardHeading" Text="Coordinates" ToolTip.Tip="Save a spreadsheet, fill in Latitude and Longitude, then read it back" />
              </DockPanel>
              <StackPanel Classes="actionRows">
                <Border Classes="actionRow">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <TextBlock Classes="rowLabel" Text="Latitude and longitude to fill in" ToolTip.Tip="Every structure, with columns for Latitude and Longitude to fill in" />
                    <StackPanel Grid.Column="1" Classes="rowButtons">
                      <Button Content="Save Coordinates Spreadsheet…" Command="{Binding ExportLatLongCommand}"
                              ToolTip.Tip="Every structure, with columns for Latitude and Longitude to fill in" />
                      <Button Content="Read Coordinates…" Command="{Binding ChooseLatLongCommand}"
                              ToolTip.Tip="The filled-in spreadsheet. You see every change before it's saved." />
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- Coordinates read from a spreadsheet, to check before they are saved -->
                <Border Classes="actionRow" IsVisible="{Binding HasLatLong}">
                  <StackPanel Spacing="12">
                    <TextBlock Classes="semibold" Text="{Binding LatLongSummary}" TextWrapping="Wrap" />
                    <Border Classes="previewCard">
                      <DockPanel>
                        <Border DockPanel.Dock="Top" Classes="previewHead">
                          <Grid ColumnDefinitions="32,2*,1.3*,1.3*,2*">
                            <TextBlock Grid.Column="1" Text="Structure" />
                            <TextBlock Grid.Column="2" Text="Now" />
                            <TextBlock Grid.Column="3" Text="From spreadsheet" />
                          </Grid>
                        </Border>
                        <ScrollViewer Classes="previewScroll" HorizontalScrollBarVisibility="Disabled">
                          <ItemsControl ItemsSource="{Binding LatLongRows}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:LatLongRowViewModel">
                                <Border Classes="previewRow">
                                  <Grid ColumnDefinitions="32,2*,1.3*,1.3*,2*">
                                    <CheckBox IsChecked="{Binding Include}" IsEnabled="{Binding CanInclude}" AutomationProperties.Name="{Binding Address, StringFormat='Update {0}'}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Address}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Current}" Classes="secondary num" />
                                    <TextBlock Grid.Column="3" Text="{Binding New}" Classes="num" />
                                    <TextBlock Grid.Column="4" Text="{Binding Note}" Classes="issue" Classes.required="{Binding IsProblem}" Classes.recommended="{Binding !IsProblem}" TextWrapping="Wrap" />
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                      </DockPanel>
                    </Border>
                    <StackPanel Classes="rowButtons" HorizontalAlignment="Right">
                      <Button Content="Cancel" Command="{Binding CancelLatLongCommand}" />
                      <Button Classes="primary" Content="Save Checked Coordinates" Command="{Binding ApplyLatLongCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
