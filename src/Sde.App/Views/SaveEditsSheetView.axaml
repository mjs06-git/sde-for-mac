<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.SaveEditsSheetView"
             x:DataType="sh:SaveEditsSheetViewModel">
  <StackPanel Spacing="16">
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    <c:SheetFooter LeadingText="Don't Save" LeadingCommand="{Binding DiscardCommand}" IsLeadingDestructive="True"
                   LeadingAutomationName="Don't save: throw the edits away" CancelAutomationName="Cancel: keep editing"
                   PrimaryText="Save" PrimaryCommand="{Binding SaveCommand}" PrimaryAutomationName="Save the edits" />
  </StackPanel>
</UserControl>
