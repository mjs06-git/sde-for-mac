<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             xmlns:vm="using:Sde.App.ViewModels"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.CopyValuesSheetView"
             x:DataType="sh:CopyValuesSheetViewModel">
  <!-- Map, Copy Values from Areas: which areas' field goes into which structure field, then a preview table to tick -->
  <StackPanel Spacing="16">
    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
      <StackPanel Spacing="4">
        <TextBlock Classes="fieldLabel" Text="From the areas of" />
        <ComboBox ItemsSource="{Binding Layers}" SelectedItem="{Binding Layer}" HorizontalAlignment="Stretch" AutomationProperties.Name="Layer of areas to copy from">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MapLayerViewModel">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock Classes="fieldLabel" Text="Their field" />
        <ComboBox ItemsSource="{Binding Fields}" SelectedItem="{Binding SourceField}" HorizontalAlignment="Stretch" MaxDropDownHeight="400"
                  AutomationProperties.Name="Field of the areas to copy" />
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="4">
        <TextBlock Classes="fieldLabel" Text="Into the structure field" />
        <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" HorizontalAlignment="Stretch" MaxDropDownHeight="400"
                  AutomationProperties.Name="Structure field to copy into" />
      </StackPanel>
    </Grid>
    <StackPanel Orientation="Horizontal" Spacing="16">
      <RadioButton GroupName="CopyWhich" IsChecked="{Binding OnlySelected}" IsEnabled="{Binding HasSelection}" Content="{Binding SelectedText}"
                   AutomationProperties.Name="Copy onto the selected structures" />
      <RadioButton GroupName="CopyWhich" IsChecked="{Binding AllStructures}" Content="{Binding AllText}"
                   AutomationProperties.Name="Copy onto every structure on the map" />
    </StackPanel>

    <StackPanel Spacing="8">
      <TextBlock Classes="medium" Text="{Binding SummaryText}" AutomationProperties.LiveSetting="Polite"
                 ToolTip.Tip="Each value is checked as if typed, and the copy can be reverted. Locked and checked-out assessments are skipped." />
      <Border Classes="sheetTable" IsVisible="{Binding HasRows}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="sheetTableHead">
            <Grid ColumnDefinitions="32,2*,*,*,2*">
              <TextBlock Grid.Column="1" Text="Structure" />
              <TextBlock Grid.Column="2" Text="Now" />
              <TextBlock Grid.Column="3" Text="New" />
              <TextBlock Grid.Column="4" Text="How It Was Matched" />
            </Grid>
          </Border>
          <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sh:CopyValueRowViewModel">
                  <Border Classes="sheetTableRow">
                    <Grid ColumnDefinitions="32,2*,*,*,2*">
                      <CheckBox IsChecked="{Binding IsTicked}" IsEnabled="{Binding CanCopy}" VerticalAlignment="Center" AutomationProperties.Name="{Binding TickName}" />
                      <TextBlock Grid.Column="1" Text="{Binding Address}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <TextBlock Grid.Column="2" Classes="secondary" Text="{Binding Now}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <TextBlock Grid.Column="3" Classes="medium" Text="{Binding New}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <TextBlock Grid.Column="4" Classes="muted" Text="{Binding How}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </StackPanel>

    <c:SheetFooter PrimaryText="{Binding CopyText}" PrimaryCommand="{Binding CopyCommand}" />
  </StackPanel>
</UserControl>
