<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sde.App.ViewModels"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.DepthTablesPanel"
             x:DataType="vm:DepthTablesViewModel">
  <Border Classes="card">
    <StackPanel Spacing="12">
      <TextBlock Classes="h3" Text="Your depth tables"
                 ToolTip.Tip="Your community's depth-damage tables. On the Damage step, Suggest from Depth Table fills in values to accept or change. Saved as you type." />

      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasTables}">
        <ComboBox ItemsSource="{Binding Names}" SelectedItem="{Binding SelectedName}" Width="300"
                  PlaceholderText="Choose a table" AutomationProperties.Name="Depth table to edit" />
        <Button Command="{Binding NewTableCommand}" AutomationProperties.Name="New table">
          <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="Plus" Size="12" /><TextBlock Text="New Table" /></StackPanel>
        </Button>
        <Button Classes="danger" Content="Delete Table…" Command="{Binding DeleteTableCommand}" IsVisible="{Binding HasTable}" />
      </StackPanel>
      <c:EmptyState IsVisible="{Binding !HasTables}" Title="No Depth Tables" Padding="12" ToolTip.Tip="One per kind of flooding and building type">
        <Button Classes="primary" Command="{Binding NewTableCommand}" AutomationProperties.Name="New table">
          <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="Plus" Size="12" /><TextBlock Text="New Table" /></StackPanel>
        </Button>
      </c:EmptyState>

      <StackPanel Spacing="10" IsVisible="{Binding HasTable}">
        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="16">
          <StackPanel Classes="field">
            <TextBlock Classes="fieldLabel" Text="Name" />
            <TextBox Text="{Binding TableName}" Width="300" AutomationProperties.Name="Depth table name" />
            <TextBlock Classes="issue required" Text="{Binding NameProblem}" IsVisible="{Binding NameProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Classes="field">
            <TextBlock Classes="fieldLabel" Text="Building type" />
            <ComboBox SelectedIndex="{Binding BuildingTypeIndex}" Width="220" AutomationProperties.Name="Building type the depth table is for">
              <ComboBoxItem Content="Residential" />
              <ComboBoxItem Content="Non-residential" />
            </ComboBox>
          </StackPanel>
        </Grid>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="eyebrow" Text="Depth (ft)" Width="100" VerticalAlignment="Bottom" />
              <ItemsControl ItemsSource="{Binding ElementNames}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Classes="eyebrow" Text="{Binding}" Width="78" Margin="0,0,4,0" TextWrapping="Wrap" VerticalAlignment="Bottom" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DepthRowViewModel">
                  <StackPanel Orientation="Horizontal" Margin="0,2">
                    <NumericUpDown Value="{Binding Depth}" Width="92" Margin="0,0,8,0" ShowButtonSpinner="False" Minimum="-10" Maximum="100" FormatString="0.##"
                                   AutomationProperties.Name="{Binding DepthLabel}" />
                    <ItemsControl ItemsSource="{Binding Cells}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DepthCellViewModel">
                          <NumericUpDown Value="{Binding Percent}" Width="78" Margin="0,0,4,0" ShowButtonSpinner="False" Minimum="0" Maximum="100" FormatString="0.##"
                                         AutomationProperties.Name="{Binding Label}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="icon" Command="{Binding Remove}" ToolTip.Tip="Remove this row" AutomationProperties.Name="{Binding RemoveLabel}">
                      <c:Icon Kind="Close" Size="14" />
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        <Button Content="Add Row" Command="{Binding AddRowCommand}" HorizontalAlignment="Left"
                ToolTip.Tip="Percent damaged, 0 to 100, interpolated between depths. Empty: no suggestion." />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
