<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.EcImportSheetView"
             x:DataType="sh:EcImportSheetViewModel">
  <!-- Elevation Certificate: the values read from the PDF beside the assessment's, as a small table to tick -->
  <StackPanel Spacing="16">
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    <c:Banner Tone="Warning" Icon="Warning" Text="{Binding AddressWarning}" IsVisible="{Binding HasAddressWarning}" AutomationProperties.Name="Address check" />

    <Border Classes="sheetTable" IsVisible="{Binding HasRows}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Classes="sheetTableHead">
          <Grid ColumnDefinitions="36,2*,2*,3*">
            <TextBlock Grid.Column="1" Text="Field" />
            <TextBlock Grid.Column="2" Text="Now" />
            <TextBlock Grid.Column="3" Text="Certificate" />
          </Grid>
        </Border>
        <ScrollViewer MaxHeight="380" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="sh:EcRowViewModel">
                <Border Classes="sheetTableRow">
                  <Grid ColumnDefinitions="36,2*,2*,3*">
                    <CheckBox IsChecked="{Binding IsChecked}" IsVisible="{Binding IsReadOnly}" AutomationProperties.Name="{Binding CheckName}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="medium" Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="2" Classes="secondary" Text="{Binding Current}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="3" Text="{Binding Proposed}" IsVisible="{Binding IsReadOnly}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <TextBox Grid.Column="3" Text="{Binding Value}" IsVisible="{Binding IsEditable}" AutomationProperties.Name="{Binding Label}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding HasNotes}">
      <StackPanel Spacing="4">
        <TextBlock Classes="sheetSection" Text="Left out" />
        <ItemsControl ItemsSource="{Binding Notes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Classes="secondary" Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <TextBlock Classes="danger" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
    <c:SheetFooter LeadingText="Keep the PDF Only" LeadingCommand="{Binding AttachOnlyCommand}" IsLeadingVisible="{Binding CanAttach}"
                   LeadingToolTip="Keep the certificate with the structure without changing any value"
                   PrimaryText="Save" PrimaryCommand="{Binding SaveCommand}" IsPrimaryVisible="{Binding CanAttach}" />
  </StackPanel>
</UserControl>
