<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.SetEventSheetView"
             x:DataType="sh:SetEventSheetViewModel">
  <StackPanel Spacing="16">
    <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" />
    <StackPanel Spacing="4">
      <TextBlock Classes="fieldLabel" Text="Event" />
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="New Event…" Command="{Binding NewEventCommand}" Margin="8,0,0,0" />
        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch" AutomationProperties.Name="Event" />
      </DockPanel>
    </StackPanel>
    <c:SheetFooter PrimaryText="Set Event" PrimaryCommand="{Binding ApplyCommand}"
                   PrimaryToolTip="Moves assessments from any other event. Recorded in History." />
  </StackPanel>
</UserControl>
