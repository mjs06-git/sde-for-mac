<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sde.App.ViewModels"
             xmlns:ed="using:Sde.App.ViewModels.Editor"
             xmlns:v="using:Sde.App.Views"
             xmlns:c="using:Sde.App.Controls"
             xmlns:app="using:Sde.App"
             x:Class="Sde.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Classes="dataPage">
  <UserControl.Resources>
    <!-- The miniature app on an Appearance tile: the navy frame (sidebar and title band) round bright content, with a
         white card and the dark result card. Drawn from tokens, so inside a ThemeVariantScope it shows that theme. -->
    <ControlTemplate x:Key="MiniApp">
      <Border Classes="miniFrame" Width="220" Height="92">
        <Grid ColumnDefinitions="46,*" RowDefinitions="16,*">
          <StackPanel Grid.RowSpan="2" Margin="8,22,8,0" Spacing="6">
            <Border Classes="miniLine selected" Width="28" />
            <Border Classes="miniLine onFrame" Width="22" />
            <Border Classes="miniLine onFrame" Width="26" />
            <Border Classes="miniLine onFrame" Width="18" />
          </StackPanel>
          <Border Grid.Column="1" Classes="miniLine onFrame" Width="44" Margin="4,0,0,0" VerticalAlignment="Center" />
          <Border Grid.Column="1" Grid.Row="1" Classes="miniContent">
            <Grid ColumnDefinitions="*,44" ColumnSpacing="6">
              <Border Classes="miniCard">
                <StackPanel Spacing="6">
                  <Border Classes="miniLine" Width="56" />
                  <Border Classes="miniLine" Width="80" />
                  <Border Classes="miniLine" Width="64" />
                  <Border Classes="miniButton" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="miniCard hero" />
            </Grid>
          </Border>
        </Grid>
      </Border>
    </ControlTemplate>
  </UserControl.Resources>

  <UserControl.DataTemplates>
    <!-- A group of default values: a white card of fields, three to a row -->
    <DataTemplate DataType="ed:FieldGroupViewModel">
      <Border Classes="card">
        <StackPanel Spacing="16">
          <TextBlock Classes="h3" Text="{Binding Title}" />
          <ItemsControl Classes="fields" ItemsSource="{Binding Fields}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><c:FieldGrid Columns="3" MinColumnWidth="180" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.DataTemplates>

  <!-- In the style of the Mac's System Settings: the categories in a white card list on the left of the content, one
       shown on the right as a column of white cards. Each row is a label and its control; what a setting does is in its
       tooltip. -->
  <Grid ColumnDefinitions="Auto,*">
    <Border Classes="settingsRail" Name="SettingsRail">
      <ListBox Classes="steps" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" AutomationProperties.Name="Settings categories">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SettingsCategoryItem">
            <StackPanel Orientation="Horizontal" Spacing="10" ToolTip.Tip="{Binding Subtitle}">
              <Border Classes="stepIcon">
                <c:Icon Kind="{Binding Icon}" Size="16" />
              </Border>
              <TextBlock Classes="stepTitle" Text="{Binding Title}" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <ScrollViewer Grid.Column="1" Name="SettingsScroller" HorizontalScrollBarVisibility="Disabled">
      <!-- A column at most 840 wide, against the left edge, the same width in every category -->
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="840" /></Grid.ColumnDefinitions>
        <StackPanel Margin="{StaticResource PagePadding}" Spacing="20">
          <TextBlock Classes="pageHeading" Text="{Binding SelectedCategory.Title}" ToolTip.Tip="{Binding SelectedCategory.Subtitle}" Name="CategoryHeading" />

          <!-- General -->
          <StackPanel Spacing="20" IsVisible="{Binding IsGeneral}">
            <Border Classes="card settings">
              <StackPanel Classes="settingsGroup">
                <Border Classes="settingsRow">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <TextBlock Classes="medium" Text="Your name" VerticalAlignment="Center" ToolTip.Tip="Shown in History next to your changes" />
                    <TextBox Grid.Column="1" Text="{Binding YourName}" Width="260" VerticalAlignment="Center" AutomationProperties.Name="Your name, shown in edit history" />
                  </Grid>
                </Border>
                <Border Classes="settingsRow">
                  <ToggleSwitch IsChecked="{Binding CheckLatLong}" OnContent="" OffContent="" AutomationProperties.Name="Check that latitude and longitude are inside the structure's state"
                                ToolTip.Tip="FEMA's Lat/Long Validation">
                    <ToggleSwitch.Content>
                      <TextBlock Classes="medium" Text="Check coordinates are in the structure's state" />
                    </ToggleSwitch.Content>
                  </ToggleSwitch>
                </Border>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="16">
                <TextBlock Classes="h3" Text="Your fields" ToolTip.Tip="Three extra fields on every assessment" />
                <ItemsControl Classes="fields" ItemsSource="{Binding CustomFieldNames}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><c:FieldGrid Columns="3" MinColumnWidth="160" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CustomFieldNameViewModel">
                      <StackPanel Classes="field">
                        <Panel Classes="fieldHead"><TextBlock Classes="fieldLabel" Text="{Binding Slot}" /></Panel>
                        <TextBox Text="{Binding Name}" MaxLength="50" AutomationProperties.Name="{Binding Slot, StringFormat='Custom {0} name'}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <TextBlock Classes="h3" Text="Note snippets" VerticalAlignment="Center" ToolTip.Tip="Text to insert into notes" />
                  <Button Grid.Column="1" Command="{Binding AddSnippetCommand}" AutomationProperties.Name="Add snippet">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:Icon Kind="Plus" Size="12" />
                      <TextBlock Text="Add Snippet" />
                    </StackPanel>
                  </Button>
                </Grid>
                <TextBlock Classes="secondary" Text="No Snippets" IsVisible="{Binding Snippets.Count, Converter={x:Static app:Converters.IsZero}}" />
                <ItemsControl ItemsSource="{Binding Snippets}" IsVisible="{Binding Snippets.Count, Converter={x:Static app:Converters.IsPositive}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SnippetViewModel">
                      <Grid ColumnDefinitions="200,*,Auto" ColumnSpacing="10" Margin="0,0,0,8">
                        <TextBox Text="{Binding Name}" MaxLength="50" VerticalAlignment="Top" AutomationProperties.Name="Snippet name" />
                        <TextBox Grid.Column="1" Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="34" AutomationProperties.Name="{Binding Name, StringFormat='Text of snippet {0}'}" />
                        <Button Grid.Column="2" Classes="icon" VerticalAlignment="Top" ToolTip.Tip="Delete"
                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).DeleteSnippetCommand}" CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Delete snippet {0}'}">
                          <c:Icon Kind="Trash" Size="14" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Appearance -->
          <StackPanel Spacing="20" IsVisible="{Binding IsAppearance}" Name="AppearancePanel">
            <Border Classes="card">
              <StackPanel Spacing="16">
                <TextBlock Classes="h3" Text="Light or dark" ToolTip.Tip="Changes at once" />
                <ListBox Classes="themeTiles" Name="ThemeTiles" SelectedIndex="{Binding ThemeIndex}" AutomationProperties.Name="Appearance: match the Mac, light or dark">
                  <ListBoxItem AutomationProperties.Name="Match System" ToolTip.Tip="Light or dark, as the Mac is set in System Settings">
                    <StackPanel>
                      <Border Classes="tilePreview">
                        <Viewbox Stretch="Uniform">
                          <Canvas Width="220" Height="92" ClipToBounds="True">
                            <ThemeVariantScope RequestedThemeVariant="Light">
                              <ContentControl Template="{StaticResource MiniApp}" />
                            </ThemeVariantScope>
                            <Border Canvas.Left="110" Width="110" Height="92" ClipToBounds="True">
                              <Canvas>
                                <ThemeVariantScope Canvas.Left="-110" RequestedThemeVariant="Dark">
                                  <ContentControl Template="{StaticResource MiniApp}" />
                                </ThemeVariantScope>
                              </Canvas>
                            </Border>
                          </Canvas>
                        </Viewbox>
                      </Border>
                      <TextBlock Classes="tileLabel" Text="Match System" />
                    </StackPanel>
                  </ListBoxItem>
                  <ListBoxItem AutomationProperties.Name="Light">
                    <StackPanel>
                      <Border Classes="tilePreview">
                        <Viewbox Stretch="Uniform">
                          <ThemeVariantScope RequestedThemeVariant="Light">
                            <ContentControl Template="{StaticResource MiniApp}" />
                          </ThemeVariantScope>
                        </Viewbox>
                      </Border>
                      <TextBlock Classes="tileLabel" Text="Light" />
                    </StackPanel>
                  </ListBoxItem>
                  <ListBoxItem AutomationProperties.Name="Dark">
                    <StackPanel>
                      <Border Classes="tilePreview">
                        <Viewbox Stretch="Uniform">
                          <ThemeVariantScope RequestedThemeVariant="Dark">
                            <ContentControl Template="{StaticResource MiniApp}" />
                          </ThemeVariantScope>
                        </Viewbox>
                      </Border>
                      <TextBlock Classes="tileLabel" Text="Dark" />
                    </StackPanel>
                  </ListBoxItem>
                </ListBox>
              </StackPanel>
            </Border>

            <Border Classes="card settings">
              <StackPanel Classes="settingsGroup">
                <Border Classes="settingsRow">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <TextBlock Classes="medium" Text="Accent colour" VerticalAlignment="Center" ToolTip.Tip="The colour of buttons, links and selected rows. Changes at once." />
                    <ListBox Grid.Column="1" Classes="segmented" Name="AccentChoice" SelectedIndex="{Binding AccentIndex}" VerticalAlignment="Center"
                             AutomationProperties.Name="Accent colour">
                      <ListBoxItem AutomationProperties.Name="SDE blue">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <Ellipse Classes="swatch" Fill="{DynamicResource SwatchBrandAccent}" />
                          <TextBlock Text="SDE Blue" VerticalAlignment="Center" />
                        </StackPanel>
                      </ListBoxItem>
                      <ListBoxItem AutomationProperties.Name="The Mac's accent colour" IsEnabled="{Binding CanUseMacAccent}"
                                   ToolTip.Tip="{Binding MacAccentNote}" ToolTip.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <Ellipse Classes="swatch" Fill="{DynamicResource SwatchMacAccent}" />
                          <TextBlock Text="Mac Accent" VerticalAlignment="Center" />
                        </StackPanel>
                      </ListBoxItem>
                    </ListBox>
                  </Grid>
                </Border>
                <Border Classes="settingsRow">
                  <ToggleSwitch IsChecked="{Binding IncreaseContrast}" OnContent="" OffContent="" Name="IncreaseContrastSwitch" AutomationProperties.Name="Increase contrast"
                                ToolTip.Tip="Stronger borders, dividers and text. Also on whenever Increase Contrast is on in System Settings, Accessibility.">
                    <ToggleSwitch.Content>
                      <TextBlock Classes="medium" Text="Increase contrast" />
                    </ToggleSwitch.Content>
                  </ToggleSwitch>
                </Border>
                <Border Classes="settingsRow">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="medium" Text="Density" ToolTip.Tip="Compact fits more rows and fields on the screen" />
                      <TextBlock Classes="rowDetail" Text="{x:Static vm:SettingsViewModel.DensityNote}" Name="DensityNote" />
                    </StackPanel>
                    <ListBox Grid.Column="1" Classes="segmented" Name="DensityChoice" SelectedIndex="{Binding DensityIndex}" VerticalAlignment="Center"
                             AutomationProperties.Name="Density">
                      <ListBoxItem Content="Comfortable" AutomationProperties.Name="Comfortable" />
                      <ListBoxItem Content="Compact" AutomationProperties.Name="Compact" />
                    </ListBox>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Defaults -->
          <StackPanel Spacing="20" IsVisible="{Binding IsDefaults}">
            <Border Classes="card settings">
              <StackPanel Classes="settingsGroup">
                <Border Classes="settingsRow">
                  <ToggleSwitch IsChecked="{Binding UseDefaults}" OnContent="" OffContent="" AutomationProperties.Name="Fill new structures with my default values"
                                ToolTip.Tip="FEMA's Enter Default Data. Saved as you type.">
                    <ToggleSwitch.Content>
                      <TextBlock Classes="medium" Text="Fill new structures with my default values" />
                    </ToggleSwitch.Content>
                  </ToggleSwitch>
                </Border>
              </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding DefaultGroups}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="20" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>

          <!-- Reports & letters -->
          <Panel IsVisible="{Binding IsReportsAndLetters}"><v:OutputSettingsPanel DataContext="{Binding Outputs}" /></Panel>

          <!-- Online services -->
          <StackPanel Spacing="20" IsVisible="{Binding IsOnlineServices}">
            <Border Classes="card settings">
              <StackPanel Classes="settingsGroup">
                <Border Classes="settingsRow">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="rowIcon"><c:Icon Kind="MapPin" Size="16" /></Border>
                    <TextBlock Grid.Column="1" Classes="medium" Text="U.S. Census Bureau geocoder" Margin="12,0,0,0" VerticalAlignment="Center"
                               ToolTip.Tip="Coordinates from a street address" />
                  </Grid>
                </Border>
                <Border Classes="settingsRow">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="rowIcon"><c:Icon Kind="Flood" Size="16" /></Border>
                    <TextBlock Grid.Column="1" Classes="medium" Text="FEMA National Flood Hazard Layer" Margin="12,0,0,0" VerticalAlignment="Center"
                               ToolTip.Tip="Flood zone, FIRM panel and NFIP community at a structure's coordinates" />
                  </Grid>
                </Border>
                <Border Classes="settingsRow">
                  <Grid ColumnDefinitions="Auto,*,280">
                    <Border Classes="rowIcon"><c:Icon Kind="Flood" Size="16" /></Border>
                    <TextBlock Grid.Column="1" Classes="medium" Text="USGS high-water marks (STN)" Margin="12,0,12,0" VerticalAlignment="Center"
                               ToolTip.Tip="Provisional data from USGS. Leave the address empty to use USGS's own." />
                    <TextBox Grid.Column="2" Text="{Binding UsgsStnUrl}" PlaceholderText="{Binding UsgsStnDefault}" VerticalAlignment="Center"
                             AutomationProperties.Name="USGS high-water mark service address" />
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
            <c:Banner Tone="Info" Text="Used only when you look something up, and sends only addresses, coordinates, or the event and states."
                      ToolTip.Tip="You review every value before it's saved" />
          </StackPanel>

          <!-- Phone form -->
          <Panel IsVisible="{Binding IsPhoneForm}"><v:PhoneFormPanel DataContext="{Binding PhoneForm}" /></Panel>

          <!-- AI assistants -->
          <Panel IsVisible="{Binding IsAiAssistants}"><v:AiAssistantsPanel DataContext="{Binding AiAssistants}" /></Panel>

          <!-- Map & GIS -->
          <Panel IsVisible="{Binding IsMapAndGis}"><v:MapGisPanel DataContext="{Binding MapGis}" /></Panel>

          <!-- Depth tables -->
          <Panel IsVisible="{Binding IsDepthTables}"><v:DepthTablesPanel DataContext="{Binding DepthTables}" /></Panel>

          <!-- Backups -->
          <StackPanel Spacing="20" IsVisible="{Binding IsBackups}">
            <Border Classes="card settings">
              <StackPanel Classes="settingsGroup">
                <Border Classes="settingsRow">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="1">
                      <TextBlock Classes="medium" Text="Database file" />
                      <SelectableTextBlock Classes="sm secondary" Text="{Binding DatabasePath}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Show in Finder" Command="{Binding RevealDatabaseCommand}" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <Border Classes="settingsRow">
                  <StackPanel Spacing="1">
                    <TextBlock Classes="medium" Text="Photos folder" />
                    <SelectableTextBlock Classes="sm secondary" Text="{Binding AttachmentsPath}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border Classes="settingsRow">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" ToolTip.Tip="{Binding BackupsText}">
                    <TextBlock Classes="medium" Text="Automatic backups" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding BackupsState}" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="16">
                <TextBlock Classes="h3" Text="This database" ToolTip.Tip="Tip: one database per event; share through Import &amp; Export" />
                <WrapPanel>
                  <Button Margin="0,0,8,8" Content="Save a Copy…" Command="{Binding BackUpCommand}" />
                  <Button Margin="0,0,8,8" Content="Restore from Backup…" Command="{Binding RestoreBackupCommand}" />
                  <Button Margin="0,0,8,8" Content="Move…" Command="{Binding MoveDatabaseCommand}" AutomationProperties.Name="Move the database" />
                  <Button Margin="0,0,8,8" Content="Open Another…" Command="{Binding OpenDatabaseCommand}" />
                  <Button Margin="0,0,8,8" Content="New Empty Database…" Command="{Binding NewDatabaseCommand}" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- About -->
          <StackPanel Spacing="20" IsVisible="{Binding IsAbout}" Name="AboutPanel">
            <Border Classes="card">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="24">
                <c:Icon Classes="aboutMark" Kind="BrandMark" AutomationProperties.Name="SDE" />
                <StackPanel Grid.Column="1" Spacing="6">
                  <TextBlock Classes="aboutName" Text="{x:Static vm:SettingsViewModel.ProductName}" />
                  <TextBlock Classes="secondary num" Name="AboutVersion"><Run Text="Version " /><Run Text="{Binding Version}" /></TextBlock>
                  <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{x:Static vm:SettingsViewModel.AboutNote}" Margin="0,6,0,0" />
                  <WrapPanel Margin="0,10,0,0">
                    <Button Margin="0,0,8,8" Classes="primary" Content="What's New" Command="{Binding OpenWhatsNewCommand}" IsVisible="{Binding HasWhatsNew}" />
                    <Button Margin="0,0,8,8" Content="SDE Help" Command="{Binding ShowHelpCommand}" ToolTip.Tip="Every field's help, in a list you can search" />
                    <Button Margin="0,0,8,8" Content="FEMA SDE User Manual" Command="{Binding OpenManualCommand}" />
                  </WrapPanel>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
