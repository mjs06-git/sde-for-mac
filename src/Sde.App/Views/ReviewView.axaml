<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sde.App.ViewModels"
             xmlns:v="using:Sde.App.Views"
             xmlns:app="using:Sde.App"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.ReviewView"
             x:DataType="vm:ReviewViewModel">
  <UserControl.Resources>
    <!-- One quality finding in a check's card: where, and Open / Merge / Set aside (or, set aside, the reason and Bring back) -->
    <DataTemplate x:Key="FindingRow" x:DataType="vm:QaFindingViewModel">
      <Border Classes="cardRow">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Address}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Message}" />
            <TextBlock Classes="rowDetail" Text="{Binding Message}" ToolTip.Tip="{Binding Message}" IsVisible="{Binding IsOpen}" />
            <TextBlock Classes="rowDetail" Text="{Binding DismissedText}" TextWrapping="Wrap" IsVisible="{Binding IsDismissed}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Content="Merge…" IsVisible="{Binding CanMerge}" ToolTip.Tip="Merge the two records of this building into one"
                    Command="{Binding Merge}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibleMerge}" />
            <Button Content="{Binding OpenText}" IsVisible="{Binding CanOpen}" ToolTip.Tip="{Binding OpenTip}"
                    Command="{Binding Open}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibleOpen}" />
            <Button Content="Set Aside…" IsVisible="{Binding CanDismiss}"
                    Command="{Binding Dismiss}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibleDismiss}" />
            <Button Content="Bring Back" IsVisible="{Binding IsDismissed}"
                    Command="{Binding BringBack}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibleBringBack}" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <!-- In the window's toolbar: Queue or Checks, and the page's actions -->
  <v:PageChrome.Toolbar>
    <StackPanel Classes="pageToolbar">
      <Button Classes="chip" IsVisible="{Binding HasOnly}" Command="{Binding ClearOnlyCommand}"
              ToolTip.Tip="Show every assessment again" AutomationProperties.Name="{Binding OnlyLabel, StringFormat='{}{0}. Show every assessment'}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding OnlyLabel}" VerticalAlignment="Center" />
          <c:Icon Kind="Close" Size="12" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <ListBox Classes="segmented" SelectedIndex="{Binding TabIndex}" AutomationProperties.Name="Queue or quality checks">
        <ListBoxItem Content="Queue" AutomationProperties.Name="Queue" ToolTip.Tip="{Binding QueueTabText}" />
        <ListBoxItem Content="Checks" AutomationProperties.Name="Quality checks" ToolTip.Tip="{Binding ChecksTabText}" />
      </ListBox>
      <Button Content="Check Again" Command="{Binding RunChecksCommand}" ToolTip.Tip="Read the assessments again and run the quality checks" />
      <Button Classes="primary" Content="Mark Reviewed" Command="{Binding MarkReviewedCommand}"
              ToolTip.Tip="The checked assessments, or the selected one. Final and Letter Sent ones are left alone." />
      <Button Classes="icon toolbar" Command="{Binding Shell.Structures.ToggleInspectorCommand}" IsVisible="{Binding IsQueueTab}"
              AutomationProperties.Name="Show or hide the inspector" ToolTip.Tip="Show or Hide Inspector (⌥⌘I)">
        <c:Icon Kind="Inspector" Size="18" />
      </Button>
    </StackPanel>
  </v:PageChrome.Toolbar>

  <Panel>
    <!-- The queue: the table card, the counts under it, and the selected assessment in the inspector -->
    <c:ListDetailPage IsVisible="{Binding IsQueueTab}" InspectorWidth="{Binding Shell.InspectorWidth}" IsInspectorVisible="{Binding Shell.Structures.IsInspectorVisible}"
                      ResetInspectorWidthCommand="{Binding Shell.ResetInspectorWidthCommand}">
      <c:ListDetailPage.FilterBar>
        <StackPanel Classes="filterRow">
          <ComboBox Classes="sm" ItemsSource="{x:Static vm:ReviewViewModel.StatusChoices}" SelectedIndex="{Binding StatusFilter}" MinWidth="160"
                    AutomationProperties.Name="Status filter" />
        </StackPanel>
      </c:ListDetailPage.FilterBar>

      <c:ListDetailPage.Status>
        <Panel Classes="pageStatus">
          <TextBlock IsVisible="{Binding !HasChecked}">
            <Run Text="{Binding CountText}" /><Run Text=" · " /><Run Text="{Binding OpenFindingCount, StringFormat='{}{0} open checks'}" /><Run Text=" · " /><Run Text="{Binding OpenCommentCount, StringFormat='{}{0} open comments'}" />
          </TextBlock>
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasChecked}">
            <TextBlock Text="{Binding CheckedText}" />
            <Button Classes="link" Content="Clear" Command="{Binding ClearCheckedCommand}" AutomationProperties.Name="Uncheck every assessment" />
          </StackPanel>
        </Panel>
      </c:ListDetailPage.Status>

      <Grid>
        <Border Classes="tableSheet" IsVisible="{Binding HasRows}">
          <Border Classes="tableClip">
            <DataGrid Name="Queue" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                      IsReadOnly="True" CanUserSortColumns="True" CanUserReorderColumns="False" CanUserResizeColumns="True" SelectionMode="Single"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="{StaticResource TableRowHeight}"
                      AutomationProperties.Name="Assessments to review" ToolTip.Tip="Problems first. Double-click to open."
                      DoubleTapped="OnQueueDoubleTapped" KeyDown="OnQueueKeyDown">
              <DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Open" Command="{Binding OpenSelectedCommand}" />
                  <MenuItem Header="Mark Reviewed" Command="{Binding MarkReviewedCommand}" />
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridTemplateColumn Width="34" CanUserSort="False" CanUserResize="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:ReviewRowViewModel">
                      <CheckBox Classes="rowCheck" IsChecked="{Binding IsChecked}" HorizontalAlignment="Center" AutomationProperties.Name="{Binding AccessibleCheck}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Structure" SortMemberPath="Address" Width="1.4*" MinWidth="150">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:ReviewRowViewModel">
                      <TextBlock Classes="cell" Text="{Binding Address}" ToolTip.Tip="{Binding Detail}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Status" SortMemberPath="StatusOrder" Width="84">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:ReviewRowViewModel">
                      <TextBlock Classes="cell secondary" Text="{Binding Status}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Inspected" SortMemberPath="InspectedOn" Width="104">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:ReviewRowViewModel">
                      <TextBlock Classes="cell secondary" Text="{Binding Inspected}" ToolTip.Tip="{Binding Inspector}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Damaged" SortMemberPath="PercentSort" Width="136">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:ReviewRowViewModel">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="cellFigure" Text="{Binding PercentText}"
                                   app:ThemeBrush.Foreground="{Binding State, Converter={x:Static app:Converters.PercentForegroundKey}}" />
                        <c:StaffGauge Grid.Column="1" Classes="cellGauge" Value="{Binding PercentValue}" IsEmpty="{Binding !HasPercent}" />
                      </Grid>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Result" SortMemberPath="Result" Width="1.4*" MinWidth="150">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:ReviewRowViewModel">
                      <DockPanel Classes="result" Margin="8,0" VerticalAlignment="Center" ToolTip.Tip="{Binding Result}">
                        <Ellipse DockPanel.Dock="Left" Classes="dot" Margin="0,0,7,0" app:ThemeBrush.Fill="{Binding State, Converter={x:Static app:Converters.StatusDotKey}}" />
                        <TextBlock Text="{Binding Result}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </DockPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Checks" SortMemberPath="FindingCount" Width="96">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:ReviewRowViewModel">
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0" VerticalAlignment="Center" ToolTip.Tip="{Binding FindingTip}">
                        <TextBlock Classes="num" Text="{Binding FindingText}" IsVisible="{Binding HasFindings}" />
                        <TextBlock Classes="sm danger" Text="{Binding ErrorText}" IsVisible="{Binding HasErrors}" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Comments" SortMemberPath="CommentCount" Width="92">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:ReviewRowViewModel">
                      <TextBlock Classes="cell num" Text="{Binding CommentText}" IsVisible="{Binding HasComments}" ToolTip.Tip="Open comment threads" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Border>

        <c:EmptyState IsVisible="{Binding IsQueueEmpty}" Title="{Binding QueueEmptyTitle}" />
        <c:EmptyState IsVisible="{Binding NoRowsMatch}" Title="No Assessments with This Status">
          <Button Content="Show Assessments in Review" Command="{Binding ShowWaitingCommand}" />
        </c:EmptyState>
      </Grid>

      <!-- The selected assessment: its result, its checks, then the reviewers' comments -->
      <c:ListDetailPage.Inspector>
        <Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasSelection}">
            <StackPanel Classes="inspectorStack">
              <c:ResultHero Name="ReviewHero" DataContext="{Binding Selected}" x:DataType="vm:ReviewRowViewModel"
                            Title="{Binding Address}" Subtitle="{Binding Status}" PercentText="{Binding PercentText}" HasPercent="{Binding HasPercent}"
                            Verdict="{Binding Result}" IsSubstantial="{Binding IsSubstantial}" LineText="{Binding LineText}" Value="{Binding PercentValue}" />

              <Border Classes="sideCard">
                <StackPanel Spacing="12">
                  <TextBlock Classes="cardTitle" Text="Checks" />
                  <TextBlock Classes="muted" Text="No open checks" IsVisible="{Binding !HasSelectedFindings}" />
                  <ItemsControl ItemsSource="{Binding SelectedFindings}" IsVisible="{Binding HasSelectedFindings}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:QaFindingViewModel">
                        <Grid Classes="checkRow" ColumnDefinitions="Auto,*,Auto">
                          <c:Icon Kind="{Binding Icon}" Size="14" Classes.danger="{Binding IsError}" Classes.warning="{Binding IsWarning}" Classes.accent="{Binding IsNote}" />
                          <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="{Binding Rule.Title}" TextWrapping="Wrap" />
                            <TextBlock Classes="rowDetail" Text="{Binding Message}" ToolTip.Tip="{Binding Message}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Top">
                            <Button Classes="link" Content="Show" IsVisible="{Binding HasField}" HorizontalAlignment="Right"
                                    Command="{Binding Open}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibleOpen}" />
                            <Button Classes="link" Content="Merge…" IsVisible="{Binding CanMerge}" HorizontalAlignment="Right"
                                    Command="{Binding Merge}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibleMerge}" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Classes="hairline" />
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Mark Reviewed" Command="{Binding MarkReviewedCommand}" AutomationProperties.Name="Mark the selected assessment reviewed" />
                    <Button Classes="primary" Content="Open" Command="{Binding OpenSelectedCommand}" MinWidth="88" HorizontalContentAlignment="Center"
                            AutomationProperties.Name="Open the assessment" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="sideCard">
                <StackPanel Spacing="12">
                  <TextBlock Classes="cardTitle" Text="Comments" />
                  <v:CommentThreadsView DataContext="{Binding SelectedComments}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <c:EmptyState IsVisible="{Binding !HasSelection}" Title="No Selection" />
        </Grid>
      </c:ListDetailPage.Inspector>
    </c:ListDetailPage>

    <!-- The quality checks: a card for each check with its findings, then the checks that could not run -->
    <DockPanel IsVisible="{Binding IsChecksTab}">
      <Border DockPanel.Dock="Top" Classes="scopeBar onPaper">
        <StackPanel Classes="filterRow">
          <ComboBox Classes="sm" ItemsSource="{x:Static vm:ReviewViewModel.SeverityChoices}" SelectedIndex="{Binding SeverityFilter}" MinWidth="160"
                    AutomationProperties.Name="Which checks to show" />
          <CheckBox Content="Show Set Aside" IsChecked="{Binding ShowDismissed}" Margin="8,0,0,0" />
        </StackPanel>
      </Border>
      <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !ShowsChecksEmptyState}">
          <StackPanel Classes="cardColumn">
            <TextBlock Classes="muted" Text="{Binding ChecksEmptyTitle}" IsVisible="{Binding ShowsNoFindingsLine}" />
            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="16" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:QaGroupViewModel">
                  <Border Classes="groupCard">
                    <StackPanel>
                      <Grid Classes="groupHead" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <c:Icon Kind="{Binding Icon}" Size="16" Classes.danger="{Binding IsError}" Classes.warning="{Binding IsWarning}" Classes.accent="{Binding IsNote}"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="groupTitle" Text="{Binding Title}" ToolTip.Tip="{Binding Description}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Classes="groupCount" Text="{Binding CountText}" />
                      </Grid>
                      <TextBlock Classes="rowDetail" Text="{Binding NoDismissNote}" IsVisible="{Binding HasNoDismissNote}" Margin="20,0,20,10" />
                      <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingRow}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Checks that could not run, quietly -->
            <Border Classes="quietGroup" IsVisible="{Binding HasNotChecked}">
              <StackPanel Spacing="10">
                <TextBlock Classes="groupTitle" Text="Not checked" />
                <ItemsControl ItemsSource="{Binding NotChecked}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:QaNotCheckedViewModel">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <c:Icon Kind="Info" Size="14" Classes="secondary" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Message}">
                          <Run Text="{Binding Title}" /><Run Text=" · " /><Run Foreground="{DynamicResource TextSecondary}" Text="{Binding Message}" />
                        </TextBlock>
                        <Button Grid.Column="2" Classes="sm" Content="Check Online" IsVisible="{Binding CanCheckOnline}"
                                Command="{Binding CheckOnline}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibleCheckOnline}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <c:EmptyState IsVisible="{Binding ShowsChecksEmptyState}" Title="{Binding ChecksEmptyTitle}" />
      </Grid>
    </DockPanel>
  </Panel>
</UserControl>
