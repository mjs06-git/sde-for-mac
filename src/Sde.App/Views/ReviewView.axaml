<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sde.App.ViewModels"
             xmlns:v="using:Sde.App.Views"
             xmlns:app="using:Sde.App"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.ReviewView"
             x:DataType="vm:ReviewViewModel">
  <UserControl.Resources>
    <!-- One quality finding: where, what, and Open / Set aside (or, set aside, the reason and Bring back) -->
    <DataTemplate x:Key="FindingRow" x:DataType="vm:QaFindingViewModel">
      <Border Classes="listRow">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Address}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Message}" />
            <TextBlock Classes="muted sm" Text="{Binding DismissedText}" TextWrapping="Wrap" IsVisible="{Binding IsDismissed}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Content="{Binding OpenText}" IsVisible="{Binding CanOpen}" ToolTip.Tip="{Binding OpenTip}"
                    Command="{Binding Open}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibleOpen}" />
            <Button Content="Set Aside…" IsVisible="{Binding CanDismiss}"
                    Command="{Binding Dismiss}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibleDismiss}" />
            <Button Content="Bring Back" IsVisible="{Binding IsDismissed}"
                    Command="{Binding BringBack}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibleBringBack}" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <!-- In the window's toolbar: Queue or Checks, the filter for the one showing, and the page's actions -->
  <v:PageChrome.Toolbar>
    <StackPanel Classes="pageToolbar">
      <Button Classes="chip" IsVisible="{Binding HasOnly}" Command="{Binding ClearOnlyCommand}"
              ToolTip.Tip="Show every assessment again" AutomationProperties.Name="{Binding OnlyLabel, StringFormat='{}{0}. Show every assessment'}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding OnlyLabel}" VerticalAlignment="Center" />
          <c:Icon Kind="Close" Size="12" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <ListBox Classes="segmented" SelectedIndex="{Binding TabIndex}" AutomationProperties.Name="Queue or quality checks">
        <ListBoxItem Content="Queue" AutomationProperties.Name="Queue" ToolTip.Tip="{Binding QueueTabText}" />
        <ListBoxItem Content="Checks" AutomationProperties.Name="Quality checks" ToolTip.Tip="{Binding ChecksTabText}" />
      </ListBox>
      <ComboBox ItemsSource="{x:Static vm:ReviewViewModel.StatusChoices}" SelectedIndex="{Binding StatusFilter}" MinWidth="160"
                IsVisible="{Binding IsQueueTab}" AutomationProperties.Name="Status filter" />
      <ComboBox ItemsSource="{x:Static vm:ReviewViewModel.SeverityChoices}" SelectedIndex="{Binding SeverityFilter}" MinWidth="160"
                IsVisible="{Binding IsChecksTab}" AutomationProperties.Name="Which checks to show" />
      <CheckBox Content="Show Set Aside" IsChecked="{Binding ShowDismissed}" IsVisible="{Binding IsChecksTab}" />
      <Button Content="Check Again" Command="{Binding RunChecksCommand}" ToolTip.Tip="Read the assessments again and run the quality checks" />
      <Button Classes="primary" Content="Mark Reviewed" Command="{Binding MarkReviewedCommand}"
              ToolTip.Tip="The checked assessments, or the selected one. Final and Letter Sent ones are left alone." />
    </StackPanel>
  </v:PageChrome.Toolbar>

  <Panel>
    <!-- The queue, with the selected assessment in the inspector -->
    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsQueueTab}">
      <DockPanel>
        <Panel DockPanel.Dock="Bottom">
          <Border Classes="statusBar" IsVisible="{Binding !HasChecked}">
            <TextBlock HorizontalAlignment="Center">
              <Run Text="{Binding CountText}" /><Run Text=" · " /><Run Text="{Binding OpenFindingCount, StringFormat='{}{0} open checks'}" /><Run Text=" · " /><Run Text="{Binding OpenCommentCount, StringFormat='{}{0} open comments'}" />
            </TextBlock>
          </Border>
          <Border Classes="statusBar" IsVisible="{Binding HasChecked}">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
              <TextBlock Text="{Binding CheckedText}" />
              <Button Classes="link" Content="Clear" Command="{Binding ClearCheckedCommand}" AutomationProperties.Name="Uncheck every assessment" />
            </StackPanel>
          </Border>
        </Panel>
        <Grid>
          <DataGrid Name="Queue" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" IsVisible="{Binding HasRows}"
                    IsReadOnly="True" CanUserSortColumns="True" CanUserReorderColumns="False" CanUserResizeColumns="True" SelectionMode="Single"
                    GridLinesVisibility="None" HeadersVisibility="Column" RowHeight="{StaticResource TableRowHeight}"
                    AutomationProperties.Name="Assessments to review" ToolTip.Tip="Problems first. Double-click to open."
                    DoubleTapped="OnQueueDoubleTapped" KeyDown="OnQueueKeyDown">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Open" Command="{Binding OpenSelectedCommand}" />
                <MenuItem Header="Mark Reviewed" Command="{Binding MarkReviewedCommand}" />
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="34" CanUserSort="False" CanUserResize="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ReviewRowViewModel">
                    <CheckBox IsChecked="{Binding IsChecked}" HorizontalAlignment="Center" AutomationProperties.Name="{Binding AccessibleCheck}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Structure" SortMemberPath="Address" Width="1.2*" MinWidth="150">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ReviewRowViewModel">
                    <TextBlock Classes="cell" Text="{Binding Address}" ToolTip.Tip="{Binding Detail}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Status" SortMemberPath="StatusOrder" Width="84">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ReviewRowViewModel">
                    <TextBlock Classes="cell" Text="{Binding Status}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Inspected" SortMemberPath="InspectedOn" Width="112">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ReviewRowViewModel">
                    <TextBlock Classes="cell" Text="{Binding Inspected}" ToolTip.Tip="{Binding Inspector}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Damaged" SortMemberPath="PercentSort" Width="84">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ReviewRowViewModel">
                    <TextBlock Classes="cell money" Text="{Binding PercentText}"
                               app:ThemeBrush.Foreground="{Binding State, Converter={x:Static app:Converters.PercentForegroundKey}}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Result" SortMemberPath="Result" Width="1.3*" MinWidth="150">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ReviewRowViewModel">
                    <StackPanel Classes="result" Orientation="Horizontal" Spacing="7" Margin="8,0" VerticalAlignment="Center">
                      <Ellipse Classes="dot" app:ThemeBrush.Fill="{Binding State, Converter={x:Static app:Converters.StatusDotKey}}" />
                      <TextBlock Text="{Binding Result}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Checks" SortMemberPath="FindingCount" Width="100">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ReviewRowViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0" VerticalAlignment="Center" ToolTip.Tip="{Binding FindingTip}">
                      <TextBlock Text="{Binding FindingText}" IsVisible="{Binding HasFindings}" FontFeatures="+tnum" />
                      <TextBlock Classes="sm danger" Text="{Binding ErrorText}" IsVisible="{Binding HasErrors}" VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Comments" SortMemberPath="CommentCount" Width="88">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ReviewRowViewModel">
                    <TextBlock Classes="cell" Text="{Binding CommentText}" IsVisible="{Binding HasComments}" FontFeatures="+tnum" ToolTip.Tip="Open comment threads" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <c:EmptyState IsVisible="{Binding IsQueueEmpty}" Title="{Binding QueueEmptyTitle}" />
          <c:EmptyState IsVisible="{Binding NoRowsMatch}" Title="No Assessments with This Status">
            <Button Content="Show Assessments in Review" Command="{Binding ShowWaitingCommand}" />
          </c:EmptyState>
        </Grid>
      </DockPanel>

      <!-- The selected assessment: its checks and comments -->
      <Border Grid.Column="1" Classes="inspector">
        <Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="12" Margin="16">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Spacing="2">
                  <TextBlock Classes="semibold" Text="{Binding SelectedTitle}" TextWrapping="Wrap" />
                  <TextBlock Classes="secondary sm" Text="{Binding SelectedDetail}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="Open" Command="{Binding OpenSelectedCommand}" VerticalAlignment="Top"
                        AutomationProperties.Name="Open the assessment" />
              </Grid>

              <StackPanel Spacing="10" IsVisible="{Binding HasSelectedFindings}">
                <Border Classes="hairline" />
                <TextBlock Classes="eyebrow" Text="Checks" />
                <ItemsControl ItemsSource="{Binding SelectedFindings}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:QaFindingViewModel">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <c:Icon Kind="{Binding Icon}" Size="14" Classes.danger="{Binding IsError}" Classes.warning="{Binding IsWarning}" Classes.accent="{Binding IsNote}"
                                Margin="0,1,0,0" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding Rule.Title}" TextWrapping="Wrap" ToolTip.Tip="{Binding Message}" />
                        <Button Grid.Column="2" Classes="link" Content="Show" IsVisible="{Binding HasField}" VerticalAlignment="Top"
                                Command="{Binding Open}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibleOpen}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <Border Classes="hairline" />
              <TextBlock Classes="eyebrow" Text="Comments" />
              <v:CommentThreadsView DataContext="{Binding SelectedComments}" />
            </StackPanel>
          </ScrollViewer>
          <c:EmptyState IsVisible="{Binding !HasSelection}" Title="No Selection" />
        </Grid>
      </Border>
    </Grid>

    <!-- The quality checks, grouped by check: plain sections divided by hairlines -->
    <Grid IsVisible="{Binding IsChecksTab}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasGroups}">
        <ItemsControl ItemsSource="{Binding Groups}" Margin="{StaticResource PagePadding}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="20" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:QaGroupViewModel">
              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <c:Icon Kind="{Binding Icon}" Size="14" Classes.danger="{Binding IsError}" Classes.warning="{Binding IsWarning}" Classes.accent="{Binding IsNote}"
                          VerticalAlignment="Center" />
                  <TextBlock Classes="h3" Text="{Binding Title}" VerticalAlignment="Center" ToolTip.Tip="{Binding Description}" />
                  <TextBlock Classes="secondary" Text="{Binding CountText}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="muted sm" Text="{Binding NoDismissNote}" IsVisible="{Binding HasNoDismissNote}" TextWrapping="Wrap" />
                <Border Classes="hairline" />
                <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingRow}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <c:EmptyState IsVisible="{Binding ChecksEmpty}" Title="{Binding ChecksEmptyTitle}" />
    </Grid>
  </Panel>
</UserControl>
