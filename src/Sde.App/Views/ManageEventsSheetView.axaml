<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.ManageEventsSheetView"
             x:DataType="sh:ManageEventsSheetViewModel">
  <!-- Event, Manage Events: the events as one small table, each with Edit; New Event at the foot's left, Done applies nothing -->
  <StackPanel Spacing="16">
    <TextBlock Classes="secondary" Text="No events yet." IsVisible="{Binding IsEmpty}"
               ToolTip.Tip="An event groups one disaster's assessments. Add one for each disaster you assess." />
    <Border Classes="sheetTable" IsVisible="{Binding !IsEmpty}" ToolTip.Tip="An event groups one disaster's assessments.">
      <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="sh:EventRowViewModel">
              <Border Classes="sheetTableRow" Padding="14,10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <c:Icon Kind="Event" Size="16" Classes="secondary" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Classes="medium" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button Grid.Column="2" Content="Edit…" Command="{Binding EditCommand}" AutomationProperties.Name="{Binding EditName}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    <c:SheetFooter IsDone="True" DoneCommand="{Binding DoneCommand}"
                   LeadingText="New Event…" LeadingCommand="{Binding NewCommand}" LeadingAutomationName="New event" />
  </StackPanel>
</UserControl>
