<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sde.App.ViewModels"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.AiAssistantsPanel"
             x:DataType="vm:AiAssistantsViewModel">
  <StackPanel Spacing="14">
    <Border Classes="card settings">
      <StackPanel Classes="settingsGroup">
        <Border Classes="settingsRow">
          <ToggleSwitch IsChecked="{Binding AllowEdits}" OnContent="" OffContent="" AutomationProperties.Name="Let AI assistants change this database"
                        ToolTip.Tip="Off: read, check and report only. On: can also edit fields, statuses, structures, events, comments and teams. Every change is in History; locked assessments stay locked; nothing is deleted.">
            <ToggleSwitch.Content>
              <TextBlock Classes="medium" Text="Let AI assistants change this database" />
            </ToggleSwitch.Content>
          </ToggleSwitch>
        </Border>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="12">
        <TextBlock Classes="h3" Text="Connect an assistant"
                   ToolTip.Tip="Needs SDE in Applications and this database opened in it once. Copy the setup again after switching databases." />
        <c:Banner Tone="Warning" Icon="Warning" Text="{Binding TranslocationWarning}" IsVisible="{Binding HasTranslocationWarning}" />

        <StackPanel Spacing="6">
          <TextBlock Classes="semibold" Text="Claude Code" />
          <Border Background="{DynamicResource BgSubtle}" CornerRadius="6" Padding="10,8">
            <SelectableTextBlock Classes="mono sm" Text="{Binding ClaudeCodeCommand}" TextWrapping="Wrap" />
          </Border>
          <Button Content="Copy Command" Command="{Binding CopyClaudeCodeCommand}" HorizontalAlignment="Left"
                  AutomationProperties.Name="Copy the Claude Code command" ToolTip.Tip="Paste it into Terminal" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="semibold" Text="Claude Desktop" ToolTip.Tip="Add to claude_desktop_config.json, then restart Claude Desktop" />
          <Border Background="{DynamicResource BgSubtle}" CornerRadius="6" Padding="10,8">
            <SelectableTextBlock Classes="mono sm" Text="{Binding ClaudeDesktopConfig}" TextWrapping="Wrap" />
          </Border>
          <Button Content="Copy Setup" Command="{Binding CopyClaudeDesktopCommand}" HorizontalAlignment="Left"
                  AutomationProperties.Name="Copy the Claude Desktop setup" ToolTip.Tip="Add to claude_desktop_config.json, then restart Claude Desktop" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="12">
        <TextBlock Classes="h3" Text="Recent changes by AI assistants"
                   ToolTip.Tip="Each line is one change. Revert restores the values from before it." />
        <TextBlock Classes="secondary" Text="No Changes" IsVisible="{Binding HasNoChanges}" />
        <ItemsControl ItemsSource="{Binding Changes}" IsVisible="{Binding HasChanges}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AiChangeRowViewModel">
              <Border Classes="rule" Padding="0,8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="1">
                    <TextBlock Classes="medium" Text="{Binding Summary}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding Detail}" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Revert" Command="{Binding RevertCommand}" IsVisible="{Binding CanRevert}" VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding RevertName}" ToolTip.Tip="{Binding RevertNote}" />
                  <c:Badge Grid.Column="1" Text="Reverted" IsVisible="{Binding IsReverted}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
