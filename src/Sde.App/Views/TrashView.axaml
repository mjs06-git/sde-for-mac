<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sde.App.ViewModels"
             xmlns:v="using:Sde.App.Views"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.TrashView"
             x:DataType="vm:TrashViewModel">
  <!-- In the window's toolbar: empty it (asks first) -->
  <v:PageChrome.Toolbar>
    <StackPanel Classes="pageToolbar">
      <Button Content="Empty Recently Deleted…" Command="{Binding EmptyAllCommand}" IsEnabled="{Binding !IsEmpty}"
              ToolTip.Tip="Permanently delete everything here" AutomationProperties.Name="Empty Recently Deleted" />
    </StackPanel>
  </v:PageChrome.Toolbar>

  <!-- The deleted items edge to edge; the count and the 30-day rule in the status bar under them -->
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="statusBar">
      <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center" ToolTip.Tip="{Binding Intro}" />
    </Border>
    <Grid>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !IsEmpty}">
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DeletedItemViewModel">
              <Border Classes="listRow" Padding="16,7">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <c:Icon Classes="secondary" Kind="{Binding Icon}" Size="16" VerticalAlignment="Center" ToolTip.Tip="{Binding Kind}" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Restore" Command="{Binding $parent[UserControl].((vm:TrashViewModel)DataContext).RestoreCommand}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Label, StringFormat='Restore {0}'}" />
                    <Button Content="Delete Now…" Command="{Binding $parent[UserControl].((vm:TrashViewModel)DataContext).DeleteNowCommand}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Label, StringFormat='Permanently delete {0}'}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <c:EmptyState IsVisible="{Binding IsEmpty}" Title="No Deleted Items" />
    </Grid>
  </DockPanel>
</UserControl>
