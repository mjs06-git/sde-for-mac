<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             x:Class="Sde.App.Views.CheckOutSheetView"
             x:DataType="sh:CheckOutSheetViewModel">
  <StackPanel Spacing="12">
    <TextBlock Classes="secondary" TextWrapping="Wrap"
               Text="For a Mac in the field: work offline there, then send it back. These assessments are read-only here until it's checked in." />
    <TextBlock Classes="medium" Text="{Binding Summary}" TextWrapping="Wrap" />
    <StackPanel Classes="field">
      <TextBlock Classes="fieldLabel" Text="Checked out to" />
      <TextBox Text="{Binding CheckedOutTo}" PlaceholderText="Team North, or a person" AutomationProperties.Name="Who the work package is checked out to" />
    </StackPanel>
    <TextBlock Classes="danger" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
      <Button Classes="primary" Content="Save Work Package…" IsDefault="True" Command="{Binding CreateCommand}" IsEnabled="{Binding CanCheckOut}" HorizontalContentAlignment="Center" />
    </StackPanel>
  </StackPanel>
</UserControl>
