<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.CheckOutSheetView"
             x:DataType="sh:CheckOutSheetViewModel">
  <!-- For a Mac in the field: the package is worked on offline there and sent back -->
  <StackPanel Spacing="16">
    <TextBlock Classes="medium" Text="{Binding Summary}" TextWrapping="Wrap"
               ToolTip.Tip="For a Mac in the field: work offline there, then send it back." />
    <StackPanel Spacing="4">
      <TextBlock Classes="fieldLabel" Text="Checked out to" />
      <TextBox Text="{Binding CheckedOutTo}" PlaceholderText="Team North, or a person" AutomationProperties.Name="Who the work package is checked out to" />
    </StackPanel>
    <TextBlock Classes="secondary" TextWrapping="Wrap" Text="These assessments are read-only here until it's checked in." />
    <TextBlock Classes="danger" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
    <c:SheetFooter PrimaryText="Save Work Package…" PrimaryCommand="{Binding CreateCommand}" IsPrimaryEnabled="{Binding CanCheckOut}" />
  </StackPanel>
</UserControl>
