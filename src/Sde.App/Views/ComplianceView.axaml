<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sde.App.ViewModels"
             xmlns:v="using:Sde.App.Views"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.ComplianceView"
             x:DataType="vm:ComplianceViewModel">

  <!--
    In the window's toolbar: open or closed cases; the path, ICC and overdue filters in a pop-up (which names the ones
    that are on); and the page's actions
  -->
  <v:PageChrome.Toolbar>
    <StackPanel Classes="pageToolbar">
      <ComboBox ItemsSource="{x:Static vm:ComplianceViewModel.ShowChoices}" SelectedIndex="{Binding ShowFilter}" MinWidth="128"
                AutomationProperties.Name="Open or closed cases" />
      <DropDownButton AutomationProperties.Name="Filters" ToolTip.Tip="Filter by path, ICC status or overdue">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <c:Icon Kind="Filter" Size="14" VerticalAlignment="Center" />
          <TextBlock Text="{Binding FilterSummary}" IsVisible="{Binding HasFilters}" MaxWidth="150" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </StackPanel>
        <DropDownButton.Flyout>
          <Flyout Placement="BottomEdgeAlignedRight">
            <StackPanel Spacing="4" Width="240">
              <TextBlock Classes="fieldLabel" Text="Path" />
              <ComboBox ItemsSource="{x:Static vm:ComplianceViewModel.PathChoices}" SelectedIndex="{Binding PathFilter}" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Path filter" />
              <TextBlock Classes="fieldLabel" Text="ICC status" Margin="0,6,0,0" />
              <ComboBox ItemsSource="{x:Static vm:ComplianceViewModel.IccChoices}" SelectedIndex="{Binding IccFilter}" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="ICC status filter" />
              <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                <CheckBox Content="Overdue Only" IsChecked="{Binding OverdueOnly}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Clear Filters" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Center" />
              </Grid>
            </StackPanel>
          </Flyout>
        </DropDownButton.Flyout>
      </DropDownButton>
      <Button Content="Open Missing Cases…" Command="{Binding OpenMissingCasesCommand}" IsVisible="{Binding HasMissing}"
              ToolTip.Tip="{Binding MissingText}" AutomationProperties.Name="Open cases for every substantially damaged structure without one" />
      <Button Content="Open Case…" Command="{Binding OpenSelectedCommand}" AutomationProperties.Name="Open the selected case" />
      <DropDownButton Content="Export" AutomationProperties.Name="Export the compliance list" ToolTip.Tip="The cases shown, as a PDF or a CSV">
        <DropDownButton.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuItem Header="Compliance Report (PDF)…" Command="{Binding ExportPdfCommand}" />
            <MenuItem Header="Compliance List (CSV)…" Command="{Binding ExportCsvCommand}" />
          </MenuFlyout>
        </DropDownButton.Flyout>
      </DropDownButton>
    </StackPanel>
  </v:PageChrome.Toolbar>

  <!-- The cases, edge to edge, with their counts and the last action's result in the status bar -->
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="statusBar">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="12,0">
        <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding LastResult, StringFormat=' · {0}'}" IsVisible="{Binding HasResult}" TextTrimming="CharacterEllipsis" MaxWidth="520"
                   ToolTip.Tip="{Binding LastResult}" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </Border>
    <Grid>
      <DataGrid Name="Cases" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" IsVisible="{Binding HasRows}"
                IsReadOnly="True" CanUserSortColumns="True" CanUserReorderColumns="False" CanUserResizeColumns="True" SelectionMode="Single"
                GridLinesVisibility="None" HeadersVisibility="Column" RowHeight="{StaticResource TableRowHeight}"
                AutomationProperties.Name="Compliance cases" ToolTip.Tip="Open cases first, by deadline. Double-click to open."
                DoubleTapped="OnCasesDoubleTapped" KeyDown="OnCasesKeyDown">
        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Open Case…" Command="{Binding OpenSelectedCommand}" />
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Structure" SortMemberPath="Address" Width="1.4*" MinWidth="150">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:ComplianceRowViewModel">
                <TextBlock Classes="cell" Text="{Binding Address}" ToolTip.Tip="{Binding Owner}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Owner" SortMemberPath="Owner" Width="0.9*" MinWidth="100">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:ComplianceRowViewModel">
                <TextBlock Classes="cell" Text="{Binding Owner}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Kind" SortMemberPath="Kind" Width="52" MinWidth="52">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:ComplianceRowViewModel">
                <TextBlock Classes="cell" Text="{Binding Kind}" ToolTip.Tip="{Binding KindTip}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Path" SortMemberPath="PathText" Width="0.9*" MinWidth="100">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:ComplianceRowViewModel">
                <TextBlock Classes="cell" Text="{Binding PathText}" ToolTip.Tip="{Binding PathText}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Permit" SortMemberPath="Permit" Width="88" MinWidth="88">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:ComplianceRowViewModel">
                <TextBlock Classes="cell" Text="{Binding Permit}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Deadline" SortMemberPath="DeadlineSort" Width="214" MinWidth="214">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:ComplianceRowViewModel">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DeadlineText}" VerticalAlignment="Center" />
                  <TextBlock Classes="sm danger" Text="{Binding OverdueText}" IsVisible="{Binding IsOverdue}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="ICC" SortMemberPath="IccText" Width="1*" MinWidth="120">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:ComplianceRowViewModel">
                <TextBlock Classes="cell" Text="{Binding IccText}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="EC Received" SortMemberPath="EcSort" Width="104" MinWidth="104">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:ComplianceRowViewModel">
                <TextBlock Classes="cell" Text="{Binding EcText}" ToolTip.Tip="Elevation certificate received" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Final Inspection" SortMemberPath="FinalSort" Width="112" MinWidth="112">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:ComplianceRowViewModel">
                <TextBlock Classes="cell" Text="{Binding FinalText}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Status" SortMemberPath="StatusText" Width="84" MinWidth="84">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:ComplianceRowViewModel">
                <StackPanel Classes="result" Orientation="Horizontal" Spacing="7" Margin="8,0" VerticalAlignment="Center">
                  <Panel VerticalAlignment="Center">
                    <Ellipse Classes="dot" Fill="{DynamicResource Accent}" IsVisible="{Binding IsOpen}" />
                    <Ellipse Classes="dot" Fill="{DynamicResource StatusIncompleteDot}" IsVisible="{Binding !IsOpen}" />
                  </Panel>
                  <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <c:EmptyState IsVisible="{Binding IsEmpty}" Title="No Compliance Cases">
        <Button Content="Open Missing Cases…" Command="{Binding OpenMissingCasesCommand}" IsVisible="{Binding HasMissing}" ToolTip.Tip="{Binding MissingText}"
                AutomationProperties.Name="Open cases for every substantially damaged structure without one" />
      </c:EmptyState>
      <c:EmptyState IsVisible="{Binding NoMatches}" Title="No Matching Cases">
        <Button Content="Clear Filters" Command="{Binding ClearFiltersCommand}" />
      </c:EmptyState>
    </Grid>
  </DockPanel>
</UserControl>
