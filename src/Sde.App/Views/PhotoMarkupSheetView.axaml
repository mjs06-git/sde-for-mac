<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             xmlns:v="using:Sde.App.Views"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.PhotoMarkupSheetView"
             x:DataType="sh:PhotoMarkupSheetViewModel">
  <!-- Marking up a photo: the tools, the photo, and in the footer Clear All (red), Undo and the count. A locked
       assessment's photo can only be looked at, so its footer is a single Done. -->
  <StackPanel Spacing="16">
    <TextBlock Classes="secondary" Text="{Binding Instruction}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />

    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12" IsVisible="{Binding IsEditable}">
      <ListBox Classes="segmented" ItemsSource="{x:Static sh:PhotoMarkupSheetViewModel.ToolNames}" SelectedIndex="{Binding ToolIndex}"
               AutomationProperties.Name="What to draw" VerticalAlignment="Center" />
      <ListBox Grid.Column="1" Classes="segmented" ItemsSource="{x:Static sh:PhotoMarkupSheetViewModel.Colours}" SelectedItem="{Binding Colour}"
               AutomationProperties.Name="Colour of the mark" VerticalAlignment="Center">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="sh:MarkupColour">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Border Width="12" Height="12" CornerRadius="6" Background="{Binding Brush}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBox Grid.Column="2" Text="{Binding Label}" PlaceholderText="{Binding LabelPlaceholder}" IsVisible="{Binding UsesLabel}" MaxLength="200"
               AutomationProperties.Name="Words on the mark" VerticalAlignment="Center" />
    </Grid>

    <Border Classes="sheetTable" Height="440" Background="{DynamicResource BgSubtle}"
            ToolTip.Tip="The original photo doesn't change; reports draw the marks on.">
      <Panel>
        <v:MarkupCanvas Source="{Binding Picture}" AutomationProperties.Name="{Binding FileName, StringFormat='{}{0}: drag across it to draw a mark'}" />
        <TextBlock Classes="muted" Text="{Binding FileName}" IsVisible="{Binding !HasPicture}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Panel>
    </Border>

    <TextBlock Classes="danger" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
    <c:SheetFooter LeadingText="Clear All" LeadingCommand="{Binding ClearAllCommand}" IsLeadingDestructive="True"
                   IsLeadingVisible="{Binding IsEditable}" IsLeadingEnabled="{Binding HasMarks}" LeadingAutomationName="Take every mark off the photo"
                   IsDone="{Binding !IsEditable}" PrimaryText="Save" PrimaryCommand="{Binding SaveCommand}">
      <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsEditable}">
        <Button Content="Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTip.Tip="Take back the last change" />
        <TextBlock Classes="muted" Text="{Binding CountText}" VerticalAlignment="Center" />
      </StackPanel>
    </c:SheetFooter>
  </StackPanel>
</UserControl>
