<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.AssignTeamSheetView"
             x:DataType="sh:AssignTeamSheetViewModel">
  <StackPanel Spacing="16">
    <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
      <TextBlock Classes="fieldLabel" Text="Team" />
      <TextBlock Grid.Column="1" Classes="fieldLabel" Text="Event" />
      <ComboBox Grid.Row="1" ItemsSource="{Binding Teams}" SelectedItem="{Binding Team}" HorizontalAlignment="Stretch" AutomationProperties.Name="Team" />
      <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Events}" SelectedItem="{Binding Event}" HorizontalAlignment="Stretch"
                AutomationProperties.Name="Event the assignment is for" />
      <TextBox Grid.Row="2" Text="{Binding NewTeamName}" IsVisible="{Binding IsNewTeam}" PlaceholderText="The new team's name" Margin="0,4,0,0"
               AutomationProperties.Name="The new team's name" />
    </Grid>
    <CheckBox IsChecked="{Binding AlsoSetTeamName}" AutomationProperties.Name="Also set FEMA's Team name field on the structures">
      <TextBlock TextWrapping="Wrap" Text="Also set FEMA's Team name field (exported)." />
    </CheckBox>
    <Border Classes="subtle" IsVisible="{Binding HasProblem}">
      <TextBlock Classes="issue required" Text="{Binding Problem}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
    </Border>
    <c:SheetFooter PrimaryText="Assign" PrimaryCommand="{Binding AssignCommand}" IsPrimaryDefault="False"
                   PrimaryToolTip="A structure already assigned for this event moves to the new team." />
  </StackPanel>
</UserControl>
