<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="using:Sde.App.Services"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.PhoneFormPanel"
             x:DataType="svc:PhoneFormService">
  <Border Classes="card">
    <StackPanel Spacing="12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <TextBlock Classes="h3" Text="Pair a phone" VerticalAlignment="Center"
                   ToolTip.Tip="Inspectors use a phone's browser over this Mac's Wi-Fi. Changes show in History as Phone. Stops after 12 hours or when SDE quits." />
        <Button Grid.Column="1" Classes="primary" Content="Start Phone Form" Command="{Binding StartCommand}" IsVisible="{Binding IsStopped}" />
      </Grid>
      <c:Banner Tone="Warning" Text="Traffic is not encrypted. Use it only on a network you trust." />

      <!-- Stopped -->
      <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding LastStopped}" IsVisible="{Binding LastStopped, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <!-- Running -->
      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsRunning}">
        <Border Background="{DynamicResource QrBackground}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="10" Padding="10" VerticalAlignment="Top" Margin="0,0,20,0">
          <Image Source="{Binding QrCode}" Width="200" Height="200" RenderOptions.BitmapInterpolationMode="None"
                 AutomationProperties.Name="QR code to pair a phone" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Classes="fieldLabel" Text="Address" ToolTip.Tip="Scan the QR code, or open this address on the phone and type the PIN" />
          <SelectableTextBlock Classes="xl semibold" Text="{Binding Address}" AutomationProperties.Name="Phone form address" />
          <TextBlock Classes="fieldLabel" Text="PIN" Margin="0,8,0,0" ToolTip.Tip="The QR code and PIN work once, for 10 minutes" />
          <SelectableTextBlock Classes="display" Text="{Binding Pin}" FontFamily="Menlo, Consolas, monospace" AutomationProperties.Name="Pairing PIN" />
          <c:Banner Tone="Danger" Text="{Binding PinWarning}" IsVisible="{Binding HasPinWarning}" Margin="0,4,0,0" />
          <TextBlock Classes="secondary" Text="{Binding TimeLeft}" Margin="0,6,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <Button Content="New Code" Command="{Binding NewCodeCommand}" AutomationProperties.Name="New pairing code" />
            <Button Classes="danger" Content="Stop Phone Form" Command="{Binding StopCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <StackPanel Spacing="6" IsVisible="{Binding IsRunning}">
        <TextBlock Classes="h3" Text="Paired phones" />
        <TextBlock Classes="secondary" Text="No Phones" IsVisible="{Binding !HasPhones}" />
        <ItemsControl ItemsSource="{Binding Phones}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="svc:PairedPhoneViewModel">
              <Border Classes="rule" Padding="0,8">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="danger" Content="Revoke" Command="{Binding RevokeCommand}" AutomationProperties.Name="{Binding RevokeLabel}" VerticalAlignment="Center" />
                  <Border Classes="rowIcon" DockPanel.Dock="Left" Margin="0,0,12,0"><c:Icon Kind="Phone" Size="16" /></Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Classes="medium" Text="{Binding Name}" />
                    <TextBlock Classes="muted" Text="{Binding Details}" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
