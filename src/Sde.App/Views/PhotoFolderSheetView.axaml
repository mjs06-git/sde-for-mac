<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.PhotoFolderSheetView"
             x:DataType="sh:PhotoFolderSheetViewModel">
  <StackPanel Spacing="16">
    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
               ToolTip.Tip="Matched by record ID, parcel or address in the file name, or GPS within 40 m. Unclear matches are left out." />
    <Border Classes="sheetTable">
      <DockPanel>
        <Border DockPanel.Dock="Top" Classes="sheetTableHead">
          <Grid ColumnDefinitions="30,1.4*,1.4*,1.6*,60">
            <TextBlock Grid.Column="1" Text="Photo" />
            <TextBlock Grid.Column="2" Text="Structure" />
            <TextBlock Grid.Column="3" Text="Why" />
            <TextBlock Grid.Column="4" Text="Distance" TextAlignment="Right" />
          </Grid>
        </Border>
        <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="sh:PhotoMatchRowViewModel">
                <Border Classes="sheetTableRow">
                  <Grid ColumnDefinitions="30,1.4*,1.4*,1.6*,60">
                    <CheckBox IsChecked="{Binding Include}" IsEnabled="{Binding CanInclude}" AutomationProperties.Name="{Binding IncludeLabel}" />
                    <TextBlock Grid.Column="1" Text="{Binding FileName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    <TextBlock Classes="medium" Grid.Column="2" Text="{Binding Structure}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" Classes.muted="{Binding IsProblem}" />
                    <TextBlock Grid.Column="3" Text="{Binding Reason}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"
                               Classes="secondary" Classes.issue="{Binding IsProblem}" Classes.recommended="{Binding IsProblem}" />
                    <TextBlock Grid.Column="4" Text="{Binding Distance}" Classes="secondary num" VerticalAlignment="Center" TextAlignment="Right" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <c:SheetFooter PrimaryText="Attach Ticked Photos" PrimaryCommand="{Binding AttachCommand}" IsPrimaryDefault="False" />
  </StackPanel>
</UserControl>
