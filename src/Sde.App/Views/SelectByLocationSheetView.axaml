<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             xmlns:vm="using:Sde.App.ViewModels"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.SelectByLocationSheetView"
             x:DataType="sh:SelectByLocationSheetViewModel">
  <!-- Map, Select by Location: a sentence in fields (Select … that … of …), then how to combine with the selection -->
  <StackPanel Spacing="16">
    <Border Classes="card">
      <StackPanel Spacing="12">
        <StackPanel Spacing="4">
          <TextBlock Classes="fieldLabel" Text="Select" />
          <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" HorizontalAlignment="Stretch" AutomationProperties.Name="Layer to select in">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MapLayerViewModel">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Classes="fieldLabel" Text="That" />
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <ComboBox ItemsSource="{Binding Relations}" SelectedItem="{Binding Relation}" HorizontalAlignment="Stretch" AutomationProperties.Name="How they relate" />
            <TextBox Grid.Column="1" Text="{Binding DistanceText}" Width="90" IsVisible="{Binding NeedsDistance}" AutomationProperties.Name="Distance" />
            <ListBox Grid.Column="2" Classes="segmented" SelectedIndex="{Binding UnitIndex}" IsVisible="{Binding NeedsDistance}" AutomationProperties.Name="Unit of the distance">
              <ListBoxItem Content="ft" />
              <ListBoxItem Content="mi" />
              <ListBoxItem Content="m" />
            </ListBox>
          </Grid>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Classes="fieldLabel" Text="Of" />
          <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" HorizontalAlignment="Stretch" AutomationProperties.Name="What to compare with" />
        </StackPanel>
      </StackPanel>
    </Border>
    <StackPanel Spacing="4">
      <TextBlock Classes="fieldLabel" Text="Selection" />
      <ListBox Classes="segmented" SelectedIndex="{Binding MethodIndex}" HorizontalAlignment="Left" AutomationProperties.Name="Make a new selection, add to it, or select within it">
        <ListBoxItem Content="New selection" />
        <ListBoxItem Content="Add to it" />
        <ListBoxItem Content="Select within it" />
      </ListBox>
    </StackPanel>
    <TextBlock Classes="medium" Text="{Binding CountText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <Border Classes="subtle" IsVisible="{Binding HasProblem}">
      <TextBlock Classes="issue required" Text="{Binding Problem}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
    </Border>
    <c:SheetFooter PrimaryText="Select" PrimaryCommand="{Binding SelectCommand}" />
  </StackPanel>
</UserControl>
