<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.QaBeforeExportSheetView"
             x:DataType="sh:QaBeforeExportSheetViewModel">
  <!-- Before an SDE export or a submission folder: open quality errors among the assessments. Exporting anyway is the
       action at the left; showing them on Review is the default. -->
  <StackPanel Spacing="16">
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    <Border Classes="card">
      <ItemsControl ItemsSource="{Binding Examples}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <Grid ColumnDefinitions="Auto,*" Margin="0,3">
              <c:Icon Kind="ErrorCircle" Size="14" Classes="danger" Margin="0,2,10,0" VerticalAlignment="Top" />
              <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
    <c:SheetFooter LeadingText="Export Anyway" LeadingCommand="{Binding ExportAnywayCommand}"
                   PrimaryText="Show Them on Review" PrimaryCommand="{Binding ShowOnReviewCommand}" />
  </StackPanel>
</UserControl>
