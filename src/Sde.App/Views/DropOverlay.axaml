<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sde.App.ViewModels"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.DropOverlay"
             x:DataType="vm:DropPlan"
             IsHitTestVisible="False">
  <!-- Over the whole window while files are dragged over it: a dashed accent edge and a card saying what a drop does.
       It never takes the pointer, so page drop zones under it still get their drops. -->
  <Border Classes="dropOverlay" Classes.refused="{Binding !CanDrop}" Name="DropOverlayRoot">
    <Panel>
      <Rectangle Classes="dropEdge" />
      <Border Classes="dropPanel">
        <StackPanel Spacing="10">
          <Border Classes="dropIcon" Margin="0,0,0,6">
            <c:Icon Kind="Import" />
          </Border>
          <TextBlock Classes="dropHeading" Text="{Binding Title}" Name="DropHeading" />
          <TextBlock Classes="dropLine" Text="{Binding Description}" Name="DropLine" />
        </StackPanel>
      </Border>
    </Panel>
  </Border>
</UserControl>
