<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sde.App.ViewModels"
             xmlns:v="using:Sde.App.Views"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <UserControl.Resources>
    <!-- One bar: the label, the bar and the numbers in words. The bar is decoration for people who can see it. -->
    <DataTemplate x:Key="BarRow" x:DataType="vm:BarRowViewModel">
      <Grid ColumnDefinitions="170,*,170" Margin="0,4" AutomationProperties.Name="{Binding SpokenName}">
        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <v:StackedBar Grid.Column="1" Height="12" Margin="10,0" Segments="{Binding Segments}" AutomationProperties.AccessibilityView="Raw" />
        <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="{StaticResource PagePadding}" Spacing="14">
      <!-- The title band says "Dashboard"; the header says what it covers and takes the event's name -->
      <c:PageHeader Margin="0" Subtitle="{Binding Subtitle}">
        <StackPanel Classes="field" Width="260" Margin="0" IsVisible="{Binding IsAllEvents}">
          <Panel Classes="fieldHead"><TextBlock Classes="fieldLabel" Text="Event name (optional)" /></Panel>
          <TextBox Text="{Binding EventName}" PlaceholderText="Shown on the summary" AutomationProperties.Name="Event name" />
        </StackPanel>
      </c:PageHeader>
      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasDates}" Margin="0,-8,0,0">
        <c:Icon Kind="Event" Size="14" Classes="tertiary" VerticalAlignment="Center" />
        <TextBlock Classes="secondary" Text="{Binding Dates}" VerticalAlignment="Center" />
      </StackPanel>

      <!-- The numbers: one grouped box of quiet stats, as in Activity Monitor's footer -->
      <Border Classes="card">
      <UniformGrid Columns="4">
        <StackPanel Spacing="1" Margin="0,0,12,0" AutomationProperties.Name="{Binding Structures, StringFormat='Structures: {0}'}">
            <TextBlock Classes="title num" Text="{Binding Structures}" />
            <TextBlock Classes="secondary sm" Text="Structures" />
            <TextBlock Classes="muted" Text="{Binding StructuresNote}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Spacing="1" Margin="0,0,12,0">
            <TextBlock Classes="title num" Text="{Binding SubstantialText}" Foreground="{DynamicResource StatusSubstantialFg}" />
            <TextBlock Classes="secondary sm" Text="Substantially damaged" />
            <TextBlock Classes="muted" Text="{Binding SubstantialNote}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Spacing="1" Margin="0,0,12,0">
            <TextBlock Classes="title num" Text="{Binding BuildingValue}" />
            <TextBlock Classes="secondary sm" Text="Building value" />
            <TextBlock Classes="muted" Text="Of assessed structures" />
        </StackPanel>
        <StackPanel Spacing="1" Margin="0,0,12,0">
            <TextBlock Classes="title num" Text="{Binding RepairCost}" />
            <TextBlock Classes="secondary sm" Text="Repair cost" />
            <TextBlock Classes="muted" Text="Of assessed structures" />
        </StackPanel>
      </UniformGrid>
      </Border>

      <!-- Compliance: shown once a case is open for a structure in scope -->
      <Border Classes="card" IsVisible="{Binding HasCompliance}">
      <UniformGrid Columns="4">
        <StackPanel Spacing="1" Margin="0,0,12,0" AutomationProperties.Name="{Binding ComplianceOpen, StringFormat='Open compliance cases: {0}'}">
            <TextBlock Classes="title num" Text="{Binding ComplianceOpen}" />
            <TextBlock Classes="secondary sm" Text="Open compliance cases" />
            <TextBlock Classes="muted" Text="{Binding ComplianceOpenNote}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Spacing="1" Margin="0,0,12,0" AutomationProperties.Name="{Binding ComplianceOverdue, StringFormat='Overdue compliance cases: {0}'}">
            <TextBlock Classes="title num" Text="{Binding ComplianceOverdue}" Classes.danger="{Binding HasOverdue}" />
            <TextBlock Classes="secondary sm" Text="Overdue" />
            <TextBlock Classes="muted" Text="Deadline passed, still open" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Spacing="1" Margin="0,0,12,0">
            <TextBlock Classes="title num" Text="{Binding IccInProgress}" />
            <TextBlock Classes="secondary sm" Text="ICC claims in progress" />
            <TextBlock Classes="muted" Text="Filed or approved, not paid" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Spacing="1" Margin="0,0,12,0">
            <TextBlock Classes="title num" Text="{Binding IccPaid}" />
            <TextBlock Classes="secondary sm" Text="ICC paid" />
            <TextBlock Classes="muted" Text="{Binding IccPaidNote}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </UniformGrid>
      </Border>

      <!-- Reports and GIS files -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Spacing="2">
            <TextBlock Classes="h3" Text="Share this event" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="GIS files: one point per assessed structure (WGS 84) with a QGIS style. Structures without coordinates are left out." />
          </StackPanel>
          <WrapPanel>
            <Button Classes="primary" Margin="0,0,8,6" Command="{Binding SummaryPdfCommand}" IsEnabled="{Binding HasAnything}" AutomationProperties.Name="Event summary PDF">
              <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="Pdf" Size="14" /><TextBlock Text="Event summary PDF…" /></StackPanel>
            </Button>
            <Button Margin="0,0,8,6" Command="{Binding GeoPackageCommand}" IsEnabled="{Binding HasAnything}" AutomationProperties.Name="GeoPackage for GIS">
              <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="Layers" Size="14" /><TextBlock Text="GeoPackage for GIS…" /></StackPanel>
            </Button>
            <Button Margin="0,0,8,6" Command="{Binding GeoJsonCommand}" IsEnabled="{Binding HasAnything}" AutomationProperties.Name="GeoJSON">
              <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="Export" Size="14" /><TextBlock Text="GeoJSON…" /></StackPanel>
            </Button>
          </WrapPanel>
          <CheckBox IsChecked="{Binding IncludeOwnerNames}" Content="Include owner names" AutomationProperties.Name="Include owner names in the GIS files" />
          <c:Banner Tone="Warning" IsVisible="{Binding IncludeOwnerNames}" Text="{Binding OwnerWarning}" />
          <TextBlock Text="{Binding LastResult}" IsVisible="{Binding HasResult}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding !HasAnything}">
        <c:EmptyState Title="No Structures" />
      </Border>

      <!-- Bars -->
      <StackPanel Spacing="14" IsVisible="{Binding HasAnything}">
        <Grid ColumnDefinitions="*,*">
          <Border Classes="card" Margin="0,0,7,0">
            <StackPanel Spacing="8">
              <TextBlock Classes="h3" Text="Results" />
              <ItemsControl ItemsSource="{Binding ByResult}" ItemTemplate="{StaticResource BarRow}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card" Margin="7,0,0,0">
            <StackPanel Spacing="8">
              <TextBlock Classes="h3" Text="{Binding ProgressTitle}" />
              <ItemsControl ItemsSource="{Binding Progress}" ItemTemplate="{StaticResource BarRow}" />
            </StackPanel>
          </Border>
        </Grid>
        <Border Classes="card" IsVisible="{Binding HasTeams}">
          <StackPanel Spacing="8">
            <TextBlock Classes="h3" Text="Field teams" />
            <TextBlock Classes="muted" Text="Structures per team, and how many are assessed since assigned." TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding ByTeam}" ItemTemplate="{StaticResource BarRow}" />
          </StackPanel>
        </Border>
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="h3" Text="Streets with the most assessments (top 10)" />
            <ItemsControl ItemsSource="{Binding ByStreet}" ItemTemplate="{StaticResource BarRow}" />
          </StackPanel>
        </Border>
        <Grid ColumnDefinitions="*,*">
          <Border Classes="card" Margin="0,0,7,0">
            <StackPanel Spacing="8">
              <TextBlock Classes="h3" Text="By community" />
              <ItemsControl ItemsSource="{Binding ByCommunity}" ItemTemplate="{StaticResource BarRow}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card" Margin="7,0,0,0">
            <StackPanel Spacing="8">
              <TextBlock Classes="h3" Text="By inspector" />
              <ItemsControl ItemsSource="{Binding ByInspector}" ItemTemplate="{StaticResource BarRow}" />
            </StackPanel>
          </Border>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="16" Margin="2,0">
          <TextBlock Classes="muted" Text="Bars are split by result:" />
          <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="10" Height="10" Fill="{DynamicResource StatusSubstantialFg}" /><TextBlock Classes="muted" Text="Substantial" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="10" Height="10" Fill="{DynamicResource StatusCloseFg}" /><TextBlock Classes="muted" Text="Close" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="10" Height="10" Fill="{DynamicResource StatusNotSubstantialFg}" /><TextBlock Classes="muted" Text="Not substantial" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="10" Height="10" Fill="{DynamicResource StatusIncompleteFg}" /><TextBlock Classes="muted" Text="Incomplete or undetermined" /></StackPanel>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
