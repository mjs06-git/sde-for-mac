<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sde.App.ViewModels"
             xmlns:v="using:Sde.App.Views"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <UserControl.Resources>
    <!-- One bar: the label, the bar and the numbers in words. The bar is decoration for people who can see it. The label
         and number columns are shared by the rows of one chart, so its bars start and end together. -->
    <DataTemplate x:Key="BarRow" x:DataType="vm:BarRowViewModel">
      <Grid Margin="0,3" AutomationProperties.Name="{Binding SpokenName}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="BarLabel" />
          <ColumnDefinition Width="*" MinWidth="60" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="BarDetail" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label}" MaxWidth="200" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <v:StackedBar Grid.Column="1" Height="10" Segments="{Binding Segments}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
        <TextBlock Grid.Column="2" Classes="secondary num" Text="{Binding Detail}" Margin="12,0,0,0" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- The label of a row in the page's lists (Event summary, Compliance); the list shares the label column -->
    <Style Selector="TextBlock.summaryLabel">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="Margin" Value="0,0,24,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <!-- In the window's toolbar: the exports -->
  <v:PageChrome.Toolbar>
    <StackPanel Classes="pageToolbar">
      <DropDownButton Content="Export" IsEnabled="{Binding HasAnything}" AutomationProperties.Name="Export"
                      ToolTip.Tip="The event summary PDF and files for GIS">
        <DropDownButton.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuItem Header="Event Summary PDF…" Command="{Binding SummaryPdfCommand}" />
            <Separator />
            <MenuItem Header="GeoPackage…" Command="{Binding GeoPackageCommand}"
                      ToolTip.Tip="One point per assessed structure (WGS 84), with a QGIS style. Structures without coordinates are left out." />
            <MenuItem Header="GeoJSON…" Command="{Binding GeoJsonCommand}"
                      ToolTip.Tip="One point per assessed structure (WGS 84), with a QGIS style. Structures without coordinates are left out." />
            <MenuItem Header="Include Owner Names" ToggleType="CheckBox" IsChecked="{Binding IncludeOwnerNames, Mode=TwoWay}"
                      ToolTip.Tip="In the GeoPackage and GeoJSON files" />
          </MenuFlyout>
        </DropDownButton.Flyout>
      </DropDownButton>
    </StackPanel>
  </v:PageChrome.Toolbar>

  <Panel>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasAnything}">
      <StackPanel Margin="{StaticResource PagePadding}" Spacing="20">
        <!-- What the last export did, and the warning while owner names are going into the GIS files -->
        <StackPanel Spacing="8">
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.Or}">
              <Binding Path="IncludeOwnerNames" />
              <Binding Path="HasResult" />
            </MultiBinding>
          </StackPanel.IsVisible>
          <c:Banner Tone="Warning" IsVisible="{Binding IncludeOwnerNames}" Text="{Binding OwnerWarning}" />
          <TextBlock Classes="secondary" Text="{Binding LastResult}" IsVisible="{Binding HasResult}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <!-- The headline band: how many are substantially damaged, the share on a big gauge, and the money and the share
             assessed beside it, all in one dark band -->
        <Border Classes="heroBand" Name="Headline">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="28">
            <StackPanel Spacing="20" VerticalAlignment="Center">
              <TextBlock Classes="heroHeadline" Text="{Binding HeadlineText}" ToolTip.Tip="{Binding SubstantialNote}" />
              <c:StaffGauge Value="{Binding SubstantialShare}" IsEmpty="{Binding !HasAssessments}" ShowMark="False" WaterKey="GaugeDanger"
                            OnDark="True" ShowLabels="True" TrackThickness="16" MinWidth="240" Name="ShareGauge" />
            </StackPanel>
            <Border Grid.Column="1" Classes="heroFigures" VerticalAlignment="Center">
              <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="28">
                <StackPanel Spacing="4" ToolTip.Tip="Of the assessed structures">
                  <TextBlock Classes="heroLabel" Text="Building value" />
                  <TextBlock Classes="heroFigure" Text="{Binding BuildingValue}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4" ToolTip.Tip="Of the assessed structures">
                  <TextBlock Classes="heroLabel" Text="Repair cost" />
                  <TextBlock Classes="heroFigure" Text="{Binding RepairCost}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4" ToolTip.Tip="{Binding StructuresNote}">
                  <TextBlock Classes="heroLabel" Text="Assessed" />
                  <TextBlock Classes="heroFigure" Text="{Binding AssessedShareText}" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <!-- The cards, two to a row: the two charts first, then the counts -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="20" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="20">
          <Border Classes="sheetBlock" Name="DistributionCard">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="sheetTitle" Text="Damage distribution" ToolTip.Tip="Assessments with a result, by percent damaged in 10-point bands" />
                <TextBlock Grid.Column="1" Classes="chartNote" Text="{Binding DistributionNote}" />
              </Grid>
              <v:DamageHistogram Classes="chart" Bins="{Binding DamageBins}" Threshold="{Binding SubstantialLine}" IsVisible="{Binding HasDistribution}" Name="Distribution" />
              <TextBlock Classes="muted" Text="No results yet" IsVisible="{Binding !HasDistribution}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="sheetBlock" Name="ProgressCard">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="sheetTitle" Text="Progress over time" ToolTip.Tip="Completed assessments by inspection date" />
                <TextBlock Grid.Column="1" Classes="chartNote" Text="{Binding ProgressNote}" />
              </Grid>
              <v:ProgressChart Classes="chart" Points="{Binding ProgressSeries}" IsVisible="{Binding HasProgressSeries}" Name="ProgressOverTime" />
              <TextBlock Classes="muted" Text="No inspection dates yet" IsVisible="{Binding !HasProgressSeries}" />
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Grid.Column="1" Classes="sheetBlock">
            <StackPanel>
              <TextBlock Classes="sheetTitle" Text="Event summary" ToolTip.Tip="{Binding Subtitle}" />
              <StackPanel Spacing="8" Grid.IsSharedSizeScope="True">
                <Grid IsVisible="{Binding IsAllEvents}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="SummaryLabel" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Classes="summaryLabel" Text="Event name" />
                  <TextBox Grid.Column="1" Text="{Binding EventName}" PlaceholderText="Optional" Width="240" HorizontalAlignment="Left"
                           AutomationProperties.Name="Event name" ToolTip.Tip="Printed on the event summary and used as the GIS layer's title" />
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="SummaryLabel" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Classes="summaryLabel" Text="Structures" />
                  <TextBlock Grid.Column="1" Classes="num" Text="{Binding Structures}" ToolTip.Tip="{Binding StructuresNote}"
                             AutomationProperties.Name="{Binding Structures, StringFormat='Structures: {0}'}" />
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="SummaryLabel" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Classes="summaryLabel" Text="Substantially damaged" />
                  <TextBlock Grid.Column="1" Classes="num medium" Text="{Binding SubstantialText}" Foreground="{DynamicResource StatusSubstantialFg}"
                             ToolTip.Tip="{Binding SubstantialNote}" AutomationProperties.Name="{Binding SubstantialText, StringFormat='Substantially damaged: {0}'}" />
                </Grid>
                <Grid IsVisible="{Binding DamageDates, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="SummaryLabel" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Classes="summaryLabel" Text="Damage occurred" />
                  <TextBlock Grid.Column="1" Classes="num" Text="{Binding DamageDates}" />
                </Grid>
                <Grid IsVisible="{Binding InspectionDates, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="SummaryLabel" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Classes="summaryLabel" Text="Inspected" />
                  <TextBlock Grid.Column="1" Classes="num" Text="{Binding InspectionDates}" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Classes="sheetBlock">
            <StackPanel>
              <TextBlock Classes="sheetTitle" Text="Results" />
              <ItemsControl ItemsSource="{Binding ByResult}" ItemTemplate="{StaticResource BarRow}" Grid.IsSharedSizeScope="True" />
            </StackPanel>
          </Border>

          <Border Grid.Row="2" Classes="sheetBlock">
            <StackPanel>
              <TextBlock Classes="sheetTitle" Text="{Binding ProgressTitle}" />
              <ItemsControl ItemsSource="{Binding Progress}" ItemTemplate="{StaticResource BarRow}" Grid.IsSharedSizeScope="True" />
            </StackPanel>
          </Border>
          <Border Grid.Row="2" Grid.Column="1" Classes="sheetBlock">
            <StackPanel>
              <TextBlock Classes="sheetTitle" Text="Inspectors" />
              <ItemsControl ItemsSource="{Binding ByInspector}" ItemTemplate="{StaticResource BarRow}" Grid.IsSharedSizeScope="True" />
            </StackPanel>
          </Border>

          <Border Grid.Row="3" Classes="sheetBlock">
            <StackPanel>
              <TextBlock Classes="sheetTitle" Text="Streets" ToolTip.Tip="The 10 streets with the most assessments" />
              <ItemsControl ItemsSource="{Binding ByStreet}" ItemTemplate="{StaticResource BarRow}" Grid.IsSharedSizeScope="True" />
            </StackPanel>
          </Border>
          <Border Grid.Row="3" Grid.Column="1" Classes="sheetBlock">
            <StackPanel>
              <TextBlock Classes="sheetTitle" Text="Communities" />
              <ItemsControl ItemsSource="{Binding ByCommunity}" ItemTemplate="{StaticResource BarRow}" Grid.IsSharedSizeScope="True" />
            </StackPanel>
          </Border>

          <!-- Field teams and compliance, once there are any -->
          <Border Grid.Row="4" Classes="sheetBlock" IsVisible="{Binding HasTeams}">
            <StackPanel>
              <TextBlock Classes="sheetTitle" Text="Field teams" ToolTip.Tip="Structures per team, and how many are assessed since they were assigned" />
              <ItemsControl ItemsSource="{Binding ByTeam}" ItemTemplate="{StaticResource BarRow}" Grid.IsSharedSizeScope="True" />
            </StackPanel>
          </Border>
          <Border Grid.Row="4" Grid.Column="1" Classes="sheetBlock" IsVisible="{Binding HasCompliance}">
            <StackPanel>
              <TextBlock Classes="sheetTitle" Text="Compliance" />
              <StackPanel Spacing="8" Grid.IsSharedSizeScope="True">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="ComplianceLabel" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Classes="summaryLabel" Text="Open cases" />
                  <TextBlock Grid.Column="1" Classes="num" Text="{Binding ComplianceOpen}" ToolTip.Tip="{Binding ComplianceOpenNote}"
                             AutomationProperties.Name="{Binding ComplianceOpen, StringFormat='Open compliance cases: {0}'}" />
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="ComplianceLabel" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Classes="summaryLabel" Text="Overdue" />
                  <TextBlock Grid.Column="1" Classes="num" Text="{Binding ComplianceOverdue}" ToolTip.Tip="Deadline passed, still open"
                             AutomationProperties.Name="{Binding ComplianceOverdue, StringFormat='Overdue compliance cases: {0}'}" />
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="ComplianceLabel" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Classes="summaryLabel" Text="ICC claims in progress" />
                  <TextBlock Grid.Column="1" Classes="num" Text="{Binding IccInProgress}" ToolTip.Tip="Filed or approved, not paid" />
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="ComplianceLabel" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Classes="summaryLabel" Text="ICC paid" />
                  <TextBlock Grid.Column="1" Classes="num" Text="{Binding IccPaid}" ToolTip.Tip="{Binding IccPaidNote}" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <!-- What the bar colours mean -->
        <StackPanel Orientation="Horizontal" Spacing="16" Margin="4,0,0,0" ToolTip.Tip="Bars are split by result">
          <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="8" Height="8" Fill="{DynamicResource StatusSubstantialDot}" VerticalAlignment="Center" /><TextBlock Classes="muted" Text="Substantial" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="8" Height="8" Fill="{DynamicResource StatusCloseDot}" VerticalAlignment="Center" /><TextBlock Classes="muted" Text="Near threshold" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="8" Height="8" Fill="{DynamicResource StatusNotSubstantialDot}" VerticalAlignment="Center" /><TextBlock Classes="muted" Text="Not substantial" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="8" Height="8" Fill="{DynamicResource StatusIncompleteDot}" VerticalAlignment="Center" /><TextBlock Classes="muted" Text="Incomplete or undetermined" /></StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <c:EmptyState IsVisible="{Binding !HasAnything}" Title="No Structures" />
  </Panel>
</UserControl>
