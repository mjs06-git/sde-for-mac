<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The friendly Mac app (Avalonia 12, MIT). Replaces FEMA's WPF screens (wpfSDE.exe), which depended on
    Windows-only, commercial DevExpress/Telerik/Xceed controls.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Sde.App</RootNamespace>
    <AssemblyName>SDE</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon />
    <Version>3.5.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sde.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <!-- Public Sans, the app's typeface: one copy of the files, shared with the PDF reports (SIL OFL 1.1) -->
    <AvaloniaResource Include="../Sde.Reports/Fonts/*.ttf" Link="Assets/Fonts/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Help/field-help.json" LogicalName="field-help.json" />
    <!-- Embedded MapLibre GL JS assets for the native macOS WKWebView map (BSD-3-Clause, offline-ready) -->
    <EmbeddedResource Include="Maps/Web/*" LogicalName="Sde.App.Maps.Web.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../Sde.Reports/Fonts/PublicSans-Regular.ttf;../Sde.Reports/Fonts/PublicSans-SemiBold.ttf"
                      Link="Maps/Web/fonts/%(Filename)%(Extension)" LogicalName="Sde.App.Maps.Web.fonts.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Mapsui.Avalonia12" />
    <PackageReference Include="Mapsui.Nts" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <Import Project="LeaveOutSvg.props" />

  <ItemGroup>
    <ProjectReference Include="../Sde.Data/Sde.Data.csproj" />
    <ProjectReference Include="../Sde.Gis/Sde.Gis.csproj" />
    <ProjectReference Include="../Sde.Reports/Sde.Reports.csproj" />
    <ProjectReference Include="../Sde.Interop/Sde.Interop.csproj" />
    <ProjectReference Include="../Sde.Field/Sde.Field.csproj" />
    <ProjectReference Include="../Sde.Mcp/Sde.Mcp.csproj" />
  </ItemGroup>

</Project>
