      <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="Transparent" />
      <SolidColorBrush x:Key="ComboBoxItemBackground" Color="Transparent" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <!-- Colours (the brushes below use these) -->
      <Color x:Key="BgAppColor">#0F1A29</Color>
      <Color x:Key="BgSidebarColor">#132030</Color>
      <Color x:Key="BgSurfaceColor">#172536</Color>
      <Color x:Key="BgSubtleColor">#1A2A3D</Color>
      <Color x:Key="BgInspectorColor">#142131</Color>
      <Color x:Key="BgHoverColor">#203247</Color>
      <Color x:Key="BgPressedColor">#2A3F58</Color>
      <Color x:Key="BgOverlayColor">#99000000</Color>
      <Color x:Key="BgTooltipColor">#33475F</Color>
      <Color x:Key="BorderDefaultColor">#26374B</Color>
      <Color x:Key="BorderStrongColor">#41546C</Color>
      <Color x:Key="BorderStrongHoverColor">#53687F</Color>
      <Color x:Key="BorderSubtleColor">#1E2D3F</Color>
      <Color x:Key="TextPrimaryColor">#EAF0F6</Color>
      <Color x:Key="TextSecondaryColor">#A9B6C6</Color>
      <Color x:Key="TextTertiaryColor">#98A6B8</Color>
      <Color x:Key="TextDisabledColor">#56667B</Color>
      <Color x:Key="TextOnTooltipColor">#FFFFFF</Color>
      <Color x:Key="AccentColor">#6DB5F5</Color>
      <Color x:Key="AccentHoverColor">#8CC6F8</Color>
      <Color x:Key="AccentPressedColor">#58A5E8</Color>
      <Color x:Key="AccentFillColor">#1B6CC2</Color>
      <Color x:Key="AccentFillHoverColor">#185FAC</Color>
      <Color x:Key="AccentFillPressedColor">#155397</Color>
      <Color x:Key="AccentSoftColor">#173556</Color>
      <Color x:Key="AccentSoftHoverColor">#1D4168</Color>
      <Color x:Key="OnAccentColor">#FFFFFF</Color>
      <Color x:Key="FocusColor">#6DB5F5</Color>
      <Color x:Key="DangerFgColor">#FF7C88</Color>
      <Color x:Key="DangerBgColor">#40202A</Color>
      <Color x:Key="DangerFillColor">#C8102E</Color>
      <Color x:Key="DangerFillHoverColor">#AE0E28</Color>
      <Color x:Key="DangerFillPressedColor">#950C22</Color>
      <Color x:Key="WarningFgColor">#F5B45C</Color>
      <Color x:Key="WarningBgColor">#3A2E1C</Color>
      <Color x:Key="SuccessFgColor">#6BD08A</Color>
      <Color x:Key="SuccessBgColor">#1A3326</Color>
      <Color x:Key="InfoFgColor">#7DBBF0</Color>
      <Color x:Key="InfoBgColor">#1A2F47</Color>
      <Color x:Key="VioletFgColor">#C6B5FF</Color>
      <Color x:Key="VioletBgColor">#2E2A48</Color>
      <Color x:Key="NeutralFgColor">#A9B6C6</Color>
      <Color x:Key="NeutralBgColor">#2A3A4E</Color>
      <Color x:Key="ScrollThumbColor">#4B5D73</Color>
      <!-- The frame (3.5): the sidebar and title band are navy in both themes, with their own text colours -->
      <Color x:Key="BgFrameColor">#0A1A2E</Color>
      <Color x:Key="BgFrameHoverColor">#152943</Color>
      <Color x:Key="BgFramePressedColor">#1D3555</Color>
      <Color x:Key="BgFrameFieldColor">#14273F</Color>
      <Color x:Key="BorderFrameColor">#22395A</Color>
      <Color x:Key="TextOnFrameColor">#FFFFFF</Color>
      <Color x:Key="TextOnFrameSecondaryColor">#BCCADB</Color>
      <Color x:Key="TextOnFrameTertiaryColor">#9DAFC5</Color>
      <Color x:Key="AccentOnFrameColor">#7FBDF7</Color>
      <Color x:Key="DangerOnFrameColor">#FF8F99</Color>
      <Color x:Key="BgHeroColor">#15365C</Color>
      <Color x:Key="TextOnHeroColor">#FFFFFF</Color>
      <Color x:Key="TextOnHeroSecondaryColor">#C3D1E2</Color>
      <Color x:Key="BgFrameSelectedColor">#25466C</Color>
      <Color x:Key="BorderCardColor">#24354A</Color>
      <Color x:Key="BgTableHeaderColor">#1B2A3C</Color>
      <!-- Backgrounds -->
      <SolidColorBrush x:Key="BgApp" Color="{StaticResource BgAppColor}" /> <!-- the content area behind cards -->
      <SolidColorBrush x:Key="BgSidebar" Color="{StaticResource BgSidebarColor}" /> <!-- the sidebar and side panels -->
      <SolidColorBrush x:Key="BgSurface" Color="{StaticResource BgSurfaceColor}" /> <!-- cards, sheets, inputs, menus -->
      <SolidColorBrush x:Key="BgSubtle" Color="{StaticResource BgSubtleColor}" /> <!-- insets and secondary areas inside a card -->
      <SolidColorBrush x:Key="BgInspector" Color="{StaticResource BgInspectorColor}" /> <!-- the inspector pane at the right of a page -->
      <SolidColorBrush x:Key="BgHover" Color="{StaticResource BgHoverColor}" /> <!-- a row or ghost button under the pointer -->
      <SolidColorBrush x:Key="BgPressed" Color="{StaticResource BgPressedColor}" /> <!-- a row or button being pressed -->
      <SolidColorBrush x:Key="BgOverlay" Color="{StaticResource BgOverlayColor}" /> <!-- the scrim behind a sheet -->
      <SolidColorBrush x:Key="BgTooltip" Color="{StaticResource BgTooltipColor}" /> <!-- tooltips -->
      <!-- Borders -->
      <SolidColorBrush x:Key="BorderDefault" Color="{StaticResource BorderDefaultColor}" /> <!-- cards and dividers -->
      <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource BorderStrongColor}" /> <!-- inputs and default buttons -->
      <SolidColorBrush x:Key="BorderStrongHover" Color="{StaticResource BorderStrongHoverColor}" /> <!-- an input under the pointer -->
      <SolidColorBrush x:Key="BorderSubtle" Color="{StaticResource BorderSubtleColor}" /> <!-- row separators -->
      <!-- Text -->
      <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" /> <!-- body text -->
      <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" /> <!-- supporting text -->
      <SolidColorBrush x:Key="TextTertiary" Color="{StaticResource TextTertiaryColor}" /> <!-- captions, hints, placeholders (still 4.5:1) -->
      <SolidColorBrush x:Key="TextDisabled" Color="{StaticResource TextDisabledColor}" /> <!-- disabled text (no contrast requirement) -->
      <SolidColorBrush x:Key="TextOnTooltip" Color="{StaticResource TextOnTooltipColor}" /> <!-- text on BgTooltip -->
      <!-- Accent -->
      <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" /> <!-- accent text, links and icons -->
      <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" /> <!-- accent text under the pointer -->
      <SolidColorBrush x:Key="AccentPressed" Color="{StaticResource AccentPressedColor}" /> <!-- accent text pressed -->
      <SolidColorBrush x:Key="AccentFill" Color="{StaticResource AccentFillColor}" /> <!-- accent button background -->
      <SolidColorBrush x:Key="AccentFillHover" Color="{StaticResource AccentFillHoverColor}" /> <!-- accent button under the pointer -->
      <SolidColorBrush x:Key="AccentFillPressed" Color="{StaticResource AccentFillPressedColor}" /> <!-- accent button pressed -->
      <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentSoftColor}" /> <!-- selected rows and the active sidebar item -->
      <SolidColorBrush x:Key="AccentSoftHover" Color="{StaticResource AccentSoftHoverColor}" /> <!-- a selected row under the pointer -->
      <SolidColorBrush x:Key="OnAccent" Color="{StaticResource OnAccentColor}" /> <!-- text and icons on AccentFill or DangerFill -->
      <SolidColorBrush x:Key="Focus" Color="{StaticResource FocusColor}" /> <!-- focus rings -->
      <!-- Status -->
      <SolidColorBrush x:Key="DangerFg" Color="{StaticResource DangerFgColor}" /> <!-- errors, destructive text -->
      <SolidColorBrush x:Key="DangerBg" Color="{StaticResource DangerBgColor}" /> <!-- error banners and badges -->
      <SolidColorBrush x:Key="DangerFill" Color="{StaticResource DangerFillColor}" /> <!-- destructive button background -->
      <SolidColorBrush x:Key="DangerFillHover" Color="{StaticResource DangerFillHoverColor}" />
      <SolidColorBrush x:Key="DangerFillPressed" Color="{StaticResource DangerFillPressedColor}" />
      <SolidColorBrush x:Key="WarningFg" Color="{StaticResource WarningFgColor}" />
      <SolidColorBrush x:Key="WarningBg" Color="{StaticResource WarningBgColor}" />
      <SolidColorBrush x:Key="SuccessFg" Color="{StaticResource SuccessFgColor}" />
      <SolidColorBrush x:Key="SuccessBg" Color="{StaticResource SuccessBgColor}" />
      <SolidColorBrush x:Key="InfoFg" Color="{StaticResource InfoFgColor}" />
      <SolidColorBrush x:Key="InfoBg" Color="{StaticResource InfoBgColor}" />
      <SolidColorBrush x:Key="VioletFg" Color="{StaticResource VioletFgColor}" /> <!-- a fifth status hue (undetermined) -->
      <SolidColorBrush x:Key="VioletBg" Color="{StaticResource VioletBgColor}" />
      <SolidColorBrush x:Key="NeutralFg" Color="{StaticResource NeutralFgColor}" /> <!-- neutral badges -->
      <SolidColorBrush x:Key="NeutralBg" Color="{StaticResource NeutralBgColor}" />
      <SolidColorBrush x:Key="ScrollThumb" Color="{StaticResource ScrollThumbColor}" /> <!-- scroll bar thumbs -->
      <SolidColorBrush x:Key="BgFrame" Color="{StaticResource BgFrameColor}" /> <!-- the navy frame: the sidebar and the title band -->
      <SolidColorBrush x:Key="BgFrameHover" Color="{StaticResource BgFrameHoverColor}" /> <!-- a row or button on the frame under the pointer -->
      <SolidColorBrush x:Key="BgFramePressed" Color="{StaticResource BgFramePressedColor}" /> <!-- a row or button on the frame being pressed -->
      <SolidColorBrush x:Key="BgFrameField" Color="{StaticResource BgFrameFieldColor}" /> <!-- the search field and other inputs on the frame -->
      <SolidColorBrush x:Key="BorderFrame" Color="{StaticResource BorderFrameColor}" /> <!-- dividers and input borders on the frame -->
      <SolidColorBrush x:Key="TextOnFrame" Color="{StaticResource TextOnFrameColor}" /> <!-- titles and selected rows on the frame -->
      <SolidColorBrush x:Key="TextOnFrameSecondary" Color="{StaticResource TextOnFrameSecondaryColor}" /> <!-- rows and labels on the frame -->
      <SolidColorBrush x:Key="TextOnFrameTertiary" Color="{StaticResource TextOnFrameTertiaryColor}" /> <!-- section labels, counts and placeholders on the frame -->
      <SolidColorBrush x:Key="AccentOnFrame" Color="{StaticResource AccentOnFrameColor}" /> <!-- the brand mark and links on the frame -->
      <SolidColorBrush x:Key="DangerOnFrame" Color="{StaticResource DangerOnFrameColor}" /> <!-- required-problem counts on the frame -->
      <SolidColorBrush x:Key="BgHero" Color="{StaticResource BgHeroColor}" /> <!-- the result panel, the one dark card inside the content area -->
      <SolidColorBrush x:Key="TextOnHero" Color="{StaticResource TextOnHeroColor}" /> <!-- the figure on the result panel -->
      <SolidColorBrush x:Key="TextOnHeroSecondary" Color="{StaticResource TextOnHeroSecondaryColor}" /> <!-- supporting text on the result panel -->
      <SolidColorBrush x:Key="BgFrameSelected" Color="{StaticResource BgFrameSelectedColor}" /> <!-- the chosen segment of a switch on the frame -->
      <SolidColorBrush x:Key="BorderCard" Color="{StaticResource BorderCardColor}" /> <!-- the hairline round a white card (with ShadowCard under it) -->
      <SolidColorBrush x:Key="BgTableHeader" Color="{StaticResource BgTableHeaderColor}" /> <!-- a table's header row -->
      <!-- Older names, kept because code and views look them up by name -->
      <SolidColorBrush x:Key="WindowBg" Color="{StaticResource BgAppColor}" />
      <SolidColorBrush x:Key="SidebarBg" Color="{StaticResource BgSidebarColor}" />
      <SolidColorBrush x:Key="CardBg" Color="{StaticResource BgSurfaceColor}" />
      <SolidColorBrush x:Key="CardBorder" Color="{StaticResource BorderDefaultColor}" />
      <SolidColorBrush x:Key="SubtleBg" Color="{StaticResource BgSubtleColor}" />
      <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextTertiaryColor}" />
      <SolidColorBrush x:Key="SelectedRow" Color="{StaticResource AccentSoftColor}" />
      <SolidColorBrush x:Key="StatusSubstantialFg" Color="{StaticResource DangerFgColor}" />
      <SolidColorBrush x:Key="StatusSubstantialBg" Color="{StaticResource DangerBgColor}" />
      <SolidColorBrush x:Key="StatusCloseFg" Color="{StaticResource WarningFgColor}" />
      <SolidColorBrush x:Key="StatusCloseBg" Color="{StaticResource WarningBgColor}" />
      <SolidColorBrush x:Key="StatusNotSubstantialFg" Color="{StaticResource SuccessFgColor}" />
      <SolidColorBrush x:Key="StatusNotSubstantialBg" Color="{StaticResource SuccessBgColor}" />
      <SolidColorBrush x:Key="StatusIncompleteFg" Color="{StaticResource NeutralFgColor}" />
      <SolidColorBrush x:Key="StatusIncompleteBg" Color="{StaticResource NeutralBgColor}" />
      <SolidColorBrush x:Key="StatusUndeterminedFg" Color="{StaticResource VioletFgColor}" />
      <SolidColorBrush x:Key="StatusUndeterminedBg" Color="{StaticResource VioletBgColor}" />
      <SolidColorBrush x:Key="StatusSubstantialDot" Color="#FF5A6B" />
      <SolidColorBrush x:Key="StatusCloseDot" Color="#F5A53B" />
      <SolidColorBrush x:Key="StatusNotSubstantialDot" Color="#45C877" />
      <SolidColorBrush x:Key="StatusIncompleteDot" Color="#8C99AA" />
      <SolidColorBrush x:Key="StatusUndeterminedDot" Color="#B592F5" />
      <SolidColorBrush x:Key="RequiredFg" Color="{StaticResource DangerFgColor}" />
      <SolidColorBrush x:Key="RecommendedFg" Color="{StaticResource WarningFgColor}" />
      <SolidColorBrush x:Key="SuggestedFg" Color="{StaticResource SuccessFgColor}" />
      <!-- Focus halo around inputs and the focused-control ring -->
      <BoxShadows x:Key="FocusHalo">0 0 0 3 #806DB5F5</BoxShadows>
      <BoxShadows x:Key="ShadowPopup">0 6 20 0 #66000000</BoxShadows>
      <BoxShadows x:Key="ShadowSheet">0 10 30 0 #8C000000</BoxShadows>
      <BoxShadows x:Key="ShadowCard">0 1 2 0 #33000000, 0 8 22 -8 #59000000</BoxShadows>
      <BoxShadows x:Key="ShadowHero">0 2 4 0 #40000000, 0 14 32 -10 #80000000</BoxShadows>
      <BoxShadows x:Key="ShadowControl">0 0.5 1 0 #59000000</BoxShadows>
      <SolidColorBrush x:Key="GaugeTrack" Color="#26374B" />
      <SolidColorBrush x:Key="GaugeTick" Color="#61728A" />
      <SolidColorBrush x:Key="GaugeWater" Color="#4A93D6" />
      <SolidColorBrush x:Key="GaugeNear" Color="#F0A23A" />
      <SolidColorBrush x:Key="GaugeDanger" Color="#FF5A6B" />
      <SolidColorBrush x:Key="GaugeMark" Color="#FF5A6B" />
      <SolidColorBrush x:Key="GaugeMarkHalo" Color="#172536" />
      <SolidColorBrush x:Key="GaugeTrackOnDark" Color="#30557F" />
      <SolidColorBrush x:Key="GaugeTickOnDark" Color="#8AA0BC" />
      <SolidColorBrush x:Key="GaugeWaterOnDark" Color="#5AAEFF" />
      <SolidColorBrush x:Key="GaugeNearOnDark" Color="#F5B04A" />
      <SolidColorBrush x:Key="GaugeDangerOnDark" Color="#FF5A6E" />
      <SolidColorBrush x:Key="GaugeMarkOnDark" Color="#FF5A6E" />
      <SolidColorBrush x:Key="GaugeMarkHaloOnDark" Color="{StaticResource BgHeroColor}" />
      <SolidColorBrush x:Key="ChartGrid" Color="#24354A" />
      <SolidColorBrush x:Key="ChartLine" Color="#5AAEFF" />
      <LinearGradientBrush x:Key="ChartArea" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#665AAEFF" />
        <GradientStop Offset="1" Color="#085AAEFF" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="RowSelectedFill" StartPoint="0,0" EndPoint="4,0">
        <GradientStop Offset="0" Color="{StaticResource AccentColor}" />
        <GradientStop Offset="0.75" Color="{StaticResource AccentColor}" />
        <GradientStop Offset="0.75" Color="{StaticResource AccentSoftColor}" />
        <GradientStop Offset="1" Color="{StaticResource AccentSoftColor}" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="RowSelectedHoverFill" StartPoint="0,0" EndPoint="4,0">
        <GradientStop Offset="0" Color="{StaticResource AccentColor}" />
        <GradientStop Offset="0.75" Color="{StaticResource AccentColor}" />
        <GradientStop Offset="0.75" Color="{StaticResource AccentSoftHoverColor}" />
        <GradientStop Offset="1" Color="{StaticResource AccentSoftHoverColor}" />
      </LinearGradientBrush>
