      <SolidColorBrush x:Key="BgSidebar" Color="{StaticResource BgSidebarColor}" /> <!-- the sidebar and side panels -->
      <SolidColorBrush x:Key="BgSurface" Color="{StaticResource BgSurfaceColor}" /> <!-- cards, sheets, inputs, menus -->
      <SolidColorBrush x:Key="BgSubtle" Color="{StaticResource BgSubtleColor}" /> <!-- insets and secondary areas inside a card -->
      <SolidColorBrush x:Key="BgInspector" Color="{StaticResource BgInspectorColor}" /> <!-- the inspector pane at the right of a page -->
      <SolidColorBrush x:Key="BgHover" Color="{StaticResource BgHoverColor}" /> <!-- a row or ghost button under the pointer -->
      <SolidColorBrush x:Key="BgPressed" Color="{StaticResource BgPressedColor}" /> <!-- a row or button being pressed -->
      <SolidColorBrush x:Key="BgOverlay" Color="{StaticResource BgOverlayColor}" /> <!-- the scrim behind a sheet -->
      <SolidColorBrush x:Key="BgTooltip" Color="{StaticResource BgTooltipColor}" /> <!-- tooltips -->
      <!-- Borders -->
      <SolidColorBrush x:Key="BorderDefault" Color="{StaticResource BorderDefaultColor}" /> <!-- cards and dividers -->
      <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource BorderStrongColor}" /> <!-- inputs and default buttons -->
      <SolidColorBrush x:Key="BorderStrongHover" Color="{StaticResource BorderStrongHoverColor}" /> <!-- an input under the pointer -->
      <SolidColorBrush x:Key="BorderSubtle" Color="{StaticResource BorderSubtleColor}" /> <!-- row separators -->
      <!-- Text -->
      <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" /> <!-- body text -->
      <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" /> <!-- supporting text -->
      <SolidColorBrush x:Key="TextTertiary" Color="{StaticResource TextTertiaryColor}" /> <!-- captions, hints, placeholders (still 4.5:1) -->
      <SolidColorBrush x:Key="TextDisabled" Color="{StaticResource TextDisabledColor}" /> <!-- disabled text (no contrast requirement) -->
      <SolidColorBrush x:Key="TextOnTooltip" Color="{StaticResource TextOnTooltipColor}" /> <!-- text on BgTooltip -->
      <!-- Accent -->
      <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" /> <!-- accent text, links and icons -->
      <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" /> <!-- accent text under the pointer -->
      <SolidColorBrush x:Key="AccentPressed" Color="{StaticResource AccentPressedColor}" /> <!-- accent text pressed -->
      <SolidColorBrush x:Key="AccentFill" Color="{StaticResource AccentFillColor}" /> <!-- accent button background -->
      <SolidColorBrush x:Key="AccentFillHover" Color="{StaticResource AccentFillHoverColor}" /> <!-- accent button under the pointer -->
      <SolidColorBrush x:Key="AccentFillPressed" Color="{StaticResource AccentFillPressedColor}" /> <!-- accent button pressed -->
      <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentSoftColor}" /> <!-- selected rows and the active sidebar item -->
      <SolidColorBrush x:Key="AccentSoftHover" Color="{StaticResource AccentSoftHoverColor}" /> <!-- a selected row under the pointer -->
      <SolidColorBrush x:Key="OnAccent" Color="{StaticResource OnAccentColor}" /> <!-- text and icons on AccentFill or DangerFill -->
      <SolidColorBrush x:Key="Focus" Color="{StaticResource FocusColor}" /> <!-- focus rings -->
      <!-- Status -->
      <SolidColorBrush x:Key="DangerFg" Color="{StaticResource DangerFgColor}" /> <!-- errors, destructive text -->
      <SolidColorBrush x:Key="DangerBg" Color="{StaticResource DangerBgColor}" /> <!-- error banners and badges -->
      <SolidColorBrush x:Key="DangerFill" Color="{StaticResource DangerFillColor}" /> <!-- destructive button background -->
      <SolidColorBrush x:Key="DangerFillHover" Color="{StaticResource DangerFillHoverColor}" />
      <SolidColorBrush x:Key="DangerFillPressed" Color="{StaticResource DangerFillPressedColor}" />
      <SolidColorBrush x:Key="WarningFg" Color="{StaticResource WarningFgColor}" />
      <SolidColorBrush x:Key="WarningBg" Color="{StaticResource WarningBgColor}" />
      <SolidColorBrush x:Key="SuccessFg" Color="{StaticResource SuccessFgColor}" />
      <SolidColorBrush x:Key="SuccessBg" Color="{StaticResource SuccessBgColor}" />
      <SolidColorBrush x:Key="InfoFg" Color="{StaticResource InfoFgColor}" />
      <SolidColorBrush x:Key="InfoBg" Color="{StaticResource InfoBgColor}" />
      <SolidColorBrush x:Key="VioletFg" Color="{StaticResource VioletFgColor}" /> <!-- a fifth status hue (undetermined) -->
      <SolidColorBrush x:Key="VioletBg" Color="{StaticResource VioletBgColor}" />
      <SolidColorBrush x:Key="NeutralFg" Color="{StaticResource NeutralFgColor}" /> <!-- neutral badges -->
      <SolidColorBrush x:Key="NeutralBg" Color="{StaticResource NeutralBgColor}" />
      <SolidColorBrush x:Key="ScrollThumb" Color="{StaticResource ScrollThumbColor}" /> <!-- scroll bar thumbs -->
