<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Design tokens: the only place colours, type sizes, spacing, radii and control heights are set. Views use these
    names (or the classes in Styles/), never literal values; StyleGuardTests checks that. Text colours keep at least
    4.5:1 contrast on the backgrounds they are used on, in both themes (ContrastTests).

    The 3.5 look ("High-Water") comes from the app icon. A deep navy frame (the sidebar and the title band, in both
    themes) surrounds bright content; a strong water blue is the accent; the staff gauge's red is kept for substantial
    damage, errors and destructive actions. The frame has its own text colours (TextOnFrame and so on). The sizes here
    are the Comfortable density; Styles/Density.Compact.axaml overrides them when Compact is chosen in Settings.
    docs/design/DESIGN-LANGUAGE.md has the rules.
  -->

  <!-- The brand accent: a strong water blue, at 5.5:1 under white text. Services/SystemAccent recolours
       every accent brush from the Mac's own accent instead when "Use the Mac's accent colour" is on in Settings. -->
  <Color x:Key="AccentFallbackColor">#1769C2</Color>

  <!-- Behind the phone form's QR code: always white, in both themes, so a phone camera can read it -->
  <SolidColorBrush x:Key="QrBackground" Color="#FFFFFF" />

  <!-- Type ramp (Public Sans): caption 11, footnote 12, body 13, subheadline 15, title 18, large title 24, display 30 -->
  <x:Double x:Key="FontSizeCaption">11</x:Double>
  <x:Double x:Key="FontSizeFootnote">12</x:Double>
  <x:Double x:Key="FontSizeBody">13</x:Double>
  <x:Double x:Key="FontSizeSubheadline">15</x:Double>
  <x:Double x:Key="FontSizeTitle">18</x:Double>
  <x:Double x:Key="FontSizeLargeTitle">24</x:Double>
  <x:Double x:Key="FontSizeDisplay">30</x:Double>
  <!-- The hero figure: the percent damaged on the dark result card, and the Summary's headline -->
  <x:Double x:Key="FontSizeHero">44</x:Double>
  <!-- Weights, for the rare place a class can't go (a Run inside a TextBlock); elsewhere use the medium, semibold and bold classes -->
  <FontWeight x:Key="FontWeightRegular">Normal</FontWeight>
  <FontWeight x:Key="FontWeightMedium">Medium</FontWeight>
  <FontWeight x:Key="FontWeightSemiBold">SemiBold</FontWeight>
  <FontWeight x:Key="FontWeightBold">Bold</FontWeight>

  <!-- Spacing (a 4 px grid) -->
  <x:Double x:Key="Space4">4</x:Double>
  <x:Double x:Key="Space8">8</x:Double>
  <x:Double x:Key="Space12">12</x:Double>
  <x:Double x:Key="Space16">16</x:Double>
  <x:Double x:Key="Space20">20</x:Double>
  <x:Double x:Key="Space24">24</x:Double>
  <x:Double x:Key="Space32">32</x:Double>
  <Thickness x:Key="PagePadding">24,20,24,24</Thickness>
  <Thickness x:Key="CardPadding">16,14</Thickness>
  <Thickness x:Key="CardPaddingCompact">12,10</Thickness>
  <Thickness x:Key="SheetPadding">24,20</Thickness>

  <!-- Corner radii: small parts inside a control 5, controls 7, grouped boxes 12, sheets 14, counts and switches fully round -->
  <CornerRadius x:Key="RadiusSmall">5</CornerRadius>
  <CornerRadius x:Key="RadiusControl">7</CornerRadius>
  <CornerRadius x:Key="RadiusCard">12</CornerRadius>
  <CornerRadius x:Key="RadiusSheet">14</CornerRadius>
  <CornerRadius x:Key="RadiusSheetAttached">0,0,14,14</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>
  <!-- The content panel's top-left corner, where the navy frame wraps round the bright content -->
  <CornerRadius x:Key="RadiusContent">14,0,0,0</CornerRadius>

  <!-- Control heights (Comfortable): small 22, regular 28, large 32 (toolbar items). Compact: 19, 22, 28 -->
  <x:Double x:Key="ControlHeightSmall">22</x:Double>
  <x:Double x:Key="ControlHeight">28</x:Double>
  <x:Double x:Key="ControlHeightLarge">32</x:Double>
  <x:Double x:Key="IconSize">16</x:Double>
  <x:Double x:Key="IconSizeSmall">14</x:Double>
  <x:Double x:Key="IconSizeLarge">20</x:Double>

  <!-- Shell. The sidebar and the inspectors are resizable between their min and max (a double-click on the edge goes
       back to the default width); MainViewModel.Layout reads these. -->
  <x:Double x:Key="SidebarWidth">232</x:Double>
  <x:Double x:Key="SidebarMinWidth">184</x:Double>
  <x:Double x:Key="SidebarMaxWidth">380</x:Double>
  <x:Double x:Key="InspectorWidth">288</x:Double>
  <x:Double x:Key="InspectorMinWidth">240</x:Double>
  <x:Double x:Key="InspectorMaxWidth">460</x:Double>
  <x:Double x:Key="ResizeHandleWidth">5</x:Double> <!-- the invisible strip on a sidebar's or inspector's edge that drags it -->
  <x:Double x:Key="TitleBandHeight">56</x:Double> <!-- the toolbar across the top; the sidebar's title strip matches it -->
  <!-- Room for the window's close, minimise and zoom buttons, before the show-sidebar button while the sidebar is hidden -->
  <Thickness x:Key="TrafficLightInset">68,0,0,0</Thickness>
  <!-- A sheet hangs from the title band's lower edge (its top is TitleBandHeight) -->
  <Thickness x:Key="SheetMargin">40,56,40,40</Thickness>
  <!-- Toasts sit this far above the window's bottom edge, centred over the page (not the sidebar) -->
  <Thickness x:Key="ToastMargin">0,0,0,20</Thickness>
  <x:Double x:Key="TableRowHeight">36</x:Double>
  <x:Double x:Key="TableHeaderHeight">36</x:Double>
  <x:Double x:Key="ScopeBarHeight">40</x:Double> <!-- the filter strip above a table (small controls, 9 px above and below) -->
  <x:Double x:Key="StatusBarHeight">28</x:Double> <!-- the count and sort line under a table -->
  <x:Double x:Key="StepBadgeSize">22</x:Double> <!-- the round step number in the editor's outline -->
  <x:Double x:Key="GaugeMiniWidth">56</x:Double> <!-- the staff gauge in a table cell -->
  <x:Double x:Key="ChartHeight">184</x:Double> <!-- the Summary's damage distribution and progress charts -->
  <x:Double x:Key="SheetWidthSmall">440</x:Double>
  <x:Double x:Key="SheetWidthMedium">600</x:Double>
  <x:Double x:Key="SheetWidthLarge">800</x:Double>

  <!-- Fluent's sizes, brought to the app's 13 pt, 28 px scale (DensityStyle="Compact" alone gives 14 pt and 24 px inputs) -->
  <FontFamily x:Key="ContentControlThemeFontFamily">fonts:PublicSans#Public Sans, fonts:Inter#Inter</FontFamily>
  <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>
  <x:Double x:Key="ToolTipContentThemeFontSize">12</x:Double>
  <x:Double x:Key="TextControlThemeMinHeight">28</x:Double>
  <Thickness x:Key="TextControlThemePadding">8,4,8,4</Thickness>
  <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
  <x:Double x:Key="ComboBoxMinHeight">28</x:Double>
  <Thickness x:Key="ComboBoxPadding">10,4,0,4</Thickness>
  <Thickness x:Key="ComboBoxItemThemePadding">10,5,10,5</Thickness>
  <x:Double x:Key="DropDownButtonMinHeight">28</x:Double>
  <Thickness x:Key="ButtonPadding">14,4,14,4</Thickness>
  <x:Double x:Key="CheckBoxMinHeight">24</x:Double>
  <x:Double x:Key="RadioButtonMinHeight">24</x:Double>
  <CornerRadius x:Key="ControlCornerRadius">7</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
  <Thickness x:Key="MenuFlyoutPresenterThemePadding">5,5</Thickness>
  <Thickness x:Key="MenuFlyoutItemThemePadding">10,5,10,5</Thickness>
  <Thickness x:Key="MenuFlyoutItemThemePaddingNarrow">10,5,10,5</Thickness>
  <Thickness x:Key="FlyoutContentThemePadding">12</Thickness>
  <Thickness x:Key="ToolTipBorderThemePadding">8,5,8,6</Thickness>
  <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>
  <!-- Sliders: Fluent's are 50 high (15 above and below the track); these keep a slider to its control's height -->
  <GridLength x:Key="SliderPreContentMargin">2</GridLength>
  <GridLength x:Key="SliderPostContentMargin">2</GridLength>
  <x:Double x:Key="SliderHorizontalHeight">28</x:Double>
  <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>
  <x:Double x:Key="SliderHorizontalThumbWidth">15</x:Double>
  <x:Double x:Key="SliderHorizontalThumbHeight">15</x:Double>
  <CornerRadius x:Key="SliderThumbCornerRadius">8</CornerRadius>
  <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">1</x:Double>
  <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">1</x:Double>
  <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">1</x:Double>
  <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">1</x:Double>

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <!-- Colours (the brushes below use these) -->
      <Color x:Key="BgAppColor">#F3F6FA</Color>
      <Color x:Key="BgSidebarColor">#EDF1F6</Color>
      <Color x:Key="BgSurfaceColor">#FFFFFF</Color>
      <Color x:Key="BgSubtleColor">#F1F4F8</Color>
      <Color x:Key="BgInspectorColor">#FAFBFD</Color>
      <Color x:Key="BgHoverColor">#E9EEF4</Color>
      <Color x:Key="BgPressedColor">#DDE4EC</Color>
      <Color x:Key="BgOverlayColor">#52081321</Color> <!-- a sheet dims the window behind it -->
      <Color x:Key="BgTooltipColor">#0E2540</Color>
      <Color x:Key="BorderDefaultColor">#DCE3EB</Color>
      <Color x:Key="BorderStrongColor">#BCC7D4</Color>
      <Color x:Key="BorderStrongHoverColor">#A3B0C0</Color>
      <Color x:Key="BorderSubtleColor">#E8EDF3</Color>
      <Color x:Key="TextPrimaryColor">#0E1B2C</Color>
      <Color x:Key="TextSecondaryColor">#45556A</Color>
      <Color x:Key="TextTertiaryColor">#56667B</Color>
      <Color x:Key="TextDisabledColor">#A6B0BD</Color>
      <Color x:Key="TextOnTooltipColor">#FFFFFF</Color>
      <Color x:Key="AccentColor">#1259A8</Color>
      <Color x:Key="AccentHoverColor">#0F4D92</Color>
      <Color x:Key="AccentPressedColor">#0C417C</Color>
      <Color x:Key="AccentFillColor">#1769C2</Color>
      <Color x:Key="AccentFillHoverColor">#145DAD</Color>
      <Color x:Key="AccentFillPressedColor">#115199</Color>
      <Color x:Key="AccentSoftColor">#DDEBFA</Color>
      <Color x:Key="AccentSoftHoverColor">#CFE2F8</Color>
      <Color x:Key="OnAccentColor">#FFFFFF</Color>
      <Color x:Key="FocusColor">#1769C2</Color>
      <Color x:Key="DangerFgColor">#B50E28</Color>
      <Color x:Key="DangerBgColor">#FCE8EB</Color>
      <Color x:Key="DangerFillColor">#C8102E</Color>
      <Color x:Key="DangerFillHoverColor">#AE0E28</Color>
      <Color x:Key="DangerFillPressedColor">#950C22</Color>
      <Color x:Key="WarningFgColor">#8A4700</Color>
      <Color x:Key="WarningBgColor">#FDEFD9</Color>
      <Color x:Key="SuccessFgColor">#17693A</Color>
      <Color x:Key="SuccessBgColor">#E1F3E7</Color>
      <Color x:Key="InfoFgColor">#1259A8</Color>
      <Color x:Key="InfoBgColor">#E1EDFB</Color>
      <Color x:Key="VioletFgColor">#5F3FA3</Color>
      <Color x:Key="VioletBgColor">#EFEAFA</Color>
      <Color x:Key="NeutralFgColor">#45556A</Color>
      <Color x:Key="NeutralBgColor">#E9EDF2</Color>
      <Color x:Key="ScrollThumbColor">#B9C3CF</Color>
      <!-- The frame (3.5): the sidebar and title band are navy in both themes, with their own text colours -->
      <Color x:Key="BgFrameColor">#0E2540</Color>
      <Color x:Key="BgFrameHoverColor">#193656</Color>
      <Color x:Key="BgFramePressedColor">#1F416A</Color>
      <Color x:Key="BgFrameFieldColor">#1B3A5E</Color>
      <Color x:Key="BorderFrameColor">#234469</Color>
      <Color x:Key="TextOnFrameColor">#FFFFFF</Color>
      <Color x:Key="TextOnFrameSecondaryColor">#BCCADB</Color>
      <Color x:Key="TextOnFrameTertiaryColor">#9DAFC5</Color>
      <Color x:Key="AccentOnFrameColor">#7FBDF7</Color>
      <Color x:Key="DangerOnFrameColor">#FF8F99</Color>
      <Color x:Key="BgHeroColor">#0F2A4A</Color>
      <Color x:Key="TextOnHeroColor">#FFFFFF</Color>
      <Color x:Key="TextOnHeroSecondaryColor">#BCCADB</Color>
      <Color x:Key="BgFrameSelectedColor">#2C5788</Color>
      <Color x:Key="BorderCardColor">#E1E7EE</Color>
      <Color x:Key="BgTableHeaderColor">#F4F6F9</Color>
      <!-- Backgrounds -->
      <SolidColorBrush x:Key="BgApp" Color="{StaticResource BgAppColor}" /> <!-- the content area behind cards -->
      <SolidColorBrush x:Key="BgSidebar" Color="{StaticResource BgSidebarColor}" /> <!-- the sidebar and side panels -->
      <SolidColorBrush x:Key="BgSurface" Color="{StaticResource BgSurfaceColor}" /> <!-- cards, sheets, inputs, menus -->
      <SolidColorBrush x:Key="BgSubtle" Color="{StaticResource BgSubtleColor}" /> <!-- insets and secondary areas inside a card -->
      <SolidColorBrush x:Key="BgInspector" Color="{StaticResource BgInspectorColor}" /> <!-- the inspector pane at the right of a page -->
      <SolidColorBrush x:Key="BgHover" Color="{StaticResource BgHoverColor}" /> <!-- a row or ghost button under the pointer -->
      <SolidColorBrush x:Key="BgPressed" Color="{StaticResource BgPressedColor}" /> <!-- a row or button being pressed -->
      <SolidColorBrush x:Key="BgOverlay" Color="{StaticResource BgOverlayColor}" /> <!-- the scrim behind a sheet -->
      <SolidColorBrush x:Key="BgTooltip" Color="{StaticResource BgTooltipColor}" /> <!-- tooltips -->
      <!-- Borders -->
      <SolidColorBrush x:Key="BorderDefault" Color="{StaticResource BorderDefaultColor}" /> <!-- cards and dividers -->
      <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource BorderStrongColor}" /> <!-- inputs and default buttons -->
      <SolidColorBrush x:Key="BorderStrongHover" Color="{StaticResource BorderStrongHoverColor}" /> <!-- an input under the pointer -->
      <SolidColorBrush x:Key="BorderSubtle" Color="{StaticResource BorderSubtleColor}" /> <!-- row separators -->
      <!-- Text -->
      <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" /> <!-- body text -->
      <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" /> <!-- supporting text -->
      <SolidColorBrush x:Key="TextTertiary" Color="{StaticResource TextTertiaryColor}" /> <!-- captions, hints, placeholders (still 4.5:1) -->
      <SolidColorBrush x:Key="TextDisabled" Color="{StaticResource TextDisabledColor}" /> <!-- disabled text (no contrast requirement) -->
      <SolidColorBrush x:Key="TextOnTooltip" Color="{StaticResource TextOnTooltipColor}" /> <!-- text on BgTooltip -->
      <!-- Accent -->
      <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" /> <!-- accent text, links and icons -->
      <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" /> <!-- accent text under the pointer -->
      <SolidColorBrush x:Key="AccentPressed" Color="{StaticResource AccentPressedColor}" /> <!-- accent text pressed -->
      <SolidColorBrush x:Key="AccentFill" Color="{StaticResource AccentFillColor}" /> <!-- accent button background -->
      <SolidColorBrush x:Key="AccentFillHover" Color="{StaticResource AccentFillHoverColor}" /> <!-- accent button under the pointer -->
      <SolidColorBrush x:Key="AccentFillPressed" Color="{StaticResource AccentFillPressedColor}" /> <!-- accent button pressed -->
      <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentSoftColor}" /> <!-- selected rows and the active sidebar item -->
      <SolidColorBrush x:Key="AccentSoftHover" Color="{StaticResource AccentSoftHoverColor}" /> <!-- a selected row under the pointer -->
      <SolidColorBrush x:Key="OnAccent" Color="{StaticResource OnAccentColor}" /> <!-- text and icons on AccentFill or DangerFill -->
      <SolidColorBrush x:Key="Focus" Color="{StaticResource FocusColor}" /> <!-- focus rings -->
      <!-- Status -->
      <SolidColorBrush x:Key="DangerFg" Color="{StaticResource DangerFgColor}" /> <!-- errors, destructive text -->
      <SolidColorBrush x:Key="DangerBg" Color="{StaticResource DangerBgColor}" /> <!-- error banners and badges -->
      <SolidColorBrush x:Key="DangerFill" Color="{StaticResource DangerFillColor}" /> <!-- destructive button background -->
      <SolidColorBrush x:Key="DangerFillHover" Color="{StaticResource DangerFillHoverColor}" />
      <SolidColorBrush x:Key="DangerFillPressed" Color="{StaticResource DangerFillPressedColor}" />
      <SolidColorBrush x:Key="WarningFg" Color="{StaticResource WarningFgColor}" />
      <SolidColorBrush x:Key="WarningBg" Color="{StaticResource WarningBgColor}" />
      <SolidColorBrush x:Key="SuccessFg" Color="{StaticResource SuccessFgColor}" />
      <SolidColorBrush x:Key="SuccessBg" Color="{StaticResource SuccessBgColor}" />
      <SolidColorBrush x:Key="InfoFg" Color="{StaticResource InfoFgColor}" />
      <SolidColorBrush x:Key="InfoBg" Color="{StaticResource InfoBgColor}" />
      <SolidColorBrush x:Key="VioletFg" Color="{StaticResource VioletFgColor}" /> <!-- a fifth status hue (undetermined) -->
      <SolidColorBrush x:Key="VioletBg" Color="{StaticResource VioletBgColor}" />
      <SolidColorBrush x:Key="NeutralFg" Color="{StaticResource NeutralFgColor}" /> <!-- neutral badges -->
      <SolidColorBrush x:Key="NeutralBg" Color="{StaticResource NeutralBgColor}" />
      <SolidColorBrush x:Key="ScrollThumb" Color="{StaticResource ScrollThumbColor}" /> <!-- scroll bar thumbs -->
      <SolidColorBrush x:Key="BgFrame" Color="{StaticResource BgFrameColor}" /> <!-- the navy frame: the sidebar and the title band -->
      <SolidColorBrush x:Key="BgFrameHover" Color="{StaticResource BgFrameHoverColor}" /> <!-- a row or button on the frame under the pointer -->
      <SolidColorBrush x:Key="BgFramePressed" Color="{StaticResource BgFramePressedColor}" /> <!-- a row or button on the frame being pressed -->
      <SolidColorBrush x:Key="BgFrameField" Color="{StaticResource BgFrameFieldColor}" /> <!-- the search field and other inputs on the frame -->
      <SolidColorBrush x:Key="BorderFrame" Color="{StaticResource BorderFrameColor}" /> <!-- dividers and input borders on the frame -->
      <SolidColorBrush x:Key="TextOnFrame" Color="{StaticResource TextOnFrameColor}" /> <!-- titles and selected rows on the frame -->
      <SolidColorBrush x:Key="TextOnFrameSecondary" Color="{StaticResource TextOnFrameSecondaryColor}" /> <!-- rows and labels on the frame -->
      <SolidColorBrush x:Key="TextOnFrameTertiary" Color="{StaticResource TextOnFrameTertiaryColor}" /> <!-- section labels, counts and placeholders on the frame -->
      <SolidColorBrush x:Key="AccentOnFrame" Color="{StaticResource AccentOnFrameColor}" /> <!-- the brand mark and links on the frame -->
      <SolidColorBrush x:Key="DangerOnFrame" Color="{StaticResource DangerOnFrameColor}" /> <!-- required-problem counts on the frame -->
      <SolidColorBrush x:Key="BgHero" Color="{StaticResource BgHeroColor}" /> <!-- the result panel, the one dark card inside the content area -->
      <SolidColorBrush x:Key="TextOnHero" Color="{StaticResource TextOnHeroColor}" /> <!-- the figure on the result panel -->
      <SolidColorBrush x:Key="TextOnHeroSecondary" Color="{StaticResource TextOnHeroSecondaryColor}" /> <!-- supporting text on the result panel -->
      <SolidColorBrush x:Key="BgFrameSelected" Color="{StaticResource BgFrameSelectedColor}" /> <!-- the chosen segment of a switch on the frame -->
      <SolidColorBrush x:Key="BorderCard" Color="{StaticResource BorderCardColor}" /> <!-- the hairline round a white card (with ShadowCard under it) -->
      <SolidColorBrush x:Key="BgTableHeader" Color="{StaticResource BgTableHeaderColor}" /> <!-- a table's header row -->
      <!-- Older names, kept because code and views look them up by name -->
      <SolidColorBrush x:Key="WindowBg" Color="{StaticResource BgAppColor}" />
      <SolidColorBrush x:Key="SidebarBg" Color="{StaticResource BgSidebarColor}" />
      <SolidColorBrush x:Key="CardBg" Color="{StaticResource BgSurfaceColor}" />
      <SolidColorBrush x:Key="CardBorder" Color="{StaticResource BorderDefaultColor}" />
      <SolidColorBrush x:Key="SubtleBg" Color="{StaticResource BgSubtleColor}" />
      <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextTertiaryColor}" />
      <SolidColorBrush x:Key="SelectedRow" Color="{StaticResource AccentSoftColor}" />
      <SolidColorBrush x:Key="StatusSubstantialFg" Color="{StaticResource DangerFgColor}" />
      <SolidColorBrush x:Key="StatusSubstantialBg" Color="{StaticResource DangerBgColor}" />
      <SolidColorBrush x:Key="StatusCloseFg" Color="{StaticResource WarningFgColor}" />
      <SolidColorBrush x:Key="StatusCloseBg" Color="{StaticResource WarningBgColor}" />
      <SolidColorBrush x:Key="StatusNotSubstantialFg" Color="{StaticResource SuccessFgColor}" />
      <SolidColorBrush x:Key="StatusNotSubstantialBg" Color="{StaticResource SuccessBgColor}" />
      <SolidColorBrush x:Key="StatusIncompleteFg" Color="{StaticResource NeutralFgColor}" />
      <SolidColorBrush x:Key="StatusIncompleteBg" Color="{StaticResource NeutralBgColor}" />
      <SolidColorBrush x:Key="StatusUndeterminedFg" Color="{StaticResource VioletFgColor}" />
      <SolidColorBrush x:Key="StatusUndeterminedBg" Color="{StaticResource VioletBgColor}" />
      <!-- The result dots in tables (Mac system hues; a dot needs no text contrast, it sits beside the result's name) -->
      <SolidColorBrush x:Key="StatusSubstantialDot" Color="#C8102E" />
      <SolidColorBrush x:Key="StatusCloseDot" Color="#DE8A1B" />
      <SolidColorBrush x:Key="StatusNotSubstantialDot" Color="#2E9E57" />
      <SolidColorBrush x:Key="StatusIncompleteDot" Color="#8D99A8" />
      <SolidColorBrush x:Key="StatusUndeterminedDot" Color="#8A63C9" />
      <SolidColorBrush x:Key="RequiredFg" Color="{StaticResource DangerFgColor}" />
      <SolidColorBrush x:Key="RecommendedFg" Color="{StaticResource WarningFgColor}" />
      <SolidColorBrush x:Key="SuggestedFg" Color="{StaticResource SuccessFgColor}" />
      <!-- Focus halo around inputs and the focused-control ring -->
      <BoxShadows x:Key="FocusHalo">0 0 0 3 #731769C2</BoxShadows>
      <BoxShadows x:Key="ShadowPopup">0 6 20 0 #29000000</BoxShadows>
      <BoxShadows x:Key="ShadowSheet">0 10 30 0 #40000000</BoxShadows>
      <BoxShadows x:Key="ShadowCard">0 1 2 0 #0F0E2540, 0 8 24 -6 #240E2540</BoxShadows>
      <BoxShadows x:Key="ShadowHero">0 2 4 0 #1F0E2540, 0 14 32 -10 #590E2540</BoxShadows>
      <!-- The bezel under a push button, a pop-up button and the selected segment (Mac controls sit slightly raised) -->
      <BoxShadows x:Key="ShadowControl">0 0.5 1.5 0 #24000000</BoxShadows>
      <!-- The staff gauge (Controls/StaffGauge): the dry staff, its graduations, the water, and the high-water mark.
           The water turns to the warning amber within ten points of the line and to the gauge red at or above it. -->
      <SolidColorBrush x:Key="GaugeTrack" Color="#E3E9F0" />
      <SolidColorBrush x:Key="GaugeTick" Color="#8D99A8" />
      <SolidColorBrush x:Key="GaugeWater" Color="#1F7AD6" />
      <SolidColorBrush x:Key="GaugeNear" Color="#D9871A" />
      <SolidColorBrush x:Key="GaugeDanger" Color="#C8102E" />
      <SolidColorBrush x:Key="GaugeMark" Color="#C8102E" />
      <SolidColorBrush x:Key="GaugeMarkHalo" Color="#FFFFFF" /> <!-- a thin gap either side of the mark where it crosses the water -->
      <!-- The same gauge drawn on the dark result card (StaffGauge.OnDark): a lighter staff and brighter water and red -->
      <SolidColorBrush x:Key="GaugeTrackOnDark" Color="#2A4A70" />
      <SolidColorBrush x:Key="GaugeTickOnDark" Color="#7E95B2" />
      <SolidColorBrush x:Key="GaugeWaterOnDark" Color="#4DA6FF" />
      <SolidColorBrush x:Key="GaugeNearOnDark" Color="#F5B04A" />
      <SolidColorBrush x:Key="GaugeDangerOnDark" Color="#FF5468" />
      <SolidColorBrush x:Key="GaugeMarkOnDark" Color="#FF5468" />
      <SolidColorBrush x:Key="GaugeMarkHaloOnDark" Color="{StaticResource BgHeroColor}" />
      <!-- The Summary's charts: light gridlines, the progress line and the soft area under it -->
      <SolidColorBrush x:Key="ChartGrid" Color="#E6EBF1" />
      <SolidColorBrush x:Key="ChartLine" Color="#1769C2" />
      <LinearGradientBrush x:Key="ChartArea" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#4D1769C2" />
        <GradientStop Offset="1" Color="#051769C2" />
      </LinearGradientBrush>
      <!-- The selected table row: the soft accent with a 3 px accent edge at its leading side -->
      <LinearGradientBrush x:Key="RowSelectedFill" StartPoint="0,0" EndPoint="4,0">
        <GradientStop Offset="0" Color="{StaticResource AccentFillColor}" />
        <GradientStop Offset="0.75" Color="{StaticResource AccentFillColor}" />
        <GradientStop Offset="0.75" Color="{StaticResource AccentSoftColor}" />
        <GradientStop Offset="1" Color="{StaticResource AccentSoftColor}" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="RowSelectedHoverFill" StartPoint="0,0" EndPoint="4,0">
        <GradientStop Offset="0" Color="{StaticResource AccentFillColor}" />
        <GradientStop Offset="0.75" Color="{StaticResource AccentFillColor}" />
        <GradientStop Offset="0.75" Color="{StaticResource AccentSoftHoverColor}" />
        <GradientStop Offset="1" Color="{StaticResource AccentSoftHoverColor}" />
      </LinearGradientBrush>
      <!-- Mac surfaces with no WCAG text pair: the selected source-list row and a segmented control's track -->
      <SolidColorBrush x:Key="SidebarSelection" Color="#D5DEE9" />
      <SolidColorBrush x:Key="SegmentedTrack" Color="#E3E9F0" />
      <SolidColorBrush x:Key="ControlFill" Color="#FFFFFF" />
