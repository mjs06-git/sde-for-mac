<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Design tokens: the only place colours, type sizes, spacing, radii and control heights are set. Views use these
    names (or the classes in Styles/), never literal values; StyleGuardTests checks that. Text colours keep at least
    4.5:1 contrast on the backgrounds they are used on, in both themes (ContrastTests).
  -->

  <!-- The accent when the Mac doesn't report one (tests, other platforms): the Mac's default blue, darkened for 4.5:1.
       On a Mac, Services/SystemAccent recolours every accent brush from the System Settings accent. -->
  <Color x:Key="AccentFallbackColor">#0A64D6</Color>

  <!-- Behind the phone form's QR code: always white, in both themes, so a phone camera can read it -->
  <SolidColorBrush x:Key="QrBackground" Color="#FFFFFF" />

  <!-- Type ramp (the Mac system font, SF Pro): caption 11, footnote 12, body 13, subheadline 15, title 17, large title 22, display 26 -->
  <x:Double x:Key="FontSizeCaption">11</x:Double>
  <x:Double x:Key="FontSizeFootnote">12</x:Double>
  <x:Double x:Key="FontSizeBody">13</x:Double>
  <x:Double x:Key="FontSizeSubheadline">15</x:Double>
  <x:Double x:Key="FontSizeTitle">17</x:Double>
  <x:Double x:Key="FontSizeLargeTitle">22</x:Double>
  <x:Double x:Key="FontSizeDisplay">26</x:Double>
  <!-- Weights, for the rare place a class can't go (a Run inside a TextBlock); elsewhere use the medium, semibold and bold classes -->
  <FontWeight x:Key="FontWeightRegular">Normal</FontWeight>
  <FontWeight x:Key="FontWeightMedium">Medium</FontWeight>
  <FontWeight x:Key="FontWeightSemiBold">SemiBold</FontWeight>
  <FontWeight x:Key="FontWeightBold">Bold</FontWeight>

  <!-- Spacing (a 4 px grid) -->
  <x:Double x:Key="Space4">4</x:Double>
  <x:Double x:Key="Space8">8</x:Double>
  <x:Double x:Key="Space12">12</x:Double>
  <x:Double x:Key="Space16">16</x:Double>
  <x:Double x:Key="Space20">20</x:Double>
  <x:Double x:Key="Space24">24</x:Double>
  <x:Double x:Key="Space32">32</x:Double>
  <Thickness x:Key="PagePadding">24,20,24,24</Thickness>
  <Thickness x:Key="CardPadding">16,14</Thickness>
  <Thickness x:Key="CardPaddingCompact">12,10</Thickness>
  <Thickness x:Key="SheetPadding">24,20</Thickness>

  <!-- Corner radii (macOS): controls 5, grouped boxes and sheets 8, pills fully round (being retired) -->
  <CornerRadius x:Key="RadiusControl">5</CornerRadius>
  <CornerRadius x:Key="RadiusCard">8</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>

  <!-- Control heights (macOS): small 19, regular 22, large 28 (toolbar items) -->
  <x:Double x:Key="ControlHeightSmall">19</x:Double>
  <x:Double x:Key="ControlHeight">22</x:Double>
  <x:Double x:Key="ControlHeightLarge">28</x:Double>
  <x:Double x:Key="IconSize">16</x:Double>
  <x:Double x:Key="IconSizeSmall">14</x:Double>
  <x:Double x:Key="IconSizeLarge">20</x:Double>

  <!-- Shell -->
  <x:Double x:Key="SidebarWidth">220</x:Double>
  <x:Double x:Key="TitleBandHeight">52</x:Double>
  <x:Double x:Key="TableRowHeight">24</x:Double>
  <x:Double x:Key="SheetWidthSmall">440</x:Double>
  <x:Double x:Key="SheetWidthMedium">600</x:Double>
  <x:Double x:Key="SheetWidthLarge">800</x:Double>

  <!-- Fluent's sizes, brought to the Mac's 13 pt, 22 px scale (DensityStyle="Compact" alone gives 14 pt and 24 px inputs) -->
  <FontFamily x:Key="ContentControlThemeFontFamily">.AppleSystemUIFont, fonts:Inter#Inter</FontFamily>
  <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>
  <x:Double x:Key="ToolTipContentThemeFontSize">12</x:Double>
  <x:Double x:Key="TextControlThemeMinHeight">22</x:Double>
  <Thickness x:Key="TextControlThemePadding">6,2,6,2</Thickness>
  <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
  <x:Double x:Key="ComboBoxMinHeight">22</x:Double>
  <Thickness x:Key="ComboBoxPadding">9,1,0,1</Thickness>
  <Thickness x:Key="ComboBoxItemThemePadding">10,3,10,3</Thickness>
  <x:Double x:Key="DropDownButtonMinHeight">22</x:Double>
  <Thickness x:Key="ButtonPadding">12,1,12,1</Thickness>
  <x:Double x:Key="CheckBoxMinHeight">20</x:Double>
  <x:Double x:Key="RadioButtonMinHeight">20</x:Double>
  <CornerRadius x:Key="ControlCornerRadius">5</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">7</CornerRadius>
  <Thickness x:Key="MenuFlyoutPresenterThemePadding">5,5</Thickness>
  <Thickness x:Key="MenuFlyoutItemThemePadding">9,3,9,3</Thickness>
  <Thickness x:Key="MenuFlyoutItemThemePaddingNarrow">9,3,9,3</Thickness>
  <Thickness x:Key="FlyoutContentThemePadding">12</Thickness>
  <Thickness x:Key="ToolTipBorderThemePadding">8,5,8,6</Thickness>
  <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>
  <!-- Sliders: Fluent's are 50 high (15 above and below the track); these keep a slider to its control's height -->
  <GridLength x:Key="SliderPreContentMargin">2</GridLength>
  <GridLength x:Key="SliderPostContentMargin">2</GridLength>
  <x:Double x:Key="SliderHorizontalHeight">24</x:Double>
  <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>
  <x:Double x:Key="SliderHorizontalThumbWidth">18</x:Double>
  <x:Double x:Key="SliderHorizontalThumbHeight">18</x:Double>
  <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">1</x:Double>
  <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">1</x:Double>
  <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">1</x:Double>
  <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">1</x:Double>

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <!-- Colours (the brushes below use these) -->
      <Color x:Key="BgAppColor">#FFFFFF</Color>
      <Color x:Key="BgSidebarColor">#EBEBEA</Color>
      <Color x:Key="BgSurfaceColor">#FFFFFF</Color>
      <Color x:Key="BgSubtleColor">#F4F5F5</Color>
      <Color x:Key="BgHoverColor">#EFEFEF</Color>
      <Color x:Key="BgPressedColor">#E3E3E3</Color>
      <Color x:Key="BgOverlayColor">#26000000</Color>
      <Color x:Key="BgTooltipColor">#F2F2F2</Color>
      <Color x:Key="BorderDefaultColor">#E0E0E0</Color>
      <Color x:Key="BorderStrongColor">#C8C8C8</Color>
      <Color x:Key="BorderStrongHoverColor">#B4B4B4</Color>
      <Color x:Key="BorderSubtleColor">#EBEBEB</Color>
      <Color x:Key="TextPrimaryColor">#1D1D1F</Color>
      <Color x:Key="TextSecondaryColor">#5E5E62</Color>
      <Color x:Key="TextTertiaryColor">#68686D</Color>
      <Color x:Key="TextDisabledColor">#A8A8AD</Color>
      <Color x:Key="TextOnTooltipColor">#1D1D1F</Color>
      <Color x:Key="AccentColor">#0058C2</Color>
      <Color x:Key="AccentHoverColor">#004EAD</Color>
      <Color x:Key="AccentPressedColor">#004497</Color>
      <Color x:Key="AccentFillColor">#0A64D6</Color>
      <Color x:Key="AccentFillHoverColor">#0958BE</Color>
      <Color x:Key="AccentFillPressedColor">#084FA9</Color>
      <Color x:Key="AccentSoftColor">#E3EDFB</Color>
      <Color x:Key="AccentSoftHoverColor">#D6E5FA</Color>
      <Color x:Key="OnAccentColor">#FFFFFF</Color>
      <Color x:Key="FocusColor">#0A64D6</Color>
      <Color x:Key="DangerFgColor">#C4001A</Color>
      <Color x:Key="DangerBgColor">#FDE8EA</Color>
      <Color x:Key="DangerFillColor">#C4001A</Color>
      <Color x:Key="DangerFillHoverColor">#A80016</Color>
      <Color x:Key="DangerFillPressedColor">#8F0013</Color>
      <Color x:Key="WarningFgColor">#A34400</Color>
      <Color x:Key="WarningBgColor">#FFF1E0</Color>
      <Color x:Key="SuccessFgColor">#187A34</Color>
      <Color x:Key="SuccessBgColor">#E5F5EA</Color>
      <Color x:Key="InfoFgColor">#0058C2</Color>
      <Color x:Key="InfoBgColor">#E5EFFC</Color>
      <Color x:Key="VioletFgColor">#6A45B8</Color>
      <Color x:Key="VioletBgColor">#F0EBFA</Color>
      <Color x:Key="NeutralFgColor">#5E5E62</Color>
      <Color x:Key="NeutralBgColor">#EEEEEF</Color>
      <Color x:Key="ScrollThumbColor">#C1C1C1</Color>
      <!-- Backgrounds -->
      <SolidColorBrush x:Key="BgApp" Color="{StaticResource BgAppColor}" /> <!-- the content area behind cards -->
      <SolidColorBrush x:Key="BgSidebar" Color="{StaticResource BgSidebarColor}" /> <!-- the sidebar and side panels -->
      <SolidColorBrush x:Key="BgSurface" Color="{StaticResource BgSurfaceColor}" /> <!-- cards, sheets, inputs, menus -->
      <SolidColorBrush x:Key="BgSubtle" Color="{StaticResource BgSubtleColor}" /> <!-- insets and secondary areas inside a card -->
      <SolidColorBrush x:Key="BgHover" Color="{StaticResource BgHoverColor}" /> <!-- a row or ghost button under the pointer -->
      <SolidColorBrush x:Key="BgPressed" Color="{StaticResource BgPressedColor}" /> <!-- a row or button being pressed -->
      <SolidColorBrush x:Key="BgOverlay" Color="{StaticResource BgOverlayColor}" /> <!-- the scrim behind a sheet -->
      <SolidColorBrush x:Key="BgTooltip" Color="{StaticResource BgTooltipColor}" /> <!-- tooltips -->
      <!-- Borders -->
      <SolidColorBrush x:Key="BorderDefault" Color="{StaticResource BorderDefaultColor}" /> <!-- cards and dividers -->
      <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource BorderStrongColor}" /> <!-- inputs and default buttons -->
      <SolidColorBrush x:Key="BorderStrongHover" Color="{StaticResource BorderStrongHoverColor}" /> <!-- an input under the pointer -->
      <SolidColorBrush x:Key="BorderSubtle" Color="{StaticResource BorderSubtleColor}" /> <!-- row separators -->
      <!-- Text -->
      <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" /> <!-- body text -->
      <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" /> <!-- supporting text -->
      <SolidColorBrush x:Key="TextTertiary" Color="{StaticResource TextTertiaryColor}" /> <!-- captions, hints, placeholders (still 4.5:1) -->
      <SolidColorBrush x:Key="TextDisabled" Color="{StaticResource TextDisabledColor}" /> <!-- disabled text (no contrast requirement) -->
      <SolidColorBrush x:Key="TextOnTooltip" Color="{StaticResource TextOnTooltipColor}" /> <!-- text on BgTooltip -->
      <!-- Accent -->
      <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" /> <!-- accent text, links and icons -->
      <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" /> <!-- accent text under the pointer -->
      <SolidColorBrush x:Key="AccentPressed" Color="{StaticResource AccentPressedColor}" /> <!-- accent text pressed -->
      <SolidColorBrush x:Key="AccentFill" Color="{StaticResource AccentFillColor}" /> <!-- accent button background -->
      <SolidColorBrush x:Key="AccentFillHover" Color="{StaticResource AccentFillHoverColor}" /> <!-- accent button under the pointer -->
      <SolidColorBrush x:Key="AccentFillPressed" Color="{StaticResource AccentFillPressedColor}" /> <!-- accent button pressed -->
      <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentSoftColor}" /> <!-- selected rows and the active sidebar item -->
      <SolidColorBrush x:Key="AccentSoftHover" Color="{StaticResource AccentSoftHoverColor}" /> <!-- a selected row under the pointer -->
      <SolidColorBrush x:Key="OnAccent" Color="{StaticResource OnAccentColor}" /> <!-- text and icons on AccentFill or DangerFill -->
      <SolidColorBrush x:Key="Focus" Color="{StaticResource FocusColor}" /> <!-- focus rings -->
      <!-- Status -->
      <SolidColorBrush x:Key="DangerFg" Color="{StaticResource DangerFgColor}" /> <!-- errors, destructive text -->
      <SolidColorBrush x:Key="DangerBg" Color="{StaticResource DangerBgColor}" /> <!-- error banners and badges -->
      <SolidColorBrush x:Key="DangerFill" Color="{StaticResource DangerFillColor}" /> <!-- destructive button background -->
      <SolidColorBrush x:Key="DangerFillHover" Color="{StaticResource DangerFillHoverColor}" />
      <SolidColorBrush x:Key="DangerFillPressed" Color="{StaticResource DangerFillPressedColor}" />
      <SolidColorBrush x:Key="WarningFg" Color="{StaticResource WarningFgColor}" />
      <SolidColorBrush x:Key="WarningBg" Color="{StaticResource WarningBgColor}" />
      <SolidColorBrush x:Key="SuccessFg" Color="{StaticResource SuccessFgColor}" />
      <SolidColorBrush x:Key="SuccessBg" Color="{StaticResource SuccessBgColor}" />
      <SolidColorBrush x:Key="InfoFg" Color="{StaticResource InfoFgColor}" />
      <SolidColorBrush x:Key="InfoBg" Color="{StaticResource InfoBgColor}" />
      <SolidColorBrush x:Key="VioletFg" Color="{StaticResource VioletFgColor}" /> <!-- a fifth status hue (undetermined) -->
      <SolidColorBrush x:Key="VioletBg" Color="{StaticResource VioletBgColor}" />
      <SolidColorBrush x:Key="NeutralFg" Color="{StaticResource NeutralFgColor}" /> <!-- neutral badges -->
      <SolidColorBrush x:Key="NeutralBg" Color="{StaticResource NeutralBgColor}" />
      <SolidColorBrush x:Key="ScrollThumb" Color="{StaticResource ScrollThumbColor}" /> <!-- scroll bar thumbs -->
      <!-- Older names, kept because code and views look them up by name -->
      <SolidColorBrush x:Key="WindowBg" Color="{StaticResource BgAppColor}" />
      <SolidColorBrush x:Key="SidebarBg" Color="{StaticResource BgSidebarColor}" />
      <SolidColorBrush x:Key="CardBg" Color="{StaticResource BgSurfaceColor}" />
      <SolidColorBrush x:Key="CardBorder" Color="{StaticResource BorderDefaultColor}" />
      <SolidColorBrush x:Key="SubtleBg" Color="{StaticResource BgSubtleColor}" />
      <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextTertiaryColor}" />
      <SolidColorBrush x:Key="SelectedRow" Color="{StaticResource AccentSoftColor}" />
      <SolidColorBrush x:Key="StatusSubstantialFg" Color="{StaticResource DangerFgColor}" />
      <SolidColorBrush x:Key="StatusSubstantialBg" Color="{StaticResource DangerBgColor}" />
      <SolidColorBrush x:Key="StatusCloseFg" Color="{StaticResource WarningFgColor}" />
      <SolidColorBrush x:Key="StatusCloseBg" Color="{StaticResource WarningBgColor}" />
      <SolidColorBrush x:Key="StatusNotSubstantialFg" Color="{StaticResource SuccessFgColor}" />
      <SolidColorBrush x:Key="StatusNotSubstantialBg" Color="{StaticResource SuccessBgColor}" />
      <SolidColorBrush x:Key="StatusIncompleteFg" Color="{StaticResource NeutralFgColor}" />
      <SolidColorBrush x:Key="StatusIncompleteBg" Color="{StaticResource NeutralBgColor}" />
      <SolidColorBrush x:Key="StatusUndeterminedFg" Color="{StaticResource VioletFgColor}" />
      <SolidColorBrush x:Key="StatusUndeterminedBg" Color="{StaticResource VioletBgColor}" />
      <!-- The result dots in tables (Mac system hues; a dot needs no text contrast, it sits beside the result's name) -->
      <SolidColorBrush x:Key="StatusSubstantialDot" Color="#FF3B30" />
      <SolidColorBrush x:Key="StatusCloseDot" Color="#FF9500" />
      <SolidColorBrush x:Key="StatusNotSubstantialDot" Color="#34C759" />
      <SolidColorBrush x:Key="StatusIncompleteDot" Color="#8E8E93" />
      <SolidColorBrush x:Key="StatusUndeterminedDot" Color="#AF52DE" />
      <SolidColorBrush x:Key="RequiredFg" Color="{StaticResource DangerFgColor}" />
      <SolidColorBrush x:Key="RecommendedFg" Color="{StaticResource WarningFgColor}" />
      <SolidColorBrush x:Key="SuggestedFg" Color="{StaticResource SuccessFgColor}" />
      <!-- Focus halo around inputs and the focused-control ring -->
      <BoxShadows x:Key="FocusHalo">0 0 0 3 #730A64D6</BoxShadows>
      <BoxShadows x:Key="ShadowPopup">0 6 20 0 #29000000</BoxShadows>
      <BoxShadows x:Key="ShadowSheet">0 10 30 0 #40000000</BoxShadows>
      <BoxShadows x:Key="ShadowCard">0 0 0 0 #00000000</BoxShadows>
      <!-- The bezel under a push button, a pop-up button and the selected segment (Mac controls sit slightly raised) -->
      <BoxShadows x:Key="ShadowControl">0 0.5 1.5 0 #24000000</BoxShadows>
      <!-- Mac surfaces with no WCAG text pair: the selected source-list row and a segmented control's track -->
      <SolidColorBrush x:Key="SidebarSelection" Color="#D9D9D9" />
      <SolidColorBrush x:Key="SegmentedTrack" Color="#E6E6E7" />
      <SolidColorBrush x:Key="ControlFill" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ControlFillPressed" Color="#EBEBEB" />
      <!-- Fluent's resource keys, pointed at the tokens -->
      <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource BgSurfaceColor}" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource BgHoverColor}" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource BgPressedColor}" />
      <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{StaticResource BgSubtleColor}" />
      <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource TextPrimaryColor}" />
      <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource TextPrimaryColor}" />
      <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource TextPrimaryColor}" />
      <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource TextDisabledColor}" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource BorderStrongColor}" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource BorderStrongHoverColor}" />
      <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource BorderStrongHoverColor}" />
      <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{StaticResource BorderDefaultColor}" />
      <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource AccentFillColor}" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource AccentFillHoverColor}" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource AccentFillPressedColor}" />
      <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="{StaticResource BgSubtleColor}" />
      <SolidColorBrush x:Key="AccentButtonForeground" Color="{StaticResource OnAccentColor}" />
      <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{StaticResource OnAccentColor}" />
      <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{StaticResource OnAccentColor}" />
      <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="{StaticResource TextDisabledColor}" />
      <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="{StaticResource AccentFillColor}" />
      <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="{StaticResource AccentFillHoverColor}" />
      <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="{StaticResource AccentFillPressedColor}" />
      <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="{StaticResource BorderDefaultColor}" />
      <SolidColorBrush x:Key="RepeatButtonBackground" Color="{StaticResource BgSurfaceColor}" />
      <SolidColorBrush x:Key="RepeatButtonBackgroundPointerOver" Color="{StaticResource BgHoverColor}" />
      <SolidColorBrush x:Key="RepeatButtonBackgroundPressed" Color="{StaticResource BgPressedColor}" />
      <SolidColorBrush x:Key="RepeatButtonBackgroundDisabled" Color="{StaticResource BgSubtleColor}" />
      <SolidColorBrush x:Key="RepeatButtonForeground" Color="{StaticResource TextPrimaryColor}" />
      <SolidColorBrush x:Key="RepeatButtonForegroundPointerOver" Color="{StaticResource TextPrimaryColor}" />
      <SolidColorBrush x:Key="RepeatButtonForegroundPressed" Color="{StaticResource TextPrimaryColor}" />
      <SolidColorBrush x:Key="RepeatButtonForegroundDisabled" Color="{StaticResource TextDisabledColor}" />
      <SolidColorBrush x:Key="RepeatButtonBorderBrush" Color="{StaticResource BorderStrongColor}" />
      <SolidColorBrush x:Key="RepeatButtonBorderBrushPointerOver" Color="{StaticResource BorderStrongHoverColor}" />
      <SolidColorBrush x:Key="RepeatButtonBorderBrushPressed" Color="{StaticResource BorderStrongHoverColor}" />
      <SolidColorBrush x:Key="RepeatButtonBorderBrushDisabled" Color="{StaticResource BorderDefaultColor}" />
      <SolidColorBrush x:Key="ToggleButtonBackground" Color="{StaticResource BgSurfaceColor}" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{StaticResource BgHoverColor}" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{StaticResource BgPressedColor}" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="{StaticResource BgSubtleColor}" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{StaticResource AccentSoftColor}" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{StaticResource AccentSoftHoverColor}" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{StaticResource AccentSoftHoverColor}" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="{StaticResource BgSubtleColor}" />
      <SolidColorBrush x:Key="ToggleButtonForeground" Color="{StaticResource TextPrimaryColor}" />
      <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="{StaticResource TextPrimaryColor}" />
      <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="{StaticResource TextPrimaryColor}" />
      <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="{StaticResource TextDisabledColor}" />
      <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="{StaticResource TextDisabledColor}" />
      <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="{StaticResource BorderStrongColor}" />
      <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="{StaticResource BorderStrongHoverColor}" />
      <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="{StaticResource BorderStrongHoverColor}" />
      <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="{StaticResource BorderDefaultColor}" />
      <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="{StaticResource BorderDefaultColor}" />
      <SolidColorBrush x:Key="SplitButtonBackground" Color="{StaticResource BgSurfaceColor}" />
      <SolidColorBrush x:Key="SplitButtonBackgroundPointerOver" Color="{StaticResource BgHoverColor}" />
      <SolidColorBrush x:Key="SplitButtonBackgroundPressed" Color="{StaticResource BgPressedColor}" />
      <SolidColorBrush x:Key="SplitButtonBackgroundDisabled" Color="{StaticResource BgSubtleColor}" />
      <SolidColorBrush x:Key="SplitButtonForeground" Color="{StaticResource TextPrimaryColor}" />
      <SolidColorBrush x:Key="SplitButtonForegroundPointerOver" Color="{StaticResource TextPrimaryColor}" />
      <SolidColorBrush x:Key="SplitButtonForegroundPressed" Color="{StaticResource TextPrimaryColor}" />
      <SolidColorBrush x:Key="SplitButtonForegroundDisabled" Color="{StaticResource TextDisabledColor}" />
      <SolidColorBrush x:Key="SplitButtonBorderBrush" Color="{StaticResource BorderStrongColor}" />
      <SolidColorBrush x:Key="SplitButtonBorderBrushPointerOver" Color="{StaticResource BorderStrongHoverColor}" />
      <SolidColorBrush x:Key="SplitButtonBorderBrushPressed" Color="{StaticResource BorderStrongHoverColor}" />
      <SolidColorBrush x:Key="SplitButtonBorderBrushDisabled" Color="{StaticResource BorderDefaultColor}" />
      <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource TextPrimaryColor}" />
      <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource TextPrimaryColor}" />
      <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource TextPrimaryColor}" />
      <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{StaticResource TextDisabledColor}" />
      <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource BgSurfaceColor}" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource BgSurfaceColor}" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource BgSurfaceColor}" />
      <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{StaticResource BgSubtleColor}" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource BorderStrongColor}" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource BorderStrongHoverColor}" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource FocusColor}" />
      <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="{StaticResource BorderDefaultColor}" />
      <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource TextTertiaryColor}" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{StaticResource TextTertiaryColor}" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{StaticResource TextTertiaryColor}" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="{StaticResource TextDisabledColor}" />
      <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource AccentFillColor}" />
      <SolidColorBrush x:Key="TextControlButtonForeground" Color="{StaticResource TextSecondaryColor}" />
      <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="{StaticResource TextPrimaryColor}" />
      <SolidColorBrush x:Key="TextControlButtonForegroundPressed" Color="{StaticResource TextPrimaryColor}" />
      <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource BgSurfaceColor}" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource BgSurfaceColor}" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource BgSubtleColor}" />
      <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{StaticResource BgSubtleColor}" />
      <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="{StaticResource BgSurfaceColor}" />
      <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="{StaticResource FocusColor}" />
      <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushUnfocused" Color="{StaticResource BorderStrongColor}" />
      <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource TextPrimaryColor}" />
      <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{StaticResource TextDisabledColor}" />
      <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="{StaticResource TextPrimaryColor}" />
