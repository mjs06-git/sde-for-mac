<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Sde.App.Controls">
  <!--
    The Structures page's own pieces (3.5): the filter bar above the table (Add Filter, a neutral outlined chip per
    filter with a small editor, Clear), tag chips (a colour dot and the name on a neutral chip, in the Tags column and
    the inspector), the tag colour swatches, and the Submission Folder sheet's groups. Chips are never tinted: the
    only colour on a tag is its dot (the TagColour tokens).
  -->

  <!-- The filter bar: the scope bar's place, growing a line when the chips need it -->
  <Style Selector="Border.scopeBar.filterBar">
    <Setter Property="Height" Value="NaN" />
    <Setter Property="MinHeight" Value="{DynamicResource ScopeBarHeight}" />
    <Setter Property="Padding" Value="20,4" />
  </Style>
  <Style Selector="WrapPanel.filterChips > :is(Control)">
    <Setter Property="Margin" Value="0,2,6,2" />
  </Style>
  <Style Selector="ItemsControl.filterChipList">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <WrapPanel Classes="filterChips" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ItemsControl.filterChipList ContentPresenter">
    <Setter Property="Margin" Value="0,2,6,2" />
  </Style>

  <!-- A filter's chip: white, a hairline border and the control radius; its label opens the editor, its × removes it -->
  <Style Selector="Border.filterChip">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowControl}" />
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightSmall}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.filterChip Button.filterChipLabel">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,1,4,1" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="CornerRadius" Value="6,0,0,6" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.filterChip Button.filterChipLabel /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Border.filterChip Button.filterChipLabel:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.filterChip Button.filterChipLabel:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgPressed}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="TextBlock.filterChipTitle">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="Border.filterChip Button.filterChipRemove">
    <Setter Property="Width" Value="20" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0,6,6,0" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.filterChip Button.filterChipRemove /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="Border.filterChip Button.filterChipRemove:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Border.filterChip Border.chipDivider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BorderDefault}" />
    <Setter Property="Margin" Value="0,4" />
  </Style>
  <!-- A chip's editor (the popover under it) -->
  <Style Selector="StackPanel.filterEditor">
    <Setter Property="Spacing" Value="8" />
    <Setter Property="MinWidth" Value="220" />
    <Setter Property="Margin" Value="4" />
  </Style>
  <Style Selector="Grid.filterEditor">
    <Setter Property="Margin" Value="4" />
  </Style>
  <Style Selector="ListBox.filterChoices">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MaxHeight" Value="300" />
    <Setter Property="MinWidth" Value="200" />
  </Style>
  <Style Selector="ListBox.filterChoices ListBoxItem">
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
  </Style>
  <!-- Add Filter's list of fields -->
  <Style Selector="ItemsControl.filterFields Button">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>

  <!-- A tag: a colour dot and the name on a neutral chip (the dot is the only colour) -->
  <Style Selector="Border.tagChip">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="Padding" Value="6,1,7,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.tagChip TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.tagChip Ellipse.dot, Border.tagChip Ellipse.tagDot">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
  </Style>
  <Style Selector="Ellipse.tagDot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A selected row keeps its tag chips readable -->
  <Style Selector="DataGridRow:selected Border.tagChip">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
  </Style>
  <!-- The inspector's tags, with a small × on each -->
  <Style Selector="Border.tagChip.removable">
    <Setter Property="Padding" Value="6,0,2,0" />
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightSmall}" />
  </Style>
  <Style Selector="Border.tagChip Button.icon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="WrapPanel.tagWrap > :is(Control)">
    <Setter Property="Margin" Value="0,0,6,6" />
  </Style>
  <Style Selector="ItemsControl.tagWrapList ContentPresenter">
    <Setter Property="Margin" Value="0,0,6,6" />
  </Style>

  <!-- The six tag colours to choose from: a dot each, the chosen one ringed -->
  <Style Selector="Button.swatch">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.swatch /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
  </Style>
  <Style Selector="Button.swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.swatchRing">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.swatchRing.chosen">
    <Setter Property="BorderBrush" Value="{DynamicResource Focus}" />
  </Style>
  <Style Selector="Border.swatchRing Ellipse">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Manage Tags: one row per tag -->
  <Style Selector="Border.tagRow">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Button.dotButton">
    <Setter Property="Width" Value="{DynamicResource ControlHeight}" />
    <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.dotButton Ellipse">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
  </Style>

  <!-- The Submission Folder sheet: titled groups of choices on the sheet, and the warnings after a run -->
  <Style Selector="StackPanel.sheetGroup">
    <Setter Property="Spacing" Value="6" />
  </Style>
  <Style Selector="Border.warningList">
    <Setter Property="Background" Value="{DynamicResource WarningBg}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Border.warningList TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.warningList c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource WarningFg}" />
  </Style>
</Styles>
