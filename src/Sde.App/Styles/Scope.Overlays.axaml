<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Sde.App.Controls">
  <!--
    Styles that only ever apply inside the drop overlay and the command palette, so they are included there rather than in App.axaml.
    Avalonia tries every app-wide style on every new control, so keeping these out of App.axaml keeps the
    Structures table and the map quick to draw. Put a style here only when its classes are used nowhere else.
  -->
  <!-- From Styles/AppLevel.axaml -->
  <!-- ───────────── The drop overlay ───────────── -->
  <Style Selector="Border.dropOverlay">
    <Setter Property="Background" Value="{DynamicResource BgOverlay}" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style Selector="Rectangle.dropEdge">
    <Setter Property="Stroke" Value="{DynamicResource AccentFill}" />
    <Setter Property="StrokeThickness" Value="3" />
    <Setter Property="StrokeDashArray" Value="4,3" />
    <Setter Property="RadiusX" Value="16" />
    <Setter Property="RadiusY" Value="16" />
    <Setter Property="Margin" Value="16" />
  </Style>

  <Style Selector="Border.dropOverlay.refused Rectangle.dropEdge">
    <Setter Property="Stroke" Value="{DynamicResource BorderStrong}" />
  </Style>

  <Style Selector="Border.dropPanel">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderCard}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSheet}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowSheet}" />
    <Setter Property="Padding" Value="40,32,40,32" />
    <Setter Property="MinWidth" Value="420" />
    <Setter Property="MaxWidth" Value="560" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.dropHeading">
    <Setter Property="FontSize" Value="{StaticResource FontSizeLargeTitle}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.dropLine">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- From Styles/Sheets.axaml -->
  <!-- The command palette: a white card over the dimmed window, a large search line, rows with the choice in the soft accent -->
  <Style Selector="Border.palette">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderCard}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSheet}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowSheet}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.paletteFooter">
    <Setter Property="Background" Value="{DynamicResource BgTableHeader}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="16,10" />
  </Style>

  <Style Selector="ListBox.palette">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8,4,8,8" />
  </Style>

  <Style Selector="ListBox.palette ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ListBox.palette ListBoxItem /template/ ContentPresenter#PART_ContentPresenter, ListBox.palette ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.palette ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.palette ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.palette ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter, ListBox.palette ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="TextBlock.paletteGroup">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="Margin" Value="12,12,12,4" />
  </Style>

  <Style Selector="Border.paletteRow">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="MinHeight" Value="{DynamicResource TableRowHeight}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.paletteRow c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>

  <Style Selector="ListBox.palette ListBoxItem:pointerover Border.paletteRow">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
  </Style>

  <Style Selector="ListBox.palette ListBoxItem:selected Border.paletteRow">
    <Setter Property="Background" Value="{DynamicResource RowSelectedFill}" />
  </Style>

  <Style Selector="ListBox.palette ListBoxItem:selected Border.paletteRow c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
</Styles>
