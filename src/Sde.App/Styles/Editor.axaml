<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Sde.App.Controls">
  <!--
    The assessment editor.
      Border.editorBar (the strip under the title band: what the structure is, save state and the actions);
      ListBox.steps (the sidebar's outline while an assessment is open: Border.stepBadge round numbers, the current
      step in the accent, a step with required problems in red, and Border.stepCount);
      Border.formGroup (a group of fields: a white sheet on the paper page with its heading inside);
      Border.resultPanel (the live result on the right) with Border.resultHero (the percent, the verdict and the
      c:StaffGauge) and Border.resultCard; Border.dropZone (photos); Border.tableRow (a row of the damage and cost
      tables) with Button.tick (the 0 to 100 presets under a damage slider).
  -->

  <!-- The strip under the title band -->
  <Style Selector="Border.editorBar">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="20,0,16,0" />
    <Setter Property="Height" Value="46" />
  </Style>

  <!-- The step rail: a source list of the steps -->
  <Style Selector="Border.stepRail">
    <Setter Property="Width" Value="212" />
    <Setter Property="Background" Value="{DynamicResource BgApp}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="Grid.narrow Border.stepRail">
    <Setter Property="Width" Value="64" />
  </Style>
  <Style Selector="Grid.narrow StackPanel.stepText">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ListBox.steps">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Margin" Value="10,12" />
  </Style>
  <Style Selector="ListBox.steps ListBoxItem">
    <Setter Property="Padding" Value="6,0,8,0" />
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
  </Style>
  <Style Selector="ListBox.steps ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.steps ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
  </Style>
  <Style Selector="ListBox.steps ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.steps ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.steps ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter, ListBox.steps ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>
  <Style Selector=".motion ListBox.steps ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <!-- The step's icon, tinted like the sidebar's (no tile) -->
  <Style Selector="Border.stepIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.stepIcon c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- The section's number in the sidebar outline: a small ring with the number in it; filled with the accent for the
       step showing, red for a step with required problems -->
  <Style Selector="ListBox.steps Border.stepBadge">
    <Setter Property="Width" Value="{DynamicResource StepBadgeSize}" />
    <Setter Property="Height" Value="{DynamicResource StepBadgeSize}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.steps TextBlock.stepNumber">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.steps Border.stepBadge.required">
    <Setter Property="BorderBrush" Value="{DynamicResource DangerFg}" />
  </Style>
  <Style Selector="ListBox.steps Border.stepBadge.required TextBlock.stepNumber">
    <Setter Property="Foreground" Value="{DynamicResource DangerFg}" />
  </Style>
  <Style Selector="ListBox.steps ListBoxItem:selected Border.stepBadge">
    <Setter Property="Background" Value="{DynamicResource AccentFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFill}" />
  </Style>
  <Style Selector="ListBox.steps ListBoxItem:selected Border.stepBadge.required">
    <Setter Property="Background" Value="{DynamicResource DangerFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerFill}" />
  </Style>
  <Style Selector="ListBox.steps ListBoxItem:selected TextBlock.stepNumber">
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <!-- A group of fields in a step: a white sheet on the paper page, its heading inside in navy semibold -->
  <Style Selector="Border.formGroup">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderCard}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowCard}" />
    <Setter Property="Padding" Value="24,20,24,24" />
    <Setter Property="Margin" Value="0,0,0,20" />
  </Style>
  <Style Selector="Border.formGroup TextBlock.h3">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <!-- A group inside a group (the Result step's inputs) is part of its sheet: no second box -->
  <Style Selector="Border.formGroup Border.formGroup">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <!-- The step's title above its sheets -->
  <Style Selector="TextBlock.stepHeading">
    <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.3" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Margin" Value="2,0,0,20" />
  </Style>
  <Style Selector="ListBox.steps TextBlock.stepTitle">
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="ListBox.steps ListBoxItem:selected TextBlock.stepTitle">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <!-- How many fields to check: a small grey capsule (red text when some are required) -->
  <Style Selector="Border.stepCount">
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="Height" Value="16" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="Background" Value="{DynamicResource BgPressed}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.stepCount TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.stepCount.required">
    <Setter Property="Background" Value="{DynamicResource DangerBg}" />
  </Style>
  <Style Selector="Border.stepCount.required TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DangerFg}" />
  </Style>
  <Style Selector="Grid.narrow Border.stepCount">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="TextBlock.stepStatus">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.stepStatus.done">
    <Setter Property="Foreground" Value="{DynamicResource SuccessFg}" />
  </Style>
  <Style Selector="TextBlock.stepStatus.check">
    <Setter Property="Foreground" Value="{DynamicResource WarningFg}" />
  </Style>
  <Style Selector="TextBlock.stepStatus.required">
    <Setter Property="Foreground" Value="{DynamicResource DangerFg}" />
  </Style>
  <!-- A dot on the step's icon when something needs attention, for the icons-only rail -->
  <Style Selector="Ellipse.stepDot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,-2,-2,0" />
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Stroke" Value="{DynamicResource BgSidebar}" />
    <Setter Property="StrokeThickness" Value="1.5" />
  </Style>
  <Style Selector="Grid.narrow Ellipse.stepDot.check">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Fill" Value="{DynamicResource WarningFg}" />
  </Style>
  <Style Selector="Grid.narrow Ellipse.stepDot.required">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Fill" Value="{DynamicResource DangerFg}" />
  </Style>

  <!-- The live result on the right: a column on the page background, the result hero (Controls/ResultHero) at its top
       and white cards under it -->
  <Style Selector="Border.resultPanel">
    <Setter Property="Width" Value="{StaticResource InspectorWidth}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!-- Rows of the editor's tables (damage by element, cost adjustments) -->
  <Style Selector="Border.tableRow">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="0,2" />
    <Setter Property="MinHeight" Value="36" />
  </Style>
  <Style Selector="Border.tableHead">
    <Setter Property="Padding" Value="0,0,0,6" />
  </Style>
  <!-- A column heading in the editor's tables (sentence case, quiet) -->
  <Style Selector="TextBlock.colHead">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
  </Style>
  <Style Selector="Border.tableFoot">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="0,10,0,0" />
  </Style>

  <!-- 0, 25, 50, 75, 100 under a damage slider: small, quiet, clickable; left out when the editor is narrow -->
  <Style Selector="Grid.narrow c|TickPanel">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Button.tick">
    <Setter Property="Padding" Value="3,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.tick /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
  </Style>
  <Style Selector="Button.tick:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.tick:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <!-- Where photos are dropped -->
  <Style Selector="Border.dropZone">
    <Setter Property="Background" Value="{DynamicResource BgSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="Padding" Value="20,18" />
  </Style>
  <!-- ───────────── The step outline on the frame (the sidebar while an assessment is open) ───────────── -->
  <!-- The steps as rows on the navy: quiet light titles, the frame's hover, the step showing on a lighter navy row -->
  <Style Selector="Border.sidebar ListBox.steps">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Margin" Value="10,12" />
  </Style>
  <Style Selector="Border.sidebar ListBox.steps ListBoxItem">
    <Setter Property="Padding" Value="8,0,10,0" />
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightLarge}" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
  </Style>
  <Style Selector="Border.sidebar ListBox.steps ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.sidebar ListBox.steps ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgFrameHover}" />
  </Style>
  <!-- The step showing: a lighter navy row behind the accent badge and the white title -->
  <Style Selector="Border.sidebar ListBox.steps ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, Border.sidebar ListBox.steps ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, Border.sidebar ListBox.steps ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter, Border.sidebar ListBox.steps ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgFramePressed}" />
  </Style>
  <!-- The section's number in the outline on the frame: a ring; the step showing has a solid accent badge with a
       white number; a step with required problems is marked in the frame's red; a finished step is quieter still -->
  <Style Selector="Border.sidebar ListBox.steps Border.stepBadge">
    <Setter Property="Width" Value="{DynamicResource StepBadgeSize}" />
    <Setter Property="Height" Value="{DynamicResource StepBadgeSize}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextOnFrameTertiary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.sidebar ListBox.steps TextBlock.stepNumber">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnFrameSecondary}" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.sidebar ListBox.steps Border.stepBadge.done">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderFrame}" />
    <Setter Property="Background" Value="{DynamicResource BgFrameField}" />
  </Style>
  <Style Selector="Border.sidebar ListBox.steps Border.stepBadge.done TextBlock.stepNumber">
    <Setter Property="Foreground" Value="{DynamicResource TextOnFrameTertiary}" />
  </Style>
  <Style Selector="Border.sidebar ListBox.steps Border.stepBadge.required">
    <Setter Property="BorderBrush" Value="{DynamicResource DangerOnFrame}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.sidebar ListBox.steps Border.stepBadge.required TextBlock.stepNumber">
    <Setter Property="Foreground" Value="{DynamicResource DangerOnFrame}" />
  </Style>
  <Style Selector="Border.sidebar ListBox.steps ListBoxItem:selected Border.stepBadge">
    <Setter Property="Background" Value="{DynamicResource AccentFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFill}" />
  </Style>
  <Style Selector="Border.sidebar ListBox.steps ListBoxItem:selected Border.stepBadge.required">
    <Setter Property="Background" Value="{DynamicResource DangerFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerFill}" />
  </Style>
  <Style Selector="Border.sidebar ListBox.steps ListBoxItem:selected TextBlock.stepNumber">
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="Border.sidebar ListBox.steps TextBlock.stepTitle">
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnFrameSecondary}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="Border.sidebar ListBox.steps ListBoxItem:pointerover TextBlock.stepTitle">
    <Setter Property="Foreground" Value="{DynamicResource TextOnFrame}" />
  </Style>
  <Style Selector="Border.sidebar ListBox.steps ListBoxItem:selected TextBlock.stepTitle">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnFrame}" />
  </Style>
  <!-- How many fields to check: a quiet number on the frame, in the frame's red when some are required -->
  <Style Selector="Border.sidebar Border.stepCount">
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Background" Value="{DynamicResource BgFrameField}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.sidebar Border.stepCount TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnFrameSecondary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.sidebar Border.stepCount.required TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DangerOnFrame}" />
  </Style>
</Styles>
