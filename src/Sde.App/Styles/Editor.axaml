<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Sde.App.Controls">
  <!--
    The assessment editor.
      Border.editorBar (the strip under the title band: what the structure is, save state and the actions);
      ListBox.steps (the sidebar's outline while an assessment is open: Border.stepBadge round numbers, the current
      step in the accent, a step with required problems in red, and Border.stepCount);
      Border.formGroup (a group of fields: a white sheet on the paper page with its heading inside);
      Border.resultPanel (the live result on the right) with Border.resultHero (the percent, the verdict and the
      c:StaffGauge) and Border.resultCard; Border.dropZone (photos); Border.tableRow (a row of the damage and cost
      tables) with Button.tick (the 0 to 100 presets under a damage slider).
    The styles used only inside one area are in Styles/Scope.Data.axaml, Styles/Scope.Editor.axaml and
    Styles/Scope.Frame.axaml, included where that area is shown; this file keeps the ones used elsewhere too.
  -->

  <!-- The strip under the title band -->
  <Style Selector="Border.editorBar">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="20,0,16,0" />
    <Setter Property="Height" Value="46" />
  </Style>

  <!-- The step rail: a source list of the steps -->
  <Style Selector="Border.stepRail">
    <Setter Property="Width" Value="212" />
    <Setter Property="Background" Value="{DynamicResource BgApp}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="Grid.narrow Border.stepRail">
    <Setter Property="Width" Value="64" />
  </Style>
  <Style Selector="Grid.narrow StackPanel.stepText">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ListBox.steps">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Margin" Value="10,12" />
  </Style>
  <Style Selector="ListBox.steps ListBoxItem">
    <Setter Property="Padding" Value="6,0,8,0" />
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
  </Style>
  <Style Selector="ListBox.steps ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.steps ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
  </Style>
  <Style Selector="ListBox.steps ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.steps ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.steps ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter, ListBox.steps ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>
  <Style Selector=":is(Window).motion ListBox.steps ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.steps TextBlock.stepTitle">
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="ListBox.steps ListBoxItem:selected TextBlock.stepTitle">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Grid.narrow Border.stepCount">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="TextBlock.stepStatus">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.stepStatus.done">
    <Setter Property="Foreground" Value="{DynamicResource SuccessFg}" />
  </Style>
  <Style Selector="TextBlock.stepStatus.check">
    <Setter Property="Foreground" Value="{DynamicResource WarningFg}" />
  </Style>
  <Style Selector="TextBlock.stepStatus.required">
    <Setter Property="Foreground" Value="{DynamicResource DangerFg}" />
  </Style>
  <!-- A dot on the step's icon when something needs attention, for the icons-only rail -->
  <Style Selector="Ellipse.stepDot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,-2,-2,0" />
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Stroke" Value="{DynamicResource BgSidebar}" />
    <Setter Property="StrokeThickness" Value="1.5" />
  </Style>
  <Style Selector="Grid.narrow Ellipse.stepDot.check">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Fill" Value="{DynamicResource WarningFg}" />
  </Style>
  <Style Selector="Grid.narrow Ellipse.stepDot.required">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Fill" Value="{DynamicResource DangerFg}" />
  </Style>

  <!-- A column heading in the editor's tables (sentence case, quiet) -->
  <Style Selector="TextBlock.colHead">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
  </Style>

  <!-- 0, 25, 50, 75, 100 under a damage slider: small, quiet, clickable; left out when the editor is narrow -->
  <Style Selector="Grid.narrow c|TickPanel">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Button.tick">
    <Setter Property="Padding" Value="3,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.tick /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
  </Style>
  <Style Selector="Button.tick:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.tick:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <!-- Where photos are dropped -->
  <Style Selector="Border.dropZone">
    <Setter Property="Background" Value="{DynamicResource BgSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="Padding" Value="20,18" />
  </Style>
</Styles>
