<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Sde.App.Controls">
  <!--
    The Workflow pages (Review, Compliance, Assignments, Agenda) and Recently Deleted.
      c:ListDetailPage: the shared layout of a list page with an inspector: an optional filter strip (a scope bar on
      the paper), the list, a status line under it and the inspector column at the right, as wide as the shared
      inspector width with its drag handle. StackPanel.inspectorStack is the column of cards inside the inspector.
      ToggleButton.filterChip: a small on/off filter in a scope bar ("Overdue", "Due soon"); on, it is the soft accent.
      Border.groupCard: a white card holding a titled group of rows (Review's checks by rule, the Agenda's weeks);
      Border.cardRow: one row inside it, hairline above; Button.cardRow: the same row, clickable.
      Border.listCard with Border.cardFooter: a list in a card with the +/- buttons under it (Assignments' teams).
      Border.quietGroup: the checks that could not run, quieter than the cards of findings.
    The styles used only inside one area are in Styles/Scope.Records.axaml and Styles/Scope.Sheets.axaml, included where
    that area is shown; this file keeps the ones used elsewhere too.
  -->

  <!-- The list page with an inspector -->
  <Style Selector="c|ListDetailPage">
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="scopeBar onPaper" IsVisible="{TemplateBinding FilterBar, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentPresenter Content="{TemplateBinding FilterBar}" VerticalAlignment="Center" />
          </Border>
          <Border DockPanel.Dock="Top" Classes="listTopSpace" IsVisible="{TemplateBinding FilterBar, Converter={x:Static ObjectConverters.IsNull}}" />
          <Grid ColumnDefinitions="*,Auto">
            <DockPanel>
              <Border DockPanel.Dock="Bottom" Classes="statusBar onPaper">
                <ContentPresenter Content="{TemplateBinding Status}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ContentPresenter Content="{TemplateBinding Content}" />
            </DockPanel>
            <Border Grid.Column="1" Classes="inspectorColumn" Name="PART_Inspector"
                    IsVisible="{TemplateBinding IsInspectorVisible}" Width="{TemplateBinding InspectorWidth}">
              <ContentPresenter Content="{TemplateBinding Inspector}" />
            </Border>
            <c:ResizeHandle Grid.Column="1" Classes="inspectorEdge" Name="PART_InspectorResizer" IsVisible="{TemplateBinding IsInspectorVisible}" GrowsRight="False"
                            Value="{Binding InspectorWidth, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            ResetCommand="{TemplateBinding ResetInspectorWidthCommand}" />
          </Grid>
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- Without a filter strip the list still starts below the frame's edge, as far down as a scope bar would leave it -->
  <Style Selector="Border.listTopSpace">
    <Setter Property="Height" Value="{StaticResource Space20}" />
  </Style>

  <!-- A small on/off filter -->
  <Style Selector="ToggleButton.filterChip">
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightSmall}" />
    <Setter Property="Padding" Value="10,1" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.filterChip:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.filterChip:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.filterChip:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- The group's heading row: the title and, at the right, how many -->
  <Style Selector="Grid.groupHead">
    <Setter Property="Margin" Value="20,0,20,10" />
  </Style>
  <!-- A row's quiet second line (an assessment check's message, an entry's address) -->
  <Style Selector="TextBlock.rowDetail">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- The Agenda's hero band: the two figures on the right of the headline -->
  <Style Selector="TextBlock.heroSub">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnHeroSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

</Styles>
