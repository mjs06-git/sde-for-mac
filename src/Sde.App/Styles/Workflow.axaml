<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Sde.App.Controls">
  <!--
    The Workflow pages (Review, Compliance, Assignments, Agenda) and Recently Deleted.
      c:ListDetailPage: the shared layout of a list page with an inspector: an optional filter strip (a scope bar on
      the paper), the list, a status line under it and the inspector column at the right, as wide as the shared
      inspector width with its drag handle. StackPanel.inspectorStack is the column of cards inside the inspector.
      ToggleButton.filterChip: a small on/off filter in a scope bar ("Overdue", "Due soon"); on, it is the soft accent.
      Border.groupCard: a white card holding a titled group of rows (Review's checks by rule, the Agenda's weeks);
      Border.cardRow: one row inside it, hairline above; Button.cardRow: the same row, clickable.
      Border.listCard with Border.cardFooter: a list in a card with the +/- buttons under it (Assignments' teams).
      Border.quietGroup: the checks that could not run, quieter than the cards of findings.
  -->

  <!-- The list page with an inspector -->
  <Style Selector="c|ListDetailPage">
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="scopeBar onPaper" IsVisible="{TemplateBinding FilterBar, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentPresenter Content="{TemplateBinding FilterBar}" VerticalAlignment="Center" />
          </Border>
          <Border DockPanel.Dock="Top" Classes="listTopSpace" IsVisible="{TemplateBinding FilterBar, Converter={x:Static ObjectConverters.IsNull}}" />
          <Grid ColumnDefinitions="*,Auto">
            <DockPanel>
              <Border DockPanel.Dock="Bottom" Classes="statusBar onPaper">
                <ContentPresenter Content="{TemplateBinding Status}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ContentPresenter Content="{TemplateBinding Content}" />
            </DockPanel>
            <Border Grid.Column="1" Classes="inspectorColumn" Name="PART_Inspector"
                    IsVisible="{TemplateBinding IsInspectorVisible}" Width="{TemplateBinding InspectorWidth}">
              <ContentPresenter Content="{TemplateBinding Inspector}" />
            </Border>
            <c:ResizeHandle Grid.Column="1" Classes="inspectorEdge" Name="PART_InspectorResizer" IsVisible="{TemplateBinding IsInspectorVisible}" GrowsRight="False"
                            Value="{Binding InspectorWidth, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            ResetCommand="{TemplateBinding ResetInspectorWidthCommand}" />
          </Grid>
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- Without a filter strip the list still starts below the frame's edge, as far down as a scope bar would leave it -->
  <Style Selector="Border.listTopSpace">
    <Setter Property="Height" Value="{StaticResource Space20}" />
  </Style>
  <!-- The status line's text (its content belongs to the page, so it is marked pageStatus rather than found under the
       status bar): the status bar's small grey type -->
  <Style Selector=":is(Control).pageStatus TextBlock, TextBlock.pageStatus">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(Control).pageStatus Button.link">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
  </Style>
  <!-- The inspector's cards, one above the other, clear of the window's edge -->
  <Style Selector="StackPanel.inspectorStack">
    <Setter Property="Spacing" Value="14" />
    <Setter Property="Margin" Value="0,0,20,20" />
  </Style>
  <!-- A filter strip's controls, left to right -->
  <Style Selector="StackPanel.filterRow">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="6" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A scrolling page of cards (Review's checks, the Agenda): the page padding around a column of cards -->
  <Style Selector="StackPanel.cardColumn">
    <Setter Property="Spacing" Value="16" />
    <Setter Property="Margin" Value="20,0,20,24" />
  </Style>

  <!-- A small on/off filter -->
  <Style Selector="ToggleButton.filterChip">
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightSmall}" />
    <Setter Property="Padding" Value="10,1" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.filterChip:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.filterChip:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.filterChip:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- A titled group of rows on a white card -->
  <Style Selector="Border.groupCard">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderCard}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowCard}" />
    <Setter Property="Padding" Value="0,14,0,4" />
  </Style>
  <!-- The group's heading row: the title and, at the right, how many -->
  <Style Selector="Grid.groupHead">
    <Setter Property="Margin" Value="20,0,20,10" />
  </Style>
  <Style Selector="TextBlock.groupTitle">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSubheadline}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- The Agenda's Overdue group: its title in the danger red, and its rows' icons -->
  <Style Selector="TextBlock.groupTitle.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerFg}" />
  </Style>
  <Style Selector="Button.cardRow c|Icon.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerFg}" />
  </Style>
  <Style Selector="TextBlock.groupCount">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A row inside a group card: a hairline above, the card's inset -->
  <Style Selector="Border.cardRow">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="20,9" />
    <Setter Property="MinHeight" Value="{DynamicResource TableRowHeight}" />
  </Style>
  <!-- The same row as a button (an Agenda entry opens its case or assessment): flat, the hover tint, full width -->
  <Style Selector="Button.cardRow">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="20,9" />
    <Setter Property="MinHeight" Value="{DynamicResource TableRowHeight}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
  </Style>
  <Style Selector="Button.cardRow /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.cardRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.cardRow:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgPressed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <!-- A row's quiet second line (an assessment check's message, an entry's address) -->
  <Style Selector="TextBlock.rowDetail">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <!-- An Agenda row's date column: tabular, a fixed width so the titles line up -->
  <Style Selector="TextBlock.rowDate">
    <Setter Property="Width" Value="92" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- The checks that could not run: a plain card on the paper's grey, no shadow -->
  <Style Selector="Border.quietGroup">
    <Setter Property="Background" Value="{DynamicResource BgSubtle}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="Padding" Value="20,14" />
  </Style>

  <!-- One check in the Review inspector: the icon, the title with a short line under it, and Show -->
  <Style Selector="Grid.checkRow">
    <Setter Property="ColumnSpacing" Value="10" />
  </Style>
  <Style Selector="Grid.checkRow c|Icon">
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <!-- A list in a card with +/- under it -->
  <Style Selector="Border.listCard">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderCard}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowCard}" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>
  <Style Selector="Border.cardFooter">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="6,4" />
  </Style>
  <!-- The team list's rows inside its card -->
  <Style Selector="ListBox.teamList ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="6,2" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
  </Style>
  <Style Selector="ListBox.teamList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.teamList ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.teamList ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>
  <Style Selector="ListBox.teamList">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0,6" />
  </Style>
  <Style Selector="Border.teamRow">
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <!-- A team's colour chip -->
  <Style Selector="Border.teamChip">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="Margin" Value="0,3,0,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <!-- The Assignments page: the teams card on the left of the route table -->
  <Style Selector="Border.teamsColumn">
    <Setter Property="Width" Value="224" />
    <Setter Property="Margin" Value="20,0,0,0" />
  </Style>

  <!-- The Agenda's hero band: the two figures on the right of the headline -->
  <Style Selector="TextBlock.heroSub">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnHeroSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.agendaHero">
    <Setter Property="Margin" Value="20,20,20,0" />
  </Style>

  <!-- The merge sheet: the two structures side by side, each a choosable card -->
  <Style Selector="RadioButton.mergeChoice">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="Border.mergeSide">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Border.mergeSide.kept">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>
  <Style Selector="Border.mergeSide.kept TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
</Styles>
