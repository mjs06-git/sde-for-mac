<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Sde.App.Controls">
  <!--
    Tables (DataGrid, on top of its Fluent theme): a white working surface (put the table in a Border.tableSheet on the
    paper page), rows TableRowHeight high with hairline dividers (GridLinesVisibility="Horizontal"), body text with
    tabular numbers, a header row of small semibold labels on a hairline, a caret for the sorted column, and the
    selected row in the soft accent with its text still ink. Rows fade their hover when motion is on.
  -->

  <Style Selector="DataGrid">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="TextElement.FontFeatures" Value="+tnum" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderSubtle}" />
  </Style>

  <Style Selector="DataGridCell">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="MinHeight" Value="{DynamicResource TableRowHeight}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- A cell's focus shows as the row's selection; no extra box -->
  <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- The header row: small semibold labels on the surface, a hairline under it -->
  <Style Selector="DataGridColumnHeader">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="MinHeight" Value="{DynamicResource TableHeaderHeight}" />
    <Setter Property="Padding" Value="8,0,4,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="DataGrid /template/ Rectangle#PART_ColumnHeadersAndRowsSeparator">
    <Setter Property="Fill" Value="{DynamicResource BorderDefault}" />
  </Style>
  <!-- A short hairline between column headers, for resizing -->
  <Style Selector="DataGridColumnHeader /template/ Rectangle#VerticalSeparator">
    <Setter Property="Fill" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="Margin" Value="0,8" />
  </Style>
  <Style Selector="DataGrid">
    <Setter Property="RowBackground" Value="Transparent" />
  </Style>
  <!-- Selection: the soft accent behind ink text (a solid slab of blue fought the red and amber of the results) -->
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource AccentSoft}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource AccentSoftHover}" />
  </Style>
  <Style Selector="DataGridRow:selected TextBlock.cell.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector=".motion DataGridRow /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="DataGridColumnHeader:sortascending, DataGridColumnHeader:sortdescending">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="DataGridColumnHeader /template/ Path#SortIcon">
    <Setter Property="Height" Value="10" />
    <Setter Property="Width" Value="10" />
    <Setter Property="Fill" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="DataGridColumnHeader:sortascending /template/ Path#SortIcon">
    <Setter Property="Data" Value="{StaticResource IconCaretUp}" />
  </Style>
  <Style Selector="DataGridColumnHeader:sortdescending /template/ Path#SortIcon">
    <Setter Property="Data" Value="{StaticResource IconCaretDown}" />
  </Style>

  <!-- A cell's text in a template column: the same inset as a text column, one line, trimmed -->
  <Style Selector="TextBlock.cell">
    <Setter Property="Margin" Value="8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <!-- A sorted column's header text (the caret beside it comes from the view) -->
  <Style Selector="TextBlock.sortedHeader">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- A scope bar above a table (filters on the left, actions on the right) and a status bar under it, as in Finder -->
  <Style Selector="Border.scopeBar">
    <Setter Property="Height" Value="{DynamicResource ScopeBarHeight}" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Background" Value="{DynamicResource BgApp}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <!-- On a page whose table is a sheet, the scope bar sits on the paper with no rule of its own -->
  <Style Selector="Border.scopeBar.onPaper">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.statusBar">
    <Setter Property="Height" Value="{DynamicResource StatusBarHeight}" />
    <Setter Property="Background" Value="{DynamicResource BgApp}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Border.statusBar.onPaper">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!-- The table's working surface: a white sheet on the paper page, the rows clipped to its corners -->
  <Style Selector="Border.tableSheet">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Margin" Value="16,0,16,0" />
  </Style>
  <!-- The percent damaged in a table: the figure, then a small staff gauge -->
  <Style Selector="c|StaffGauge.cellGauge">
    <Setter Property="Width" Value="{StaticResource GaugeMiniWidth}" />
    <Setter Property="IsMini" Value="True" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <Style Selector="Border.statusBar TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.statusBar Button.link">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
  </Style>
  <!-- A panel that opens in place above a table (the submission folder): a quiet band, not a card -->
  <Style Selector="Border.inlinePanel">
    <Setter Property="Background" Value="{DynamicResource BgSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="16,12" />
  </Style>
  <!-- A result in a table: a coloured dot and its name -->
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A badge in a table cell is just its number, in its tone's colour (white on a selected row) -->
  <Style Selector="DataGridRow c|Badge">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- The strip above a table: counts and sort on the left; the "N selected" bar covers it while rows are checked -->
  <Style Selector="Border.tableBar">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="14,0" />
  </Style>
  <Style Selector="Border.tableBar.selection">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>
</Styles>
