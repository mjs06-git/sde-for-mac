<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Sde.App.Controls">
  <!--
    The Map page (Views/MapView.axaml). The map fills the content panel edge to edge; its controls float over it as
    white cards:
      Border.mapFloat (a floating white card with the card shadow) with RadioButton.mapTool (the tool palette, one
      icon per mode), Button.mapTool (zoom and show all), Border.mapBar (the mode's options at the top, and the
      selection bar at the bottom), Border.mapLegend (the legend card in the lower left);
      Border.mapDrawer (the attribute table, a card along the bottom with Border.drawerGrip and a
      c:ResizeHandle.drawerEdge that drags its height);
      the inspector beside the map: Border.mapPane (its column of cards) and TextBlock.legendTitle;
      Border.legendRamp (the heat map's colour ramp) and Ellipse.legendDot / Border.legendSwatch.
    Colours are tokens (Tokens.axaml, "Map page"); nothing here is a literal colour.
    The styles used only inside one area are in Styles/Scope.Map.axaml, included where that area is shown; this file
    keeps the ones used elsewhere too.
  -->

  <!-- A cluster in the legend: a bigger dot with a light ring, like the map's -->
  <Style Selector="Ellipse.legendDot.cluster">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Stroke" Value="{DynamicResource BgSurface}" />
    <Setter Property="StrokeThickness" Value="1.5" />
  </Style>

</Styles>
