<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Sde.App.Controls">
  <!--
    Sheets: the panels shown over the window (Services/SheetHost), the command palette, and the long-task card.
      Chrome (Views/MainWindow.axaml): Border.scrim dims the window (BgOverlay) and takes every click; Border.sheet is
        the white card hanging from the title band (RadiusSheetAttached), SheetPadding inside, with sheetSmall,
        sheetMedium and sheetLarge widths. Grid.sheetHead holds TextBlock.sheetHeading and Button.sheetClose. With motion
        on (the window's "motion" class) the scrim fades in and the card slides down as it fades in, 180 ms, easing out;
        with it off (tests, Reduce Motion) both appear at once. Closing has no animation, so nothing half-gone can take
        a click.
      c|SheetFooter (Controls/SheetFooter.cs): the one row of buttons at every sheet's foot, a tinted band across the
        card's foot: leading action at the far left, then Cancel and the one default action (accent; solid red when it
        is destructive) on the right.
      Inside a sheet: TextBlock.sheetSection (a group's heading), Border.card (a grouped box), Border.sheetTable with
        Border.sheetTableHead and Border.sheetTableRow (a small table, styled like the app's tables), ListBox.sheetList (a
        list to pick from, in a white card).
      The first-run walkthrough: c|Icon.welcomeMark, TextBlock.welcomeTitle, Border.welcomeStep (current: the page
        being read) with Border.welcomeNumber.
      Border.palette and its parts (the ⌘K command palette), Border.jobCard (the long-task card).
  -->

  <!-- The scrim: dims the window behind a sheet and takes its clicks -->
  <Style Selector="Border.scrim">
    <Setter Property="Background" Value="{DynamicResource BgOverlay}" />
  </Style>

  <!-- The sheet card, attached under the title band -->
  <Style Selector="Border.sheet">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderCard}" />
    <Setter Property="BorderThickness" Value="1,0,1,1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSheetAttached}" />
    <Setter Property="Padding" Value="{StaticResource SheetPadding}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowSheet}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="{StaticResource SheetMargin}" />
    <Setter Property="MinWidth" Value="{StaticResource SheetWidthSmall}" />
    <Setter Property="MaxWidth" Value="760" />
    <Setter Property="RenderTransform">
      <TranslateTransform />
    </Setter>
  </Style>
  <!-- The footer reaches out over the card's padding, so nothing between the card and the footer may clip -->
  <Style Selector="Border.sheet ContentPresenter, Border.sheet ContentControl, Border.sheet :is(UserControl)">
    <Setter Property="ClipToBounds" Value="False" />
  </Style>
  <Style Selector="Border.sheet.sheetSmall">
    <Setter Property="Width" Value="{StaticResource SheetWidthSmall}" />
  </Style>
  <Style Selector="Border.sheet.sheetMedium">
    <Setter Property="Width" Value="{StaticResource SheetWidthMedium}" />
  </Style>
  <Style Selector="Border.sheet.sheetLarge">
    <Setter Property="Width" Value="{StaticResource SheetWidthLarge}" />
    <Setter Property="MaxWidth" Value="{StaticResource SheetWidthLarge}" />
  </Style>

  <!-- The title row: the sheet's title, large and semibold, and the close button at the right -->
  <Style Selector="Grid.sheetHead">
    <Setter Property="Margin" Value="0,2,0,18" />
  </Style>
  <Style Selector="TextBlock.sheetHeading">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.sheetClose">
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="12,-3,-8,0" />
  </Style>
  <!-- The walkthrough sets its own large title, so the row keeps only the close button -->
  <Style Selector="Border.sheet.welcome TextBlock.sheetHeading">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.sheet.welcome Grid.sheetHead">
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>

  <!-- Motion: the scrim fades in and the card slides down into place, only under the window's "motion" class -->
  <Style Selector=".motion Border.scrim[IsVisible=True]">
    <Style.Animations>
      <Animation Duration="0:0:0.18" Easing="CubicEaseOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector=".motion Border.scrim[IsVisible=True] > Border.sheet">
    <Style.Animations>
      <Animation Duration="0:0:0.18" Easing="CubicEaseOut">
        <KeyFrame Cue="0%">
          <Setter Property="TranslateTransform.Y" Value="-14" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- The footer: a tinted band across the card's foot with the sheet's buttons in their fixed order -->
  <Style Selector="c|SheetFooter">
    <Setter Property="Margin" Value="{StaticResource SheetFooterMargin}" />
    <Setter Property="Padding" Value="{StaticResource SheetFooterPadding}" />
    <Setter Property="Background" Value="{DynamicResource BgTableHeader}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSheetFooter}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,0"
                CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <Button Name="PART_Leading" Classes="sheetButton" Content="{TemplateBinding LeadingText}" Command="{TemplateBinding LeadingCommand}"
                      IsVisible="{TemplateBinding ShowsLeading}" IsEnabled="{TemplateBinding LeadingIsOn}"
                      AutomationProperties.Name="{TemplateBinding LeadingAutomationName}" ToolTip.Tip="{TemplateBinding LeadingToolTip}" />
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{TemplateBinding IsBusy}" VerticalAlignment="Center">
                <ProgressBar Classes="sheetBusy" Minimum="0" Maximum="100" Value="{TemplateBinding Progress}"
                             IsIndeterminate="{TemplateBinding IsProgressIndeterminate}" AutomationProperties.Name="Progress" />
                <TextBlock Classes="muted" Text="{TemplateBinding BusyText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260"
                           AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                VerticalAlignment="Center" IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
              <Button Name="PART_Cancel" Classes="sheetButton" Content="{TemplateBinding EffectiveCancelText}" Command="{TemplateBinding EffectiveCancelCommand}"
                      IsVisible="{TemplateBinding ShowsCancel}" IsEnabled="{TemplateBinding CancelIsOn}"
                      AutomationProperties.Name="{TemplateBinding CancelAutomationName}" />
              <Button Name="PART_Primary" Classes="sheetButton" Content="{TemplateBinding EffectivePrimaryText}" Command="{TemplateBinding EffectivePrimaryCommand}"
                      CommandParameter="{TemplateBinding PrimaryCommandParameter}" IsDefault="{TemplateBinding PrimaryIsDefault}"
                      IsVisible="{TemplateBinding ShowsPrimary}" IsEnabled="{TemplateBinding PrimaryIsOn}"
                      AutomationProperties.Name="{TemplateBinding PrimaryAutomationName}" ToolTip.Tip="{TemplateBinding PrimaryToolTip}" />
            </StackPanel>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="c|SheetFooter Button.sheetButton">
    <Setter Property="MinWidth" Value="{StaticResource SheetButtonMinWidth}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="c|SheetFooter Button#PART_Primary">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- A destructive default action is the solid red button (the gauge red is kept for this, errors and substantial damage) -->
  <Style Selector="c|SheetFooter Button#PART_Primary.destructive /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerFill}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="c|SheetFooter Button#PART_Primary.destructive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerFillHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerFillHover}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="c|SheetFooter Button#PART_Primary.destructive:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerFillPressed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerFillPressed}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="c|SheetFooter Button#PART_Primary.destructive:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
  </Style>
  <Style Selector="ProgressBar.sheetBusy">
    <Setter Property="Width" Value="96" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Inside a sheet -->
  <!-- A group's heading ("From", "Bids") over its fields or rows -->
  <Style Selector="TextBlock.sheetSection">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSubheadline}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>
  <!-- A small table: one white card, a tinted header row, rows on hairlines (as the app's tables) -->
  <Style Selector="Border.sheetTable">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderCard}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.sheetTableHead">
    <Setter Property="Background" Value="{DynamicResource BgTableHeader}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="MinHeight" Value="{DynamicResource TableHeaderHeight}" />
    <Setter Property="Padding" Value="14,0" />
  </Style>
  <Style Selector="Border.sheetTableHead TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.sheetTableRow">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="MinHeight" Value="{DynamicResource TableRowHeight}" />
    <Setter Property="Padding" Value="14,6" />
  </Style>
  <!-- A list to pick one item from (backups, structures, help topics): a white card, the choice in the soft accent -->
  <Style Selector="ListBox.sheetList">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderCard}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="ListBox.sheetList ListBoxItem">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="MinHeight" Value="{DynamicResource TableRowHeight}" />
  </Style>
  <Style Selector="ListBox.sheetList ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
  </Style>
  <Style Selector="ListBox.sheetList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.sheetList ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>
  <Style Selector="ListBox.sheetList ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftHover}" />
  </Style>

  <!-- The walkthrough: the brand mark, a large title and the pages as rows, the one being read in the soft accent -->
  <Style Selector="c|Icon.welcomeMark">
    <Setter Property="Foreground" Value="{DynamicResource AccentFill}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="TextBlock.welcomeTitle">
    <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.4" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.welcomeStep">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.welcomeStep.current">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>
  <Style Selector="Border.welcomeStep TextBlock.welcomeBody">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.welcomeStep.current TextBlock.welcomeBody">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Border.welcomeNumber">
    <Setter Property="Width" Value="{DynamicResource StepBadgeSize}" />
    <Setter Property="Height" Value="{DynamicResource StepBadgeSize}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Background" Value="{DynamicResource BgSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Border.welcomeNumber TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.welcomeStep.current Border.welcomeNumber">
    <Setter Property="Background" Value="{DynamicResource AccentFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFill}" />
  </Style>
  <Style Selector="Border.welcomeStep.current Border.welcomeNumber TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>

  <!-- The command palette: a white card over the dimmed window, a large search line, rows with the choice in the soft accent -->
  <Style Selector="Border.palette">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderCard}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSheet}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowSheet}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.paletteFooter">
    <Setter Property="Background" Value="{DynamicResource BgTableHeader}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="16,10" />
  </Style>
  <Style Selector="ListBox.palette">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8,4,8,8" />
  </Style>
  <Style Selector="ListBox.palette ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.palette ListBoxItem /template/ ContentPresenter#PART_ContentPresenter, ListBox.palette ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.palette ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.palette ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.palette ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter, ListBox.palette ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TextBlock.paletteGroup">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="Margin" Value="12,12,12,4" />
  </Style>
  <Style Selector="Border.paletteRow">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="MinHeight" Value="{DynamicResource TableRowHeight}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.paletteRow c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="ListBox.palette ListBoxItem:pointerover Border.paletteRow">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
  </Style>
  <Style Selector="ListBox.palette ListBoxItem:selected Border.paletteRow">
    <Setter Property="Background" Value="{DynamicResource RowSelectedFill}" />
  </Style>
  <Style Selector="ListBox.palette ListBoxItem:selected Border.paletteRow c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector=".motion Panel#PaletteLayer[IsVisible=True]">
    <Style.Animations>
      <Animation Duration="0:0:0.14" Easing="CubicEaseOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- A long task: a white card over the bottom right corner with the task, its progress and Stop -->
  <Style Selector="Border.jobCard">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderCard}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowSheet}" />
    <Setter Property="Padding" Value="18,14,14,14" />
    <Setter Property="Width" Value="360" />
    <Setter Property="Margin" Value="24" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
  </Style>
  <Style Selector="Border.jobCard TextBlock.jobTitle">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSubheadline}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
</Styles>
