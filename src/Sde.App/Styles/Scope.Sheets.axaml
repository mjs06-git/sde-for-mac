<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Sde.App.Controls">
  <!--
    Styles that only ever apply inside the content of every sheet (the sheet card in MainWindow), so they are included there rather than in App.axaml.
    Avalonia tries every app-wide style on every new control, so keeping these out of App.axaml keeps the
    Structures table and the map quick to draw. Put a style here only when its classes are used nowhere else.
  -->
  <!-- From Styles/AppLevel.axaml -->
  <!-- ───────────── What's New ───────────── -->
  <Style Selector="c|Icon.whatsNewMark">
    <Setter Property="Size" Value="56" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.whatsNewHeading">
    <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.3" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="Border.whatsNewCard">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderCard}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowCard}" />
    <Setter Property="Padding" Value="20,16,20,18" />
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>

  <Style Selector="ItemsControl.whatsNewGroups ContentPresenter:nth-child(odd) > Border.whatsNewCard">
    <Setter Property="Margin" Value="0,0,8,16" />
  </Style>

  <Style Selector="ItemsControl.whatsNewGroups ContentPresenter:nth-child(even) > Border.whatsNewCard">
    <Setter Property="Margin" Value="8,0,0,16" />
  </Style>

  <Style Selector="StackPanel.whatsNewLines">
    <Setter Property="Spacing" Value="8" />
  </Style>

  <Style Selector="StackPanel.whatsNewLines TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="19" />
  </Style>

  <Style Selector="Ellipse.whatsNewDot">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Fill" Value="{DynamicResource AccentFill}" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="2,7,12,0" />
  </Style>

  <!-- ───────────── Check for Updates ───────────── -->
  <Style Selector="Border.statusBadge">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style Selector="Border.statusBadge c|Icon">
    <Setter Property="Size" Value="22" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.statusBadge.success">
    <Setter Property="Background" Value="{DynamicResource SuccessBg}" />
  </Style>

  <Style Selector="Border.statusBadge.success c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource SuccessFg}" />
  </Style>

  <Style Selector="Border.statusBadge.warning">
    <Setter Property="Background" Value="{DynamicResource WarningBg}" />
  </Style>

  <Style Selector="Border.statusBadge.warning c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource WarningFg}" />
  </Style>

  <Style Selector="TextBlock.statusHeadline">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- ───────────── The spreadsheet chooser ───────────── -->
  <Style Selector="StackPanel.choiceList">
    <Setter Property="Spacing" Value="4" />
  </Style>

  <Style Selector="RadioButton.choice">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="8,0,0,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- From Styles/CaseFile.axaml -->
  <!-- ───────────── Tables in the sheets ───────────── -->
  <Style Selector="Border.sheetTable">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderCard}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.sheetTableHead">
    <Setter Property="Background" Value="{DynamicResource BgTableHeader}" />
    <Setter Property="MinHeight" Value="{StaticResource TableHeaderHeight}" />
    <Setter Property="Padding" Value="14,0" />
  </Style>

  <Style Selector="Border.sheetTableHead TextBlock.colHead">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.sheetTableRow">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="MinHeight" Value="{StaticResource TableRowHeight}" />
    <Setter Property="Padding" Value="14,4" />
  </Style>

  <!-- A document's row holds its title over the name of the file it came from -->
  <Style Selector="Border.sheetTableRow.documentRow">
    <Setter Property="Padding" Value="14,7" />
  </Style>

  <!-- A group heading inside a sheet table (the editor's step in the comparison) -->
  <Style Selector="Border.sheetTableGroup">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Background" Value="{DynamicResource BgSubtle}" />
    <Setter Property="Padding" Value="14,7" />
  </Style>

  <Style Selector="Border.sheetTableGroup TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>

  <!-- A value that differs from the other side's: in ink, semibold; an unchanged one stays quiet -->
  <Style Selector="TextBlock.changed">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- A file waiting to be kept: an inset panel in the sheet -->
  <Style Selector="Border.pendingDocument">
    <Setter Property="Background" Value="{DynamicResource BgSubtle}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="Padding" Value="16,14" />
  </Style>

  <!-- The comparison's difference between the two results -->
  <Style Selector="TextBlock.differenceFigure">
    <Setter Property="FontSize" Value="{StaticResource FontSizeLargeTitle}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- ───────────── Quick Look ───────────── -->
  <Style Selector="Border.viewerStage">
    <Setter Property="Background" Value="{DynamicResource BgHero}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Button.viewerChevron">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Background" Value="{DynamicResource BgFrameHover}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="12,0" />
  </Style>

  <Style Selector="Button.viewerChevron /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgFrameHover}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnHero}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
  </Style>

  <Style Selector="Button.viewerChevron:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgFramePressed}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnHero}" />
  </Style>

  <Style Selector="Button.viewerChevron:disabled">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector="Button.viewerChevron c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource TextOnHero}" />
  </Style>

  <Style Selector="TextBlock.viewerCaption">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSubheadline}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.viewerCount">
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>

  <Style Selector="TextBlock.viewerEmpty">
    <Setter Property="Foreground" Value="{DynamicResource TextOnHeroSecondary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- From Styles/Workflow.axaml -->
  <!-- The merge sheet: the two structures side by side, each a choosable card -->
  <Style Selector="RadioButton.mergeChoice">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>

  <Style Selector="Border.mergeSide">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="Padding" Value="14,12" />
  </Style>

  <Style Selector="Border.mergeSide.kept">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>

  <Style Selector="Border.mergeSide.kept TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- From Styles/StructuresPage.axaml -->
  <!-- Manage Tags: one row per tag -->
  <Style Selector="Border.tagRow">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="Button.dotButton">
    <Setter Property="Width" Value="{DynamicResource ControlHeight}" />
    <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.dotButton Ellipse">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
  </Style>

  <!-- The Submission Folder sheet: titled groups of choices on the sheet, and the warnings after a run -->
  <Style Selector="StackPanel.sheetGroup">
    <Setter Property="Spacing" Value="6" />
  </Style>

  <Style Selector="Border.warningList">
    <Setter Property="Background" Value="{DynamicResource WarningBg}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style Selector="Border.warningList TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="Border.warningList c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource WarningFg}" />
  </Style>

  <!-- From Styles/Sheets.axaml -->
  <!-- Inside a sheet -->
  <!-- A group's heading ("From", "Bids") over its fields or rows -->
  <Style Selector="TextBlock.sheetSection">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSubheadline}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>

  <!-- A small table: one white card, a tinted header row, rows on hairlines (as the app's tables) -->
  <Style Selector="Border.sheetTable">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderCard}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.sheetTableHead">
    <Setter Property="Background" Value="{DynamicResource BgTableHeader}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="MinHeight" Value="{DynamicResource TableHeaderHeight}" />
    <Setter Property="Padding" Value="14,0" />
  </Style>

  <Style Selector="Border.sheetTableHead TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.sheetTableRow">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="MinHeight" Value="{DynamicResource TableRowHeight}" />
    <Setter Property="Padding" Value="14,6" />
  </Style>

  <!-- A list to pick one item from (backups, structures, help topics): a white card, the choice in the soft accent -->
  <Style Selector="ListBox.sheetList">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderCard}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="Padding" Value="4" />
  </Style>

  <Style Selector="ListBox.sheetList ListBoxItem">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="MinHeight" Value="{DynamicResource TableRowHeight}" />
  </Style>

  <Style Selector="ListBox.sheetList ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
  </Style>

  <Style Selector="ListBox.sheetList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.sheetList ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>

  <Style Selector="ListBox.sheetList ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftHover}" />
  </Style>

  <!-- The walkthrough: the brand mark, a large title and the pages as rows, the one being read in the soft accent -->
  <Style Selector="c|Icon.welcomeMark">
    <Setter Property="Foreground" Value="{DynamicResource AccentFill}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style Selector="TextBlock.welcomeTitle">
    <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.4" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="Border.welcomeStep">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.welcomeStep.current">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>

  <Style Selector="Border.welcomeStep TextBlock.welcomeBody">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="Border.welcomeStep.current TextBlock.welcomeBody">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="Border.welcomeNumber">
    <Setter Property="Width" Value="{DynamicResource StepBadgeSize}" />
    <Setter Property="Height" Value="{DynamicResource StepBadgeSize}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Background" Value="{DynamicResource BgSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style Selector="Border.welcomeNumber TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.welcomeStep.current Border.welcomeNumber">
    <Setter Property="Background" Value="{DynamicResource AccentFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFill}" />
  </Style>

  <Style Selector="Border.welcomeStep.current Border.welcomeNumber TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
</Styles>
