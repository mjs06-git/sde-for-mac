<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Sde.App.Controls">
  <!--
    The data pages: Import & Export (its Import, Export and Field Work tabs), Import inspections or parcels, and Settings
    (with its panels). A page sets Classes="dataPage" on its root so the shared grey Border.card becomes the approved
    white card there, and its parts use:
      TextBlock.pageHeading (the page's or category's title, display size);
      Border.dataCard (a white card) with a DockPanel.cardHead (c:Icon.cardIcon and TextBlock.cardHeading);
      StackPanel.actionRows of Border.actionRow (one line: TextBlock.rowLabel and a quiet TextBlock.rowDetail on the left,
      the buttons on the right, hairlines between rows);
      Border.dropCard (Import's drop zone: a dashed outline, Border.dropIcon, accent tint while a file is dragged over);
      Border.previewCard (a preview inside a card: Border.previewHead, Border.previewRow, Border.previewFoot), with
      Border.groupHead and Border.groupRow for the buildings of a split row;
      Border.settingsRail (Settings' categories: a white card list on the left of the content);
      ListBox.themeTiles (Appearance: three large preview tiles, each a Border.miniFrame drawn from tokens).
    The styles used only inside one area are in Styles/Scope.Data.axaml, included where that area is shown; this file
    keeps the ones used elsewhere too.
  -->

  <!-- A card's heading inside a data page card: semibold at title size, as on the Summary's cards -->
  <Style Selector=":is(UserControl).dataPage Border.card TextBlock.h3, TextBlock.cardHeading">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.cardHeading">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="DockPanel.cardHead">
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="LastChildFill" Value="True" />
  </Style>
  <Style Selector="c|Icon.cardIcon">
    <Setter Property="Size" Value="{StaticResource IconSizeLarge}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,10,0" />
  </Style>

  <Style Selector="TextBlock.rowDetail">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="Border.dropIcon">
    <Setter Property="Width" Value="52" />
    <Setter Property="Height" Value="52" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.dropIcon c|Icon">
    <Setter Property="Size" Value="26" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.previewRow TextBlock, Border.groupRow TextBlock, Border.groupHead TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- The buildings of one row of the file: a quiet heading row, the buildings indented under it on a 2 px rule -->
  <Style Selector="Border.groupHead">
    <Setter Property="Background" Value="{DynamicResource BgSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightLarge}" />
  </Style>
  <Style Selector="Border.groupRail">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFill}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Margin" Value="22,0,0,0" />
  </Style>

  <!-- A colour choice: a round swatch beside its name -->
  <Style Selector="Ellipse.swatch">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</Styles>
