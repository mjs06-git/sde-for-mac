<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Sde.App.Controls">
  <!--
    The case file and the per-structure sheets reached from it (Documents, Quick Look, Compare assessments).
      Case file page: the hero band (Border.heroBand with TextBlock.heroValue facts and a c:ResultHero.inBand on the
      right), the timeline (TextBlock.timelineMonth headings; per entry TextBlock.timelineDate and timelineTime in the
      date gutter, Border.timelineRail and Border.timelineDot on the rail, the text beside it) and the column of white
      cards (Border.sideCard with Button.caseRow rows).
      Tables in the sheets: Border.sheetTable (one white card, its header row Border.sheetTableHead tinted, rows
      Border.sheetTableRow on hairlines, TextBlock.colHead headings).
      Quick Look: Border.viewerStage (the dark stage the photo sits on) with Button.viewerChevron on its sides and
      TextBlock.viewerCaption and viewerCount under the photo.
  -->

  <!-- ───────────── The case file's hero band ───────────── -->
  <!-- A fact under the address in the hero band (owner, parcel, community): the value in white over its label -->
  <Style Selector="TextBlock.heroValue">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSubheadline}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnHero}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.heroNote">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnHeroSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.heroNote.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerOnFrame}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- The result hero inside the hero band: the band is already the dark card, so no second card -->
  <Style Selector="c|ResultHero.inBand /template/ Border#ResultHero">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <!-- The result beside the facts, on a hairline of the frame's border -->
  <Style Selector="Border.heroResult">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderFrame}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Padding" Value="28,0,0,0" />
    <Setter Property="Width" Value="320" />
  </Style>

  <!-- ───────────── The timeline ───────────── -->
  <Style Selector="TextBlock.timelineMonth">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="Margin" Value="0,16,0,6" />
  </Style>
  <Style Selector="TextBlock.timelineDate">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="TextBlock.timelineTime">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <!-- The rail runs the whole height of each entry, so the entries join into one line -->
  <Style Selector="Border.timelineRail">
    <Setter Property="Width" Value="2" />
    <Setter Property="Background" Value="{DynamicResource BorderDefault}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.timelineDot">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>
  <Style Selector="Border.timelineDot c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <!-- A field change is quieter than something that happened -->
  <Style Selector="Border.timelineDot.edit">
    <Setter Property="Background" Value="{DynamicResource BgSubtle}" />
  </Style>
  <Style Selector="Border.timelineDot.edit c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.timelineTitle">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.timelineTitle.edit">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!-- ───────────── Rows in the case file's cards and the timeline ───────────── -->
  <!-- A row that opens something: flat, the whole width, the hover fill on a rounded row -->
  <Style Selector="Button.caseRow">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Padding" Value="8,7" />
    <Setter Property="Margin" Value="-8,0" />
  </Style>
  <Style Selector="Button.caseRow:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <!-- The same row when it opens nothing (an assessment in Recently deleted, a field change) -->
  <Style Selector="Border.caseRow">
    <Setter Property="Padding" Value="8,7" />
    <Setter Property="Margin" Value="-8,0" />
  </Style>
  <Style Selector="Border.cardHead">
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="StackPanel.caseCards > Border.sideCard">
    <Setter Property="Padding" Value="20,18,20,14" />
  </Style>
  <!-- An assessment in Recently deleted is listed, struck quiet -->
  <Style Selector=":is(Control).trashed TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>

  <!-- ───────────── Tables in the sheets ───────────── -->
  <Style Selector="Border.sheetTable">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderCard}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.sheetTableHead">
    <Setter Property="Background" Value="{DynamicResource BgTableHeader}" />
    <Setter Property="MinHeight" Value="{StaticResource TableHeaderHeight}" />
    <Setter Property="Padding" Value="14,0" />
  </Style>
  <Style Selector="Border.sheetTableHead TextBlock.colHead">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.sheetTableRow">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="MinHeight" Value="{StaticResource TableRowHeight}" />
    <Setter Property="Padding" Value="14,4" />
  </Style>
  <!-- A document's row holds its title over the name of the file it came from -->
  <Style Selector="Border.sheetTableRow.documentRow">
    <Setter Property="Padding" Value="14,7" />
  </Style>
  <!-- A group heading inside a sheet table (the editor's step in the comparison) -->
  <Style Selector="Border.sheetTableGroup">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Background" Value="{DynamicResource BgSubtle}" />
    <Setter Property="Padding" Value="14,7" />
  </Style>
  <Style Selector="Border.sheetTableGroup TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <!-- A value that differs from the other side's: in ink, semibold; an unchanged one stays quiet -->
  <Style Selector="TextBlock.changed">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.unchanged">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <!-- A file waiting to be kept: an inset panel in the sheet -->
  <Style Selector="Border.pendingDocument">
    <Setter Property="Background" Value="{DynamicResource BgSubtle}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="Padding" Value="16,14" />
  </Style>
  <!-- The comparison's difference between the two results -->
  <Style Selector="TextBlock.differenceFigure">
    <Setter Property="FontSize" Value="{StaticResource FontSizeLargeTitle}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- ───────────── Quick Look ───────────── -->
  <Style Selector="Border.viewerStage">
    <Setter Property="Background" Value="{DynamicResource BgHero}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.viewerChevron">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Background" Value="{DynamicResource BgFrameHover}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="12,0" />
  </Style>
  <Style Selector="Button.viewerChevron /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgFrameHover}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnHero}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
  </Style>
  <Style Selector="Button.viewerChevron:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgFramePressed}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnHero}" />
  </Style>
  <Style Selector="Button.viewerChevron:disabled">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Button.viewerChevron c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource TextOnHero}" />
  </Style>
  <Style Selector="TextBlock.viewerCaption">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSubheadline}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.viewerCount">
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.viewerEmpty">
    <Setter Property="Foreground" Value="{DynamicResource TextOnHeroSecondary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
