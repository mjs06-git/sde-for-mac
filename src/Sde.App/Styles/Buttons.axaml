<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Sde.App.Controls">
  <!--
    Buttons, in the Mac's push-button look. A plain <Button> is the default: white (dark grey in dark mode), a hairline
    bezel and a soft shadow, 22 px high, regular weight.
      Variants: accent (also "primary"), ghost (also "subtle"), link, danger (red text), destructive (solid red),
                icon (square, no border), chip (small pill), nav (sidebar item; "active" when selected), help (the info icon by a field)
      Sizes:    sm (19 px), lg (28 px, toolbar items); they combine with the variants, for example Classes="icon sm".
    Menus: <DropDownButton> shows a chevron; DropDownButton.accent is the accent version. <SplitButton> likewise.
    A segmented control is a ListBox with Classes="segmented".
    Every state (pointer over, pressed, disabled, keyboard focus) is styled; keyboard focus shows the Focus ring.
  -->

  <!-- The keyboard focus ring for every control, as on the Mac: 3 px of the accent, half see-through, hugging the control. -->
  <Style Selector="AdornerLayer">
    <Setter Property="DefaultFocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="3" BorderBrush="{DynamicResource Focus}" Opacity="0.5" CornerRadius="7" Margin="-3" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>

  <!-- Default -->
  <Style Selector="Button, ToggleButton, DropDownButton, SplitButton">
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
  </Style>
  <!-- The bezel shadow under push buttons; the borderless variants below take it off -->
  <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter, ToggleButton /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowControl}" />
  </Style>
  <Style Selector="DropDownButton /template/ Border#RootBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowControl}" />
  </Style>
  <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter, Button.subtle /template/ ContentPresenter#PART_ContentPresenter, Button.icon /template/ ContentPresenter#PART_ContentPresenter, Button.nav /template/ ContentPresenter#PART_ContentPresenter, Button.link /template/ ContentPresenter#PART_ContentPresenter, Button.help /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.ghost /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.star /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
  </Style>
  <Style Selector="DropDownButton.ghost /template/ Border#RootBorder">
    <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
  </Style>
  <Style Selector="Button.sm, ToggleButton.sm, DropDownButton.sm">
    <Setter Property="MinHeight" Value="{StaticResource ControlHeightSmall}" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
  </Style>
  <Style Selector="Button.lg, ToggleButton.lg, DropDownButton.lg">
    <Setter Property="MinHeight" Value="{StaticResource ControlHeightLarge}" />
    <Setter Property="Padding" Value="16,4" />
  </Style>

  <!-- Accent ("primary" is the older name) -->
  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrushPointerOver}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundPointerOver}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPressed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrushPressed}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundPressed}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundDisabled}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrushDisabled}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundDisabled}" />
  </Style>
  <Style Selector="Button.accent, Button.primary, DropDownButton.accent">
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <!-- Ghost ("subtle" is the older name): no fill or border until the pointer is over it -->
  <Style Selector="Button.ghost, Button.subtle, Button.icon, Button.nav, ToggleButton.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter, Button.subtle /template/ ContentPresenter#PART_ContentPresenter, Button.icon /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.subtle:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgPressed}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.subtle:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.nav:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
  </Style>
  <Style Selector="Button.subtle">
    <Setter Property="Padding" Value="10,4" />
  </Style>

  <!-- Icon: a square ghost button with one icon -->
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="{StaticResource ControlHeight}" />
    <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.icon.sm">
    <Setter Property="Width" Value="{StaticResource ControlHeightSmall}" />
    <Setter Property="Height" Value="{StaticResource ControlHeightSmall}" />
    <Setter Property="MinHeight" Value="{StaticResource ControlHeightSmall}" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button.icon.lg">
    <Setter Property="Width" Value="{StaticResource ControlHeightLarge}" />
    <Setter Property="Height" Value="{StaticResource ControlHeightLarge}" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- Link: accent text, no box -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentHover}" />
  </Style>
  <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentPressed}" />
  </Style>
  <Style Selector="Button.link:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
  </Style>
  <Style Selector="Button.link.danger /template/ ContentPresenter#PART_ContentPresenter, Button.link.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource DangerFg}" />
  </Style>

  <!-- Danger: an ordinary button with red text, for actions that remove something -->
  <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource DangerFg}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerBg}" />
    <Setter Property="Foreground" Value="{DynamicResource DangerFg}" />
  </Style>
  <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerBg}" />
    <Setter Property="Foreground" Value="{DynamicResource DangerFg}" />
  </Style>
  <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
  </Style>

  <!-- Destructive: solid red, for the button that confirms a deletion -->
  <Style Selector="Button.destructive">
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.destructive /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerFill}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="Button.destructive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerFillHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerFillHover}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="Button.destructive:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerFillPressed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerFillPressed}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="Button.destructive:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
  </Style>

  <!-- Chip: a small push button (damage presets 0 to 100, the status menu, "Showing … ×") -->
  <Style Selector="Button.chip">
    <Setter Property="MinHeight" Value="{StaticResource ControlHeightSmall}" />
    <Setter Property="Padding" Value="8,1" />
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- Source-list row: an accent-tinted icon, the label and an optional count; "active" when its page is showing -->
  <Style Selector="Button.nav">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter, Button.nav.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SidebarSelection}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.nav c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <!-- The info icon beside a field's label: opens the field's help -->
  <Style Selector="Button.help">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="MinHeight" Value="18" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.help /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
  </Style>
  <Style Selector="Button.help:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.help:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <!-- The report-photo star: a toggle that looks like a link; on means "this photo is on the reports" -->
  <Style Selector="ToggleButton.star">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ToggleButton.star /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.star:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.star:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.star:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <!-- Drop-down and split buttons: the Phosphor caret instead of Fluent's glyph -->
  <Style Selector="DropDownButton /template/ PathIcon#DropDownGlyph">
    <Setter Property="Data" Value="{StaticResource IconCaretDown}" />
    <Setter Property="Width" Value="9" />
    <Setter Property="Height" Value="9" />
    <Setter Property="Margin" Value="0,0,7,0" />
  </Style>
  <Style Selector="DropDownButton">
    <Setter Property="Padding" Value="10,1,4,1" />
  </Style>
  <Style Selector="DropDownButton.sm">
    <Setter Property="Padding" Value="8,1,3,1" />
  </Style>
  <Style Selector="DropDownButton.accent /template/ Border#RootBorder">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentButtonForeground}" />
  </Style>
  <Style Selector="DropDownButton.accent /template/ PathIcon#DropDownGlyph, DropDownButton.accent:pointerover /template/ PathIcon#DropDownGlyph, DropDownButton.accent:pressed /template/ PathIcon#DropDownGlyph">
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
  </Style>
  <Style Selector="DropDownButton.accent:pointerover /template/ Border#RootBorder">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrushPointerOver}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentButtonForeground}" />
  </Style>
  <Style Selector="DropDownButton.accent:pressed /template/ Border#RootBorder">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPressed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrushPressed}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentButtonForeground}" />
  </Style>
  <Style Selector="DropDownButton.ghost /template/ Border#RootBorder">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="DropDownButton.ghost:pointerover /template/ Border#RootBorder">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="SplitButton /template/ Button#PART_SecondaryButton PathIcon">
    <Setter Property="Data" Value="{StaticResource IconCaretDown}" />
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
  </Style>
  <Style Selector="SplitButton /template/ Button#PART_SecondaryButton">
    <Setter Property="AutomationProperties.Name" Value="{Binding $parent[SplitButton].(AutomationProperties.Name), StringFormat='{}{0}: more choices'}" />
  </Style>

  <!-- Segmented control: <ListBox Classes="segmented"> with a few short items; the selected one is raised -->
  <Style Selector="ListBox.segmented">
    <Setter Property="Background" Value="{DynamicResource SegmentedTrack}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="2" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem">
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Padding" Value="12,1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.segmented ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.segmented ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlFill}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowControl}" />
  </Style>
</Styles>
