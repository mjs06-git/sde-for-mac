<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Sde.App.Controls">
  <!--
    Styles that only ever apply inside the Review, Compliance, Assignments, Agenda, Summary, Case File and Recently
    Deleted pages, so they are included there rather than in App.axaml. Avalonia tries every app-wide style on every new
    control, so keeping these out of App.axaml keeps the Structures table and the map quick to draw. Put a style here
    only when its classes are used nowhere else.
  -->
  <!-- From Styles/CaseFile.axaml -->
  <!-- ───────────── The case file's hero band ───────────── -->
  <!-- A fact under the address in the hero band (owner, parcel, community): the value in white over its label -->
  <Style Selector="TextBlock.heroValue">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSubheadline}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnHero}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.heroNote">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnHeroSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.heroNote.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerOnFrame}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- The result hero inside the hero band: the band is already the dark card, so no second card -->
  <Style Selector="c|ResultHero.inBand /template/ Border#ResultHero">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- The result beside the facts, on a hairline of the frame's border -->
  <Style Selector="Border.heroResult">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderFrame}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Padding" Value="28,0,0,0" />
    <Setter Property="Width" Value="320" />
  </Style>

  <!-- ───────────── The timeline ───────────── -->
  <Style Selector="TextBlock.timelineMonth">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="Margin" Value="0,16,0,6" />
  </Style>

  <Style Selector="TextBlock.timelineDate">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>

  <Style Selector="TextBlock.timelineTime">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>

  <!-- The rail runs the whole height of each entry, so the entries join into one line -->
  <Style Selector="Border.timelineRail">
    <Setter Property="Width" Value="2" />
    <Setter Property="Background" Value="{DynamicResource BorderDefault}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.timelineDot">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>

  <Style Selector="Border.timelineDot c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <!-- A field change is quieter than something that happened -->
  <Style Selector="Border.timelineDot.edit">
    <Setter Property="Background" Value="{DynamicResource BgSubtle}" />
  </Style>

  <Style Selector="Border.timelineDot.edit c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>

  <Style Selector="TextBlock.timelineTitle">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.timelineTitle.edit">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!-- ───────────── Rows in the case file's cards and the timeline ───────────── -->
  <!-- A row that opens something: flat, the whole width, the hover fill on a rounded row -->
  <Style Selector="Button.caseRow">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Padding" Value="8,7" />
    <Setter Property="Margin" Value="-8,0" />
  </Style>

  <Style Selector="Button.caseRow:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- The same row when it opens nothing (an assessment in Recently deleted, a field change) -->
  <Style Selector="Border.caseRow">
    <Setter Property="Padding" Value="8,7" />
    <Setter Property="Margin" Value="-8,0" />
  </Style>

  <Style Selector="StackPanel.caseCards > Border.sideCard">
    <Setter Property="Padding" Value="20,18,20,14" />
  </Style>

  <!-- An assessment in Recently deleted is listed, struck quiet -->
  <Style Selector=":is(Control).trashed TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>

  <!-- From Styles/Workflow.axaml -->
  <!-- The status line's text (its content belongs to the page, so it is marked pageStatus rather than found under the
       status bar): the status bar's small grey type -->
  <Style Selector=":is(Control).pageStatus TextBlock, TextBlock.pageStatus">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector=":is(Control).pageStatus Button.link">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
  </Style>

  <!-- The inspector's cards, one above the other, clear of the window's edge -->
  <Style Selector="StackPanel.inspectorStack">
    <Setter Property="Spacing" Value="14" />
    <Setter Property="Margin" Value="0,0,20,20" />
  </Style>

  <!-- A filter strip's controls, left to right -->
  <Style Selector="StackPanel.filterRow">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="6" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A scrolling page of cards (Review's checks, the Agenda): the page padding around a column of cards -->
  <Style Selector="StackPanel.cardColumn">
    <Setter Property="Spacing" Value="16" />
    <Setter Property="Margin" Value="20,0,20,24" />
  </Style>

  <!-- A titled group of rows on a white card -->
  <Style Selector="Border.groupCard">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderCard}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowCard}" />
    <Setter Property="Padding" Value="0,14,0,4" />
  </Style>

  <Style Selector="TextBlock.groupTitle">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSubheadline}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- The Agenda's Overdue group: its title in the danger red, and its rows' icons -->
  <Style Selector="TextBlock.groupTitle.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerFg}" />
  </Style>

  <Style Selector="Button.cardRow c|Icon.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerFg}" />
  </Style>

  <Style Selector="TextBlock.groupCount">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A row inside a group card: a hairline above, the card's inset -->
  <Style Selector="Border.cardRow">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="20,9" />
    <Setter Property="MinHeight" Value="{DynamicResource TableRowHeight}" />
  </Style>

  <!-- The same row as a button (an Agenda entry opens its case or assessment): flat, the hover tint, full width -->
  <Style Selector="Button.cardRow">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="20,9" />
    <Setter Property="MinHeight" Value="{DynamicResource TableRowHeight}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
  </Style>

  <Style Selector="Button.cardRow /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="Button.cardRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="Button.cardRow:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgPressed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- An Agenda row's date column: tabular, a fixed width so the titles line up -->
  <Style Selector="TextBlock.rowDate">
    <Setter Property="Width" Value="92" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- The checks that could not run: a plain card on the paper's grey, no shadow -->
  <Style Selector="Border.quietGroup">
    <Setter Property="Background" Value="{DynamicResource BgSubtle}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="Padding" Value="20,14" />
  </Style>

  <!-- One check in the Review inspector: the icon, the title with a short line under it, and Show -->
  <Style Selector="Grid.checkRow">
    <Setter Property="ColumnSpacing" Value="10" />
  </Style>

  <Style Selector="Grid.checkRow c|Icon">
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <!-- A list in a card with +/- under it -->
  <Style Selector="Border.listCard">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderCard}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowCard}" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

  <Style Selector="Border.cardFooter">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="6,4" />
  </Style>

  <!-- The team list's rows inside its card -->
  <Style Selector="ListBox.teamList ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="6,2" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
  </Style>

  <Style Selector="ListBox.teamList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.teamList ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.teamList ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>

  <Style Selector="ListBox.teamList">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0,6" />
  </Style>

  <Style Selector="Border.teamRow">
    <Setter Property="Padding" Value="10,8" />
  </Style>

  <!-- A team's colour chip -->
  <Style Selector="Border.teamChip">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="Margin" Value="0,3,0,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <!-- The Assignments page: the teams card on the left of the route table -->
  <Style Selector="Border.teamsColumn">
    <Setter Property="Width" Value="224" />
    <Setter Property="Margin" Value="20,0,0,0" />
  </Style>

  <Style Selector="Border.agendaHero">
    <Setter Property="Margin" Value="20,20,20,0" />
  </Style>
</Styles>
