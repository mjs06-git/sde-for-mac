<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Sde.App.Controls">
  <!--
    Surfaces and forms.
      Border.card (a grouped box, RadiusCard, CardPadding); Border.sheetBlock (a white sheet on the paper page, for a
      page's blocks: hairline border, RadiusCard); card.flush (no padding, for a table);
      card.compact (CardPaddingCompact); Border.subtle (an inset inside a card); Border.pill (a status pill);
      Border.divider (a 1 px line); Border.rule (a line above its content).
      StackPanel.field (one labelled input, 240 wide; field.wide 496) with a fieldHead row (TextBlock.fieldLabel and
      the help button), help and issue. In an ItemsControl.fields (whose panel is a c:FieldGrid) a field fills its column instead (field.wide, the whole
      row).
  -->

  <!-- Grouped boxes, as in the Mac's forms and System Settings: a light grey fill, no border or shadow -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource BgSubtle}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="Padding" Value="{StaticResource CardPadding}" />
  </Style>
  <!-- A table or list in a box: white, a hairline border (the table's own rows give the structure) -->
  <Style Selector="Border.card.flush">
    <Setter Property="Padding" Value="0" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <!-- Settings rows sit in a grey grouped box, as in System Settings -->
  <Style Selector="Border.card.settings">
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- The KPI tiles' row: small filter buttons side by side -->
  <Style Selector="StackPanel.kpiBar">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="2" />
    <Setter Property="Margin" Value="-8,-4,0,8" />
  </Style>
  <Style Selector="Border.card.compact">
    <Setter Property="Padding" Value="{StaticResource CardPaddingCompact}" />
  </Style>
  <!-- A white card on the page (the Summary's blocks): a faint hairline, the card shadow, a semibold heading inside -->
  <Style Selector="Border.sheetBlock">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderCard}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowCard}" />
    <Setter Property="Padding" Value="24,20,24,24" />
  </Style>
  <Style Selector="TextBlock.sheetTitle">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>
  <!-- A chart's heading row: the title, and on the right a short figure in words ("40 assessed") -->
  <Style Selector="TextBlock.chartNote">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="12,4,0,0" />
  </Style>
  <Style Selector=":is(Control).chart">
    <Setter Property="Height" Value="{StaticResource ChartHeight}" />
  </Style>

  <!-- The Summary's hero band: the one dark band at the top, the headline large in white, the share on a big gauge and
       the supporting figures beside it -->
  <Style Selector="Border.heroBand">
    <Setter Property="Background" Value="{DynamicResource BgHero}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSheet}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowHero}" />
    <Setter Property="Padding" Value="28,26,28,24" />
  </Style>
  <Style Selector="TextBlock.heroHeadline">
    <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.4" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnHero}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.heroLabel">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnHeroSecondary}" />
  </Style>
  <Style Selector="TextBlock.heroFigure">
    <Setter Property="FontSize" Value="{StaticResource FontSizeLargeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnHero}" />
  </Style>
  <Style Selector="TextBlock.heroFigure.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerOnFrame}" />
  </Style>
  <!-- The supporting figures stand on a hairline of the frame's border, to the right of the headline -->
  <Style Selector="Border.heroFigures">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderFrame}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Padding" Value="28,0,0,0" />
  </Style>

  <Style Selector="Border.subtle">
    <Setter Property="Background" Value="{DynamicResource BgApp}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BorderDefault}" />
  </Style>
  <Style Selector="Border.rule">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <!-- A page's inspector: a flush pane at the right with a hairline on its left, no card (Review, ...) -->
  <Style Selector="Border.inspector">
    <Setter Property="Width" Value="{StaticResource InspectorWidth}" />
    <Setter Property="Background" Value="{DynamicResource BgInspector}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>
  <!-- An inspector that is a column of cards on the page (Structures): the result hero on top, white cards under it -->
  <Style Selector="Border.inspector.cards">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!-- A white card in a side column (the inspector's facts, the editor's costs and checks) -->
  <Style Selector="Border.sideCard">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderCard}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowCard}" />
    <Setter Property="Padding" Value="18,16,18,18" />
  </Style>
  <!-- A card's heading in a side column ("Structure", "Costs") -->
  <Style Selector="TextBlock.cardTitle">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSubheadline}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="Border.hairline">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BorderDefault}" />
  </Style>
  <!-- In an inspector: the big figure (the percent damaged) and label/value lists at footnote size -->
  <Style Selector="TextBlock.inspectorFigure">
    <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="LineHeight" Value="34" />
  </Style>
  <!-- The result in words beside or under the figure ("Substantially Damaged") -->
  <Style Selector="TextBlock.verdict">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- A labelled group in an inspector or the result panel ("Structure", "Costs"): small semibold label, a little open -->
  <Style Selector="TextBlock.groupLabel">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.3" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>
  <!-- A label and value list (facts, costs): label quiet on the left, value in ink -->
  <Style Selector="Grid.facts TextBlock.factLabel">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <!-- The structure's staff gauge in an inspector -->
  <Style Selector="c|StaffGauge.inspectorGauge">
    <Setter Property="ShowLabels" Value="True" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>
  <Style Selector="Grid.facts">
    <Setter Property="RowSpacing" Value="9" />
    <Setter Property="ColumnSpacing" Value="12" />
  </Style>
  <Style Selector="Grid.facts TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A page's toolbar items (PageChrome.Toolbar): a row of controls beside the window's title -->
  <Style Selector="StackPanel.pageToolbar">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="8" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A comment thread: plain text blocks; replies indented on a 2 px rule -->
  <Style Selector="Border.reply">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Padding" Value="10,0,0,0" />
  </Style>

  <!-- Summary tiles on the Structures page: a coloured border when their filter is on -->
  <Style Selector="Border.tile.active">
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Border.tile.substantial.active">
    <Setter Property="BorderBrush" Value="{DynamicResource StatusSubstantialFg}" />
  </Style>
  <Style Selector="Border.tile.close.active">
    <Setter Property="BorderBrush" Value="{DynamicResource StatusCloseFg}" />
  </Style>
  <Style Selector="Border.tile.below.active">
    <Setter Property="BorderBrush" Value="{DynamicResource StatusNotSubstantialFg}" />
  </Style>
  <Style Selector="Border.tile.incomplete.active">
    <Setter Property="BorderBrush" Value="{DynamicResource StatusIncompleteFg}" />
  </Style>

  <!-- Status pills (coloured with app:ThemeBrush from the result) -->
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Border.pill TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <!-- Form fields -->
  <Style Selector="StackPanel.field">
    <Setter Property="Width" Value="240" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Spacing" Value="4" />
    <Setter Property="Margin" Value="0,0,16,14" />
  </Style>
  <Style Selector="StackPanel.field.wide">
    <Setter Property="Width" Value="496" />
  </Style>
  <!-- Styles follow the logical tree, where an item's parent is its ItemsControl, not the panel: hence the class -->
  <Style Selector="ItemsControl.fields StackPanel.field, ItemsControl.fields StackPanel.field.wide">
    <Setter Property="Width" Value="NaN" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector=":is(Panel).fieldHead">
    <Setter Property="MinHeight" Value="18" />
  </Style>
  <Style Selector="TextBlock.fieldLabel">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="TextBox.multiline">
    <Setter Property="MinHeight" Value="64" />
  </Style>
  <Style Selector="TextBlock.help">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- A field's message under its input: a small icon and the words, in the colour of how much it matters -->
  <Style Selector="TextBlock.issue">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="DockPanel.issueLine">
    <Setter Property="Margin" Value="0,1,0,0" />
  </Style>
  <Style Selector="DockPanel.issueLine c|Icon">
    <Setter Property="Size" Value="13" />
    <Setter Property="Margin" Value="0,1,5,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Foreground" Value="{DynamicResource RequiredFg}" />
  </Style>
  <Style Selector="DockPanel.issueLine.required c|Icon">
    <Setter Property="Kind" Value="ErrorCircle" />
  </Style>
  <Style Selector="DockPanel.issueLine.recommended c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource RecommendedFg}" />
  </Style>
  <Style Selector="DockPanel.issueLine.suggested c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource SuggestedFg}" />
  </Style>
  <!-- A field with a required problem: its input's border turns red -->
  <Style Selector="StackPanel.field.required TextBox /template/ Border#PART_BorderElement, StackPanel.field.required ComboBox /template/ Border#Background, StackPanel.field.required CalendarDatePicker /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource RequiredFg}" />
  </Style>
  <Style Selector="TextBlock.issue.required">
    <Setter Property="Foreground" Value="{DynamicResource RequiredFg}" />
  </Style>
  <Style Selector="TextBlock.issue.recommended">
    <Setter Property="Foreground" Value="{DynamicResource RecommendedFg}" />
  </Style>
  <Style Selector="TextBlock.issue.suggested">
    <Setter Property="Foreground" Value="{DynamicResource SuggestedFg}" />
  </Style>
  <Style Selector="TextBlock.adorn">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
  </Style>
  <Style Selector="NumericUpDown.number /template/ TextBox">
    <Setter Property="TextAlignment" Value="Right" />
  </Style>

  <!-- Settings rows, in the style of System Settings: a card.flush holding a StackPanel.settingsGroup of rows -->
  <Style Selector="StackPanel.settingsGroup > Border.settingsRow">
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="StackPanel.settingsGroup > Border.settingsRow:nth-last-child(1)">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Lists -->
  <!-- A row of a plain list in a card.flush (Recently deleted, database backups): an icon, two lines, actions -->
  <Style Selector="Border.listRow">
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <!-- A list row's icon: plain, tinted (no tile) -->
  <Style Selector="Border.rowIcon">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.rowIcon c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.rows">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedRow}" />
  </Style>

  <!-- Accessibility: macOS exposes the text box inside a NumericUpDown / CalendarDatePicker, not the control itself,
       so it gets the control's name (AutomationProperties.Name is set on the control in the templates). -->
  <Style Selector="NumericUpDown /template/ TextBox">
    <Setter Property="AutomationProperties.Name" Value="{Binding $parent[NumericUpDown].(AutomationProperties.Name)}" />
  </Style>
  <Style Selector="CalendarDatePicker /template/ TextBox">
    <Setter Property="AutomationProperties.Name" Value="{Binding $parent[CalendarDatePicker].(AutomationProperties.Name)}" />
  </Style>
</Styles>
