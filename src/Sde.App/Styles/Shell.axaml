<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Sde.App.Controls"
        xmlns:app="using:Sde.App">
  <!--
    The window's frame: the sidebar (its sections, rows, foot and resizable edge), the title band and its search
    field, inspector edges, sheets (scrim and chrome, with small, medium and large widths), the command palette, and
    keyboard-key labels (Border.kbd). Every colour is a token, so the shell's look changes here and in Tokens.axaml.
  -->

  <!-- Icons in a colour role -->
  <Style Selector="c|Icon.accent">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="c|Icon.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="c|Icon.tertiary">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
  </Style>
  <Style Selector="c|Icon.success">
    <Setter Property="Foreground" Value="{DynamicResource SuccessFg}" />
  </Style>
  <Style Selector="c|Icon.warning">
    <Setter Property="Foreground" Value="{DynamicResource WarningFg}" />
  </Style>
  <Style Selector="c|Icon.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerFg}" />
  </Style>

  <!-- The source list: section labels in the brand's small semibold, a little open; plain grey counts -->
  <Style Selector="TextBlock.sourceHeader">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.3" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
    <Setter Property="Margin" Value="8,8,8,4" />
  </Style>
  <!-- The sidebar's header under the window's title strip: the mark, "SDE" and the open database -->
  <Style Selector="Grid.brandHeader">
    <Setter Property="Margin" Value="18,0,12,12" />
  </Style>
  <Style Selector="Grid.brandHeader c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,10,0" />
  </Style>
  <Style Selector="TextBlock.brandName">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSubheadline}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.brandDetail">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.sourceCount">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="6,0,0,0" />
  </Style>

  <!-- Show Sidebar, while it is hidden: after the window's close, minimise and zoom buttons -->
  <Style Selector="Button.showSidebar">
    <Setter Property="Margin" Value="{StaticResource TrafficLightInset}" />
  </Style>

  <!-- The toolbar: title and subtitle, 28 px borderless items, the view switch and the search field -->
  <Style Selector="TextBlock.toolbarTitle">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSubheadline}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.toolbarSubtitle">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="Button.icon.toolbar, DropDownButton.toolbar">
    <Setter Property="Height" Value="{DynamicResource ControlHeightLarge}" />
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightLarge}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
  </Style>
  <Style Selector="Button.icon.toolbar">
    <Setter Property="Width" Value="{DynamicResource ControlHeightLarge}" />
  </Style>
  <Style Selector="DropDownButton.toolbar">
    <Setter Property="Padding" Value="7,0,0,0" />
  </Style>
  <Style Selector="DropDownButton.toolbar /template/ PathIcon#DropDownGlyph">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Margin" Value="3,0,6,0" />
  </Style>
  <Style Selector="DropDownButton.toolbar /template/ Border#RootBorder">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="DropDownButton.toolbar:pointerover /template/ Border#RootBorder">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
  </Style>
  <!-- Two toolbar buttons that belong together (previous and next step) -->
  <!-- Paired toolbar buttons (Previous / Next step): one segmented control, as the Mac draws them -->
  <Style Selector="Border.toolbarGroup">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="Background" Value="{DynamicResource SegmentedTrack}" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <Style Selector="Border.toolbarGroup Button.icon.toolbar">
    <Setter Property="Width" Value="{DynamicResource ControlHeight}" />
    <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
  </Style>
  <Style Selector="ListBox.segmented.toolbar">
    <Setter Property="Padding" Value="2" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
  </Style>
  <Style Selector="ListBox.segmented.toolbar ListBoxItem">
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="Padding" Value="9,0" />
  </Style>
  <Style Selector="TextBox.toolbarSearch">
    <Setter Property="Width" Value="200" />
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightLarge}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="Padding" Value="5,0,8,0" />
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
  </Style>

  <!-- Sidebar: its width is the view model's (dragged by its edge). The host clips it while it slides in or out. -->
  <Style Selector="Panel.sidebarHost">
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.sidebar">
    <Setter Property="Background" Value="{DynamicResource SidebarBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <!-- The strip under the window's own title bar (the traffic lights), as tall as the title band, with Hide Sidebar -->
  <Style Selector="Panel.sidebarTitleBar">
    <Setter Property="Height" Value="{StaticResource TitleBandHeight}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.sidebarToggle">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,12,0" />
  </Style>
  <!-- The rows: 12 px from the sidebar's edges, sections 12 px apart -->
  <Style Selector=":is(Control).sidebarList">
    <Setter Property="Margin" Value="12,0" />
  </Style>
  <Style Selector="StackPanel.sourceSection">
    <Setter Property="Spacing" Value="1" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>
  <Style Selector="Button.nav c|Icon.navIcon">
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <!-- A pinned structure's result dot, in the icon's place -->
  <Style Selector="Panel.navDot">
    <Setter Property="Width" Value="16" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <Style Selector="Panel.navDot Ellipse.dot">
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <!-- Settings at the foot, on a hairline -->
  <Style Selector="Border.sidebarFoot">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="12,8,12,12" />
  </Style>

  <!-- The edge that drags a sidebar or an inspector: invisible, ResizeHandleWidth wide, with the resize cursor -->
  <Style Selector="c|ResizeHandle">
    <Setter Property="Width" Value="{StaticResource ResizeHandleWidth}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="SizeWestEast" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ZIndex" Value="1" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- On the sidebar's trailing edge, straddling its hairline -->
  <Style Selector="c|ResizeHandle.sidebarEdge">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,0,-3,0" />
  </Style>
  <!-- On an inspector's leading edge, straddling its hairline -->
  <Style Selector="c|ResizeHandle.inspectorEdge">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="-2,0,0,0" />
  </Style>

  <!-- The title band across the top of the content -->
  <Style Selector="Border.titleBand">
    <Setter Property="Height" Value="{StaticResource TitleBandHeight}" />
    <Setter Property="Background" Value="{DynamicResource WindowBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,0,14,0" />
  </Style>
  <!-- A key on the keyboard: ⌘K, esc -->
  <Style Selector="Border.kbd">
    <Setter Property="Background" Value="{DynamicResource BgSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="Padding" Value="5,0,5,1" />
    <Setter Property="MinWidth" Value="20" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.kbd TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- Shortcuts in the window's menus as a Mac shows them (⇧⌘N, not Shift+Cmd+N). Two selectors with a pseudo-class so
       this outranks the theme's own binding of the same text. -->
  <Style Selector="MenuItem:not(:disabled) /template/ TextBlock#PART_InputGestureText, MenuItem:disabled /template/ TextBlock#PART_InputGestureText">
    <Setter Property="Text" Value="{Binding $parent[MenuItem].InputGesture, Converter={x:Static app:Converters.MacKeyGesture}}" />
  </Style>

  <!-- Sheets, as on the Mac: the sheet hangs from the toolbar's lower edge; the window behind is not dimmed but can't be clicked -->
  <Style Selector="Border.scrim">
    <Setter Property="Background" Value="{DynamicResource BgOverlay}" />
  </Style>
  <Style Selector="Border.sheet">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="1,0,1,1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSheetAttached}" />
    <Setter Property="Padding" Value="{StaticResource SheetPadding}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowSheet}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="{StaticResource SheetMargin}" />
    <Setter Property="MinWidth" Value="{StaticResource SheetWidthSmall}" />
    <Setter Property="MaxWidth" Value="760" />
  </Style>
  <Style Selector="Border.sheet.sheetSmall">
    <Setter Property="Width" Value="{StaticResource SheetWidthSmall}" />
  </Style>
  <Style Selector="Border.sheet.sheetMedium">
    <Setter Property="Width" Value="{StaticResource SheetWidthMedium}" />
  </Style>
  <Style Selector="Border.sheet.sheetLarge">
    <Setter Property="Width" Value="{StaticResource SheetWidthLarge}" />
    <Setter Property="MaxWidth" Value="{StaticResource SheetWidthLarge}" />
  </Style>

  <!-- The command palette -->
  <Style Selector="Border.palette">
    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSheet}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowSheet}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.paletteFooter">
    <Setter Property="Background" Value="{DynamicResource BgSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="16,8" />
  </Style>
  <Style Selector="ListBox.palette">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6,4,6,6" />
  </Style>
  <Style Selector="ListBox.palette ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.palette ListBoxItem /template/ ContentPresenter#PART_ContentPresenter, ListBox.palette ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.palette ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.palette ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.palette ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter, ListBox.palette ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.paletteRow">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.paletteRow c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="ListBox.palette ListBoxItem:pointerover Border.paletteRow">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
  </Style>
  <Style Selector="ListBox.palette ListBoxItem:selected Border.paletteRow">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>
  <Style Selector="ListBox.palette ListBoxItem:selected Border.paletteRow c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <!-- A text box with no box (the palette's search) -->
  <Style Selector="TextBox.bare">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeSubheadline}" />
    <Setter Property="Padding" Value="10,0" />
  </Style>
  <Style Selector="TextBox.bare /template/ Border#PART_BorderElement, TextBox.bare:pointerover /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>
</Styles>
