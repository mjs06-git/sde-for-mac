<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders the icon SVGs to PNG (tools/icon/render.sh). A build tool only: it is not in Sde.sln and nothing from it
       ships in SDE.app, so the Svg packages the app leaves out are fine here. Versions come from Directory.Packages.props. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Svg.Skia" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>
</Project>
